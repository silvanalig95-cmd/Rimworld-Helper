<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Six more feelings (fields as in Council_Feelings.xml): nostalgia, relief, tenderness, worry, fellowship and
    resolve. Like the others they add no mood of their own; they nudge wishes, moments, dreams and strain. Names and
    effects are in Keyed/Rimfolk_Breadth.xml (CC_Heart_F_{key}...), and each has a dream of its own
    (Defs/DreamDefs/Council_Dreams_Feelings2.xml).
  -->

  <ColonyCouncil.FeelingDef>
    <defName>Council_Feeling_Nostalgia</defName>
    <key>Nostalgia</key>
    <bright>true</bright>
    <order>21</order>
    <color>(0.85, 0.72, 0.6)</color>
    <threshold>5</threshold>
    <workerClass>ColonyCouncil.FeelingWorker_Nostalgia</workerClass>
    <thoughts>
      <li>Council_Anniversary</li>
      <li>Council_FriendAnniversary</li>
      <li>Council_Cal_Remembered</li>
      <li>Council_Cal_Birthday</li>
      <li>Council_Heirloom</li>
      <li>Council_DlmS_HeirloomKept</li>
      <li>Council_Moment_HeardOldStories</li>
      <li>Council_Moment_ToldMyStory</li>
      <li>Council_Moment_EveningTales</li>
      <li>Council_Moment_TheyRemembered</li>
      <li>Council_Story_LettersHome</li>
      <li>Council_Scen_OldFriend</li>
      <li>Council_Dlm_Stories</li>
      <li>Council_Dlm_YearOfTheDead</li>
      <li>Council_Dlm_Trad_Walk</li>
      <li>Council_EncC_OldFriendSlowing</li>
    </thoughts>
    <feeds>
      <li><thought>Council_TraditionKept</thought><weight>0.6</weight></li>
      <li><thought>Council_Dream_Lost</thought><sign>0</sign><weight>0.4</weight></li>
    </feeds>
    <relief>1.05</relief>
    <wishes>
      <li>Council_Wish_Memorial</li>
      <li>Council_Wish_Hearth</li>
      <li>Council_Wish_Tea</li>
      <li>Council_Wish_Birthday</li>
    </wishes>
    <wishFactor>1.3</wishFactor>
    <warm>1.1</warm>
    <dreams>
      <li><kind>Lost</kind><factor>1.3</factor></li>
      <li><kind>Sweet</kind><factor>1.2</factor></li>
    </dreams>
  </ColonyCouncil.FeelingDef>

