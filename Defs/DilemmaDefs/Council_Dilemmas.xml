<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Council dilemmas: a situation, and three or four answers that each cost someone something.
    {A_...} and {B_...} are the people involved, {THING}/{COUNT} the thing, {FACTION} a faction.
    The option at defaultOption happens if the council doesn't answer in time.
  -->

  <!-- ===================== A thief in the stores ===================== -->
  <ColonyCouncil.DilemmaDef>
    <defName>Council_Dilemma_Thief</defName>
    <ignoreIllegalLabelCharacterConfigError>true</ignoreIllegalLabelCharacterConfigError>
    <label>a thief in the stores</label>
    <weight>1</weight>
    <roleA>
      <notTrait><li>Kind</li></notTrait>
    </roleA>
    <roleB>
      <minOpinionOfA>-100</minOpinionOfA>
    </roleB>
    <texts>
      <li>Still chewing, pockets stuffed full. That was how {B_nameDef} found {A_nameDef} in the storeroom in the middle of the night.\n\n"I was hungry," {A_nameDef} said.\n\n"Third time this week," said {B_nameDef}, who wants the council to deal with it.</li>
      <li>Food has been going missing from the stores for days. Last night {B_nameDef} waited in the dark between the shelves and caught {A_nameDef} filling a sack.\n\n{A_nameDef} hasn't tried to deny it.</li>
      <li>A pile of picked bones and three empty sacks, under {A_nameDef}'s bed. {B_nameDef} found them this morning, after a week of the stores running short.\n\n{A_nameDef} says {A_pronoun} only took what {A_pronoun} needed. {B_nameDef} points out that the rest of the colony has been going to bed hungry.</li>
    </texts>
    <defaultOption>0</defaultOption>
    <options>
      <li>
        <label>Let {A_nameDef} off with a warning</label>
        <outcome>A warning, and nothing more. {B_nameDef} thinks the council has gone soft, and says so to anyone who stands still long enough.</outcome>
        <ways><mercy>6</mercy></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Forgiven</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>6</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>B</target><thought>Council_Dlm_Unfair</thought><exceptTrait><li>Kind</li></exceptTrait></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Dlm_Unfair</thought><onlyTrait><li>Greedy</li><li>Jealous</li><li>Abrasive</li></onlyTrait></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>B</target><amount>-4</amount></li>
        </effects>
      </li>
      <li>
        <label>Make {A_nameDef} work it off</label>
        <outcome>{A_nameDef} is pulling extra shifts until the stores are paid back, sack for sack. Most people think that's fair.</outcome>
        <ways><toil>3</toil></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Hediff"><target>A</target><hediff>Council_Dlm_Penance</hediff></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>-3</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Dlm_FairsFair</thought><exceptTrait><li>Kind</li></exceptTrait></li>
        </effects>
      </li>
      <li>
        <label>Punish {A_nameDef} publicly</label>
        <outcome>{A_nameDef} stood at the end of the table through all of supper while the council said its piece. The kinder colonists kept their eyes on their plates.</outcome>
        <ways><mercy>-8</mercy></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Humiliated</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>-12</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Dlm_Harsh</thought><onlyTrait><li>Kind</li></onlyTrait></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Dlm_FairsFair</thought><exceptTrait><li>Kind</li></exceptTrait></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Grudge</thought><about>B</about></li>
          <li Class="ColonyCouncil.DilemmaEffect_Words"><label>{A_nameDef}'s punishment at supper</label><organizer>None</organizer><spots><li>Dining</li><li>Gather</li></spots><hours>17~21</hours><duration>0.75~1</duration><pool>Council_Pool_PlayReckoning</pool></li>
        </effects>
        <riskChance>0.25</riskChance>
        <!-- When it goes wrong, the fight comes at once: nothing is held for a supper that's already broken up. -->
        <riskReplaces>true</riskReplaces>
        <riskOutcome>The council made an example of {A_nameDef}, who took it badly and went straight for {B_nameDef}.</riskOutcome>
        <riskEffects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Humiliated</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>-12</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Dlm_Harsh</thought><onlyTrait><li>Kind</li></onlyTrait></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Dlm_FairsFair</thought><exceptTrait><li>Kind</li></exceptTrait></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Grudge</thought><about>B</about></li>
          <li Class="ColonyCouncil.DilemmaEffect_Fight" />
        </riskEffects>
      </li>
    </options>
  </ColonyCouncil.DilemmaDef>

  <!-- ===================== A forgotten stash ===================== -->
  <ColonyCouncil.DilemmaDef>
    <defName>Council_Dilemma_Stash</defName>
    <label>a forgotten stash</label>
    <weight>0.8</weight>
    <things><li>Beer</li><li>SmokeleafJoint</li><li>Ambrosia</li></things>
    <thingCount>12</thingCount>
    <texts>
      <li>{A_nameDef} pried up a loose board in the old shed and found {COUNT} {THING} wrapped in oilcloth. Whoever hid it hasn't been back for it in years.\n\nThe arguing started before {A_nameDef} had the board back down.</li>
      <li>{A_nameDef} was digging a trench when {A_possessive} shovel struck a buried crate. Inside were {COUNT} {THING}, still good, probably left by smugglers long before the colony came.\n\nWord got around fast.</li>
    </texts>
    <defaultOption>0</defaultOption>
    <options>
      <li>
        <label>Share it out tonight</label>
        <outcome>The stash was shared out. Some people had a very good evening; the teetotalers went to bed early.</outcome>
        <ways><generosity>4</generosity><toil>-3</toil></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Spawn" />
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Colony</target><thought>Council_Dlm_Stash</thought><degreeTrait>DrugDesire</degreeTrait><minDegree>1</minDegree></li>
          <li Class="ColonyCouncil.DilemmaEffect_Gathering"><label>the night the stash was shared</label><hours>17~23</hours><spots><li>Rec</li><li>Dining</li><li>Fire</li><li>Outdoors</li></spots></li>
        </effects>
      </li>
      <li>
        <label>Lock it away for trading</label>
        <outcome>The stash went into storage, forbidden, to be sold to the next trader. The ones who had hoped for a share keep finding reasons to be in the storeroom.</outcome>
        <ways><generosity>-4</generosity></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Spawn"><forbidden>true</forbidden></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Colony</target><thought>Council_Dlm_LockedAway</thought><degreeTrait>DrugDesire</degreeTrait><minDegree>1</minDegree></li>
        </effects>
      </li>
      <li>
        <label>Destroy it</label>
        <outcome>The stash was destroyed before anyone could change the council's mind. The teetotalers approved. The colony's regular users are still talking about it.</outcome>
        <ways><toil>3</toil></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Colony</target><thought>Council_Dlm_Wasted</thought><degreeTrait>DrugDesire</degreeTrait><minDegree>1</minDegree></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Colony</target><thought>Council_Dlm_Clean</thought><degreeTrait>DrugDesire</degreeTrait><maxDegree>-1</maxDegree></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Colony</target><thought>Council_Dlm_Clean</thought><onlyTrait><li>Ascetic</li></onlyTrait></li>
          <li Class="ColonyCouncil.DilemmaEffect_BurnIt"><label>the stash burned in the yard</label></li>
        </effects>
      </li>
    </options>
  </ColonyCouncil.DilemmaDef>

  <!-- ===================== A feud ===================== -->
  <ColonyCouncil.DilemmaDef>
    <defName>Council_Dilemma_Feud</defName>
    <ignoreIllegalLabelCharacterConfigError>true</ignoreIllegalLabelCharacterConfigError>
    <label>a feud</label>
    <weight>1.2</weight>
    <cooldownDays>25</cooldownDays>
    <roleB>
      <maxOpinionOfA>-20</maxOpinionOfA>
    </roleB>
    <texts>
      <li>{A_nameDef} and {B_nameDef} have been at each other's throats for days. Today it was about whose turn it was to clean. Yesterday it was a borrowed knife that came back dull.\n\nBoth of them want the council to settle it, and both expect to win.</li>
      <li>{A_nameDef} and {B_nameDef} had another shouting match, this time across the dinner table, and a spoon was thrown.\n\nEach has brought the council a list of complaints. {B_nameDef}'s begins with the spoon. {A_nameDef}'s begins with what {B_nameDef} said before the spoon.</li>
      <li>This morning {B_nameDef} moved {A_nameDef}'s things out of the workshop. By lunch {A_nameDef} had salted {B_nameDef}'s stew until it couldn't be eaten. It has gone on like this for days.\n\nThe others are tired of it, and {A_nameDef} and {B_nameDef} each want the council to take their side.</li>
    </texts>
    <defaultOption>3</defaultOption>
    <options>
      <li>
        <label>Side with {A_nameDef}</label>
        <outcome>The council sided with {A_nameDef}. {B_nameDef} walked out of the meeting and slammed the door.</outcome>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Vindicated</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>8</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>B</target><thought>Council_Dlm_Overruled</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>B</target><amount>-10</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>B</target><thought>Council_Dlm_Grudge</thought><about>A</about></li>
        </effects>
        <riskChance>0.3</riskChance>
        <riskOutcome>{B_nameDef} heard the council side with {A_nameDef}, and went for {A_objective} on the way out.</riskOutcome>
        <riskEffects>
          <li Class="ColonyCouncil.DilemmaEffect_Fight" />
        </riskEffects>
      </li>
      <li>
        <label>Side with {B_nameDef}</label>
        <outcome>The council sided with {B_nameDef}. {A_nameDef} took it badly, and hasn't stayed in a room with {B_nameDef} since.</outcome>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>B</target><thought>Council_Dlm_Vindicated</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>B</target><amount>8</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Overruled</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>-10</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Grudge</thought><about>B</about></li>
        </effects>
        <riskChance>0.3</riskChance>
        <riskOutcome>The council sided with {B_nameDef}, and {A_nameDef} answered with fists.</riskOutcome>
        <riskEffects>
          <li Class="ColonyCouncil.DilemmaEffect_Fight" />
        </riskEffects>
      </li>
      <li>
        <label>Make them work side by side</label>
        <outcome>{A_nameDef} and {B_nameDef} got through their first shift side by side with nothing worse than a few looks. There are more shifts to come.</outcome>
        <ways><toil>4</toil></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>AAndB</target><thought>Council_Dlm_ForcedTogether</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>AAndB</target><thought>Council_Dlm_MadeUp</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_WorkParty"><label>the shared shift</label><target>AAndB</target><tasks><li>Haul</li><li>Clean</li><li>Repair</li></tasks><hours>7~17</hours><duration>2~3</duration></li>
        </effects>
        <riskChance>0.4</riskChance>
        <riskReplaces>true</riskReplaces>
        <riskOutcome>{A_nameDef} and {B_nameDef} came to blows before the shared shift had properly started.</riskOutcome>
        <riskEffects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>AAndB</target><thought>Council_Dlm_ForcedTogether</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Fight" />
        </riskEffects>
      </li>
      <li>
        <label>Stay out of it</label>
        <outcome>Nothing from the council. {A_nameDef} and {B_nameDef} are left to stew in it.</outcome>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>AAndB</target><thought>Council_Dlm_Ignored</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>AAndB</target><amount>-3</amount></li>
        </effects>
        <riskChance>0.5</riskChance>
        <riskOutcome>Left to themselves, {A_nameDef} and {B_nameDef} settled it with their fists.</riskOutcome>
        <riskEffects>
          <li Class="ColonyCouncil.DilemmaEffect_Fight" />
        </riskEffects>
      </li>
    </options>
  </ColonyCouncil.DilemmaDef>

  <!-- ===================== The cook's feast ===================== -->
  <ColonyCouncil.DilemmaDef>
    <defName>Council_Dilemma_Feast</defName>
    <ignoreIllegalLabelCharacterConfigError>true</ignoreIllegalLabelCharacterConfigError>
    <label>the cook's feast</label>
    <workerClass>ColonyCouncil.DilemmaWorker_Feast</workerClass>
    <weight>0.9</weight>
    <roleA>
      <passion>Cooking</passion>
      <bestAt>Cooking</bestAt>
    </roleA>
    <thingCount>30</thingCount>
    <texts>
      <li>{A_nameDef} wants to cook a feast tonight with the best of everything in the stores. "We could all be dead next week," {A_pronoun} says.\n\nIt would use about {COUNT} raw food.</li>
      <li>{A_nameDef} has been planning a seven-course menu for weeks, in the margins of the kitchen tally, and has finally brought it to the council. It would take about {COUNT} raw food from the stores. {A_nameDef} can recite every course, and did.</li>
    </texts>
    <defaultOption>1</defaultOption>
    <options>
      <li>
        <label>Let {A_nameDef} cook the feast</label>
        <outcome>The feast went on late into the night. The last plates came back scraped clean, and people are already asking when the next one is.</outcome>
        <ways><generosity>6</generosity><toil>-3</toil></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Consume"><what>rawfood</what></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Colony</target><thought>Council_Dlm_Feast</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Standards"><target>Colony</target><amount>0.05</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>6</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Inspiration"><target>A</target><chance>0.3</chance></li>
          <li Class="ColonyCouncil.DilemmaEffect_Feast"><label>{A_nameDef}'s feast</label><hours>16~22</hours></li>
        </effects>
      </li>
      <li>
        <label>Save the food</label>
        <outcome>{A_nameDef} has gone back to plain meals, and sets each bowl down harder than it needs to.</outcome>
        <ways><generosity>-5</generosity></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_FeastDenied</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>-4</amount></li>
        </effects>
      </li>
      <li>
        <label>A smaller feast</label>
        <outcome>A good supper from a modest share of the stores, smaller than {A_nameDef} had in mind. {A_nameDef} apologized for it all evening while the colony asked for seconds.</outcome>
        <ways><generosity>2</generosity></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Consume"><what>rawfood</what><count>12</count></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Colony</target><thought>Council_Dlm_SmallFeast</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>2</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Feast"><label>{A_nameDef}'s supper</label><hours>16~22</hours><duration>1.5~2</duration></li>
        </effects>
      </li>
    </options>
  </ColonyCouncil.DilemmaDef>

  <!-- ===================== A confession ===================== -->
  <ColonyCouncil.DilemmaDef>
    <defName>Council_Dilemma_Confession</defName>
    <ignoreIllegalLabelCharacterConfigError>true</ignoreIllegalLabelCharacterConfigError>
    <label>a confession</label>
    <weight>0.9</weight>
    <roleB>
      <minOpinionOfA>10</minOpinionOfA>
    </roleB>
    <texts>
      <li>{A_nameDef} came to the council after dark, ashamed. The nightmares haven't stopped for weeks, and {A_pronoun} has been skipping shifts to lie in bed with the door shut.\n\n{B_nameDef} has offered to help, if the council wants.</li>
      <li>{A_nameDef} sat down in the middle of hauling stone this afternoon and wouldn't get up. Later {A_pronoun} told the council, "I can't keep doing this. I'm so tired."\n\n{B_nameDef} has been keeping an eye on {A_objective}.</li>
    </texts>
    <defaultOption>1</defaultOption>
    <options>
      <li>
        <label>Give {A_nameDef} a few easy days</label>
        <outcome>{A_nameDef} is taking a few easy days. Some of the harder workers are muttering about it.</outcome>
        <ways><mercy>5</mercy><toil>-5</toil></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Hediff"><target>A</target><hediff>Council_Dlm_Rest</hediff></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Understood</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>8</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Strain"><target>A</target><amount>-20</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Dlm_Shirking</thought><degreeTrait>Industriousness</degreeTrait><minDegree>1</minDegree></li>
        </effects>
      </li>
      <li>
        <label>Tell {A_nameDef} to get back to work</label>
        <outcome>{A_nameDef} went back to work without a word.</outcome>
        <ways><mercy>-4</mercy><toil>6</toil></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Dismissed</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>-8</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Strain"><target>A</target><amount>8</amount></li>
        </effects>
        <riskChance>0.25</riskChance>
        <riskOutcome>{A_nameDef} went back to work, but before the shift was over dropped {A_possessive} tools and wandered off, staring at nothing.</riskOutcome>
        <riskEffects>
          <li Class="ColonyCouncil.DilemmaEffect_MentalState"><target>A</target><mentalState>Wander_Sad</mentalState></li>
        </riskEffects>
      </li>
      <li>
        <label>Ask {B_nameDef} to look after {A_objective}</label>
        <outcome>{B_nameDef} sat up with {A_nameDef} through the evening, and will again tomorrow. {A_nameDef} talked more than {A_pronoun} has in weeks.</outcome>
        <ways><mercy>4</mercy></ways>
        <effects>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Understood</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Dlm_Bonded</thought><about>B</about></li>
          <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>B</target><thought>Council_Dlm_Helped</thought></li>
          <li Class="ColonyCouncil.DilemmaEffect_Trust"><target>A</target><amount>5</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Strain"><target>A</target><amount>-12</amount></li>
          <li Class="ColonyCouncil.DilemmaEffect_Visit"><who>B</who><whom>A</whom><hours>16~22</hours></li>
        </effects>
      </li>
    </options>
  </ColonyCouncil.DilemmaDef>

</Defs>
