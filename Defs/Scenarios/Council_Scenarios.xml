<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Rimfolk's scenarios: games that start with stakes already in play. Each uses Rimfolk's scenario parts
       (Defs/Misc/Council_ScenParts.xml): a sworn enemy, a debt, deserters, two feuding families, a reputation, a
       secret. A few seconds in, a letter says how things stand. Fights they promise come as long as the storyteller
       sends threats at all, even with Rimfolk's world-event battles switched off: they're what the scenario is for. -->

  <!-- ===================== Hot Money ===================== -->

  <ScenarioDef ParentName="ScenarioBase">
    <defName>Council_Scenario_HotMoney</defName>
    <label>Hot Money</label>
    <description>The job went perfectly. Four of you walked out of a pirate boss's vault with 2,500 silver and a stolen shuttle, and nobody fired a shot. Then the shuttle ran dry over the rim, and the perfect getaway became a long walk.\n\nThe boss you robbed knows your names, and in about two weeks will ask for the money back. Pay it, and that's the end of it. Pay half and talk your way into more time. Or keep it, and be ready to fight for it: the boss's people will come a few times before they give up.\n\nOne more thing: one of you knows more about the take than they're telling.</description>
    <scenario>
      <summary>Four thieves, a fortune in stolen silver, and the boss they robbed on their trail. Pay it back and you're safe. (Rimfolk · moderate)</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>4</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <li Class="ColonyCouncil.ScenPart_CouncilFoe">
          <def>Council_ScenFoe</def>
          <deed>robbed</deed>
          <outlaws>true</outlaws>
          <firstDays>0~0</firstDays>
          <everyDays>0~0</everyDays>
          <story>heist</story>
        </li>
        <li Class="ColonyCouncil.ScenPart_CouncilDebt">
          <def>Council_ScenDebt</def>
          <amount>2500</amount>
          <dueDays>12~15</dueDays>
          <story>heist</story>
        </li>
        <li Class="ColonyCouncil.ScenPart_CouncilSecret">
          <def>Council_ScenSecret</def>
          <secret>Council_Secret_Skimmed</secret>
          <count>1</count>
        </li>
        <li Class="ColonyCouncil.ScenPart_CouncilWays">
          <def>Council_ScenWays</def>
          <openness>-25</openness>
          <generosity>-10</generosity>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>2500</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gold</thingDef>
          <count>25</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>20</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>12</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>15</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_Revolver</thingDef>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_MachinePistol</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_PumpShotgun</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Apparel_FlakVest</thingDef>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>300</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
        </li>
        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsAnywhere</def>
          <thingDef>ShipChunk</thingDef>
          <allowRoofed>false</allowRoofed>
          <count>1</count>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The shuttle came down hard, but it came down. Four of you climb out into the light of an unknown world with 2,500 silver in your packs that isn't yours.\n\nSomewhere out there, the one you took it from is already asking questions.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

  <!-- ===================== Marooned ===================== -->

  <ScenarioDef ParentName="ScenarioBase">
    <defName>Council_Scenario_Marooned</defName>
    <label>Marooned</label>
    <description>Three days out from port, the crew mutinied. The captain and the few who stayed loyal were bundled into drop pods with a crate of gear and fired at the nearest rimworld, with the mutineers' laughter over the comms.\n\nThe ringleader has friends among the pirates down there, and doesn't like loose ends. In about three weeks they'll come for you, and twice more after that, a month or so apart, unless the ringleader falls first.\n\nAnd not everyone in those pods was as loyal as they claimed.</description>
    <scenario>
      <summary>A loyal few, marooned by mutineers who'll come for them three times, with a traitor among them. (Rimfolk · moderate)</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>4</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
        </li>

        <li Class="ColonyCouncil.ScenPart_CouncilFoe">
          <def>Council_ScenFoe</def>
          <deed>betrayed</deed>
          <outlaws>true</outlaws>
          <firstDays>18~24</firstDays>
          <everyDays>30~40</everyDays>
          <times>3</times>
          <story>mutiny</story>
        </li>
        <li Class="ColonyCouncil.ScenPart_CouncilSecret">
          <def>Council_ScenSecret</def>
          <secret>Council_Secret_Mutineer</secret>
          <count>1</count>
        </li>
        <li Class="ColonyCouncil.ScenPart_CouncilWays">
          <def>Council_ScenWays</def>
          <tradition>20</tradition>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
