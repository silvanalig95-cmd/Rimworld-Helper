<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Temporary conditions from the dilemmas of everyday life (Defs/DilemmaDefs/Council_Dilemmas_Life.xml). -->

  <HediffDef>
    <defName>Council_DlmL_Nursing</defName>
    <label>nursing the sick</label>
    <description>Sitting up nights with someone who is ill. Tires sooner and works a little slower by day.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets><WorkSpeedGlobal>-0.05</WorkSpeedGlobal></statOffsets>
        <restFallFactor>1.1</restFallFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_DlmL_LightDuty</defName>
    <label>on light duties</label>
    <description>The council has put them on lighter work for a while: sitting jobs, short hours, nothing heavy.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000~240000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <WorkSpeedGlobal>-0.12</WorkSpeedGlobal>
          <MentalBreakThreshold>-0.03</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_DlmL_Retired</defName>
    <label>taking it easy in old age</label>
    <description>The council has let them put down the heavy work. They still do what they feel like doing, at their own pace.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900000~1200000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <WorkSpeedGlobal>-0.3</WorkSpeedGlobal>
          <MentalBreakThreshold>-0.05</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_DlmL_HalfDay</defName>
    <label>half days in turn</label>
    <description>Everyone is taking half days off in turn until the worst is over.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~90000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets><WorkSpeedGlobal>-0.1</WorkSpeedGlobal></statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
