<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Temporary conditions from the second set of council dilemmas. -->

  <HediffDef>
    <defName>Council_Dlm_Sleepless</defName>
    <label>short on sleep</label>
    <description>Hasn't had a proper night's sleep in days. Tires quickly and works slower.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.45)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets><WorkSpeedGlobal>-0.05</WorkSpeedGlobal></statOffsets>
        <restFallFactor>1.25</restFallFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Dlm_NightWatch</defName>
    <label>on night watch</label>
    <description>Pulling extra night watches on the council's orders. Short on sleep, sharp of eye.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000~240000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets><WorkSpeedGlobal>-0.04</WorkSpeedGlobal></statOffsets>
        <restFallFactor>1.15</restFallFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Dlm_Rattled</defName>
    <label>rattled</label>
    <description>Something has them spooked. Jumps at noises and cracks more easily, for a while.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.45)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets><MentalBreakThreshold>0.04</MentalBreakThreshold></statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Dlm_Calm</defName>
    <label>after the rite</label>
    <description>Spent a day at a bonfire burning their fears. A little behind on work, a little steadier in the head.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>100000~150000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <WorkSpeedGlobal>-0.05</WorkSpeedGlobal>
          <MentalBreakThreshold>-0.04</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
