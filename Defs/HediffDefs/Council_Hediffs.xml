<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>Council_Motivated</defName>
    <label>motivated</label>
    <description>Got what they asked for and wants to prove it was worth it. Works a little faster for a few days.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.9, 0.55)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>keen</label>
        <statOffsets>
          <WorkSpeedGlobal>0.04</WorkSpeedGlobal>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>fired up</label>
        <statOffsets>
          <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
          <GlobalLearningFactor>0.1</GlobalLearningFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Disgruntled</defName>
    <label>disgruntled</label>
    <description>Ignored once too often. Drags their feet and snaps more easily, for a while.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.45)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.3</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000~150000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>grumbling</label>
        <statOffsets>
          <WorkSpeedGlobal>-0.04</WorkSpeedGlobal>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>resentful</label>
        <statOffsets>
          <WorkSpeedGlobal>-0.08</WorkSpeedGlobal>
          <MentalBreakThreshold>0.04</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Lasting effects of trust in the council. Added and removed by the mod as trust changes. -->
  <HediffDef>
    <defName>Council_Loyalty</defName>
    <label>loyal to the council</label>
    <description>This colonist trusts the council to listen. They work with a will, pick things up quicker and hold together better when things go wrong. It lasts as long as the trust does.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.9, 0.55)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <label>trusting</label>
        <statOffsets>
          <WorkSpeedGlobal>0.03</WorkSpeedGlobal>
          <GlobalLearningFactor>0.05</GlobalLearningFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>devoted</label>
        <statOffsets>
          <WorkSpeedGlobal>0.07</WorkSpeedGlobal>
          <GlobalLearningFactor>0.12</GlobalLearningFactor>
          <MentalBreakThreshold>-0.03</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Grudge</defName>
    <label>grudge against the council</label>
    <description>This colonist feels ignored by the council. They do the bare minimum and their temper is short. Granting their wishes and keeping promises wins them back.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.45)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <label>doubtful</label>
        <statOffsets>
          <WorkSpeedGlobal>-0.03</WorkSpeedGlobal>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>bitter</label>
        <statOffsets>
          <WorkSpeedGlobal>-0.08</WorkSpeedGlobal>
          <MentalBreakThreshold>0.05</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Decree effects, applied to every colonist while a decree holds. -->
  <HediffDef>
    <defName>Council_Decree_LongHours</defName>
    <label>long hours (decree)</label>
    <description>Working longer and harder by order of the council.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li><statOffsets><WorkSpeedGlobal>0.15</WorkSpeedGlobal></statOffsets><restFallFactor>1.15</restFallFactor></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Decree_Rationing</defName>
    <label>rationing (decree)</label>
    <description>Eating smaller portions by order of the council.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li><hungerRateFactor>0.75</hungerRateFactor></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Decree_Drills</defName>
    <label>drills (decree)</label>
    <description>Spending hours a day on weapons drills by order of the council.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li><statOffsets><WorkSpeedGlobal>-0.08</WorkSpeedGlobal></statOffsets></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Decree_Study</defName>
    <label>study hours (decree)</label>
    <description>Spending evenings at lessons by order of the council.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li><statOffsets><WorkSpeedGlobal>-0.05</WorkSpeedGlobal><GlobalLearningFactor>0.3</GlobalLearningFactor></statOffsets><statFactors><ResearchSpeed>1.2</ResearchSpeed></statFactors></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Decree_Festival</defName>
    <label>festival days (decree)</label>
    <description>Taking it easy: the council has declared festival days.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li><statOffsets><WorkSpeedGlobal>-0.2</WorkSpeedGlobal></statOffsets></li>
    </stages>
  </HediffDef>

  <!-- From council dilemmas -->
  <HediffDef>
    <defName>Council_Dlm_Penance</defName>
    <label>working it off</label>
    <description>Ordered by the council to work off a misdeed. Extra shifts until the debt is paid.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>150000~200000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets><WorkSpeedGlobal>0.1</WorkSpeedGlobal></statOffsets>
        <restFallFactor>1.2</restFallFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_Dlm_Rest</defName>
    <label>taking it easy</label>
    <description>The council gave them a few easy days to get back on their feet.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>150000~200000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <WorkSpeedGlobal>-0.25</WorkSpeedGlobal>
          <MentalBreakThreshold>-0.05</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
