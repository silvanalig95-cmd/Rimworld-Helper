<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The seasonal customs (Defs/DilemmaDefs/Council_Dilemmas_Customs.xml). Kept small: good moods share one budget. -->

  <ThoughtDef>
    <defName>Council_Dlm_Trad_Blessing</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the planting day</label><description>The first seed of the year went in with care, the way it should. Whatever comes up, we started it right.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <!-- The planting day gives hope, practice and a journal line rather than mood. -->
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>3</felt><skill>Plants</skill><xp>200</xp><journal>true</journal><feelings><li>Hope</li></feelings></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Dlm_Trad_Walk</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>remembered our dead</label><description>We walked out to the graves at dusk and tidied them, and I heard stories about them I'd never been told.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Dlm_Trad_Swim</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the midsummer swim</label><description>A whole afternoon in the water on the hottest day of the year. My shoulders are still pink from it.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Dlm_Trad_Dance</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the harvest dance</label><description>We danced until the fire burned down. My feet hurt and I don't care.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Dlm_Trad_FrostSoup</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>first-frost soup</label><description>Hot soup from the big pot on the first cold day. I ate mine standing up, with my breath steaming over the bowl.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Dlm_Trad_Lanterns</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>lantern night</label><description>Lantern light at dusk in the dead of winter. From outside, we looked like somewhere worth coming home to.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
