<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Family beyond the game's own (Source/ColonyCouncil/Social/Family.cs): a reunion when a relative joins the colony,
    family seen among the raiders, a death in the family by marriage (family by blood grieve with the game's own
    thoughts), and the council's answer about a relative in the cells (Council_DlmS_KinInChains).
  -->

  <ThoughtDef>
    <defName>Council_Fam_Reunited</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>reunited with family</label>
        <description>After all this time we're under the same roof again. I keep looking over to make sure it's real.</description>
        <baseMoodEffect>6</baseMoodEffect>
        <baseOpinionOffset>10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_KinAmongRaiders</defName>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>family among the raiders</label>
        <description>Someone of my own family came here with the raiders. I don't know what I'd do with them in my sights.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_DiedByMarriage</defName>
    <durationDays>8</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>a death in the family</label>
        <description>Someone who became family to me through marriage has died. Not my blood, but family all the same.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_KinSetFree</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>my family let go home</label>
        <description>The council let my relative out of the cells to go home. I'd rather have had them here, but they're free.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_KinHope</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>hope for my family</label>
        <description>The council will let me try to win my relative over. Maybe they'll stay, and not as a prisoner.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_KinKept</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>my family in a cell</label>
        <description>Someone of my own family sits in the colony's cells, and the council means to keep them there like anyone else.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!--
    The family's life together (Source/ColonyCouncil/Social/FamilyLife.cs): a new couple or an engagement and how those
    close to them take it, a refused proposal and a friend's word, a child on the way told to the partner and the
    grandparents, a child lost before birth (the parents' grief is the game's own), and the birthdays a family marks.
  -->

  <ThoughtDef>
    <defName>Council_Fam_GladForThem</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>glad they found someone</label>
        <description>Someone I care about has found someone of their own. It's good to see them like this.</description>
        <baseMoodEffect>3</baseMoodEffect>
        <baseOpinionOffset>4</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Fam_MatchDoubted</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>not good enough for my family</label>
        <description>Of everyone they could have chosen, my relative chose this one. I'll be civil about it, and that's all.</description>
        <baseMoodEffect>-2</baseMoodEffect>
        <baseOpinionOffset>-10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Fam_ChildEngaged</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>my child is engaged</label>
        <description>My child is going to be married. I remember when they couldn't tie their own boots.</description>
        <baseMoodEffect>5</baseMoodEffect>
        <baseOpinionOffset>5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Fam_Comforted</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a friend's word after the proposal</label>
        <description>It still stings. But someone came and found me, and said the right thing, and that helped.</description>
        <baseMoodEffect>3</baseMoodEffect>
        <baseOpinionOffset>6</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Fam_BabyComing</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a child on the way</label>
        <description>We're going to have a child. I keep thinking of names, and then of everything that needs doing first.</description>
        <baseMoodEffect>6</baseMoodEffect>
        <baseOpinionOffset>8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_BabyComingWorried</defName>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a child on the way, not yet wanted</label>
        <description>A child is coming whether we're ready or not. I don't know yet how I feel about it.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Fam_GrandchildComing</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>a grandchild on the way</label>
        <description>My child is going to have a child of their own. Me, a grandparent.</description>
        <baseMoodEffect>5</baseMoodEffect>
        <baseOpinionOffset>5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_LostGrandchild</defName>
    <durationDays>10</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>lost a grandchild before birth</label>
        <description>The child my own child was expecting is gone before it ever drew breath. I grieve for it, and for them.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_ChildGrown</defName>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>my child is growing up</label>
        <description>We raised a glass to my child's birthday tonight. They're growing up faster than I'm ready for.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_BirthdayToast</defName>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a toast on my birthday</label>
        <description>My family raised their glasses to me tonight, all of them at once. I didn't know where to look.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- A child taken in (Social/FamilyGuardians.cs) -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_TookInChild</defName>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a child of my own to raise</label>
        <description>The council named me the one to raise them. I keep checking on them, and they keep catching me at it.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_TakenIn</defName>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>somebody's own again</label>
        <description>Somebody here is mine now, to run to and answer to. It's for good, they said.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_RaisedByAll</defName>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>everyone's child</label>
        <description>The whole colony said I'm theirs. That's a lot of people to answer to, and a lot to ask.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- The one left (Social/FamilyLife.cs): a wedding day kept alone, and a widowed parent's children and a new partner. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_OurDay</defName>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>our wedding day, kept</label>
        <description>It was our wedding day today. I kept it the only way I can now, and I'm glad I did.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_ParentHappyAgain</defName>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>my parent is happy again</label>
        <description>My parent has found someone again. It's strange to see, and I'm glad.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Fam_ParentMovedOn</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>in my late parent's place</label>
        <description>My parent has someone new, and it feels as if they're taking a place that was never theirs.</description>
        <baseMoodEffect>-3</baseMoodEffect>
        <baseOpinionOffset>-10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <!-- The family's days together (Source/ColonyCouncil/Social/FamilyBonds.cs). -->

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_FamilySupper</defName>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>supper with my family</label>
        <description>My family at one table, passing the dishes down and talking over each other. We should do it more often.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Fam_SiblingClose</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>close as ever</label>
        <description>We talked the way only a brother or sister can, about things nobody else here remembers.</description>
        <baseMoodEffect>2</baseMoodEffect>
        <baseOpinionOffset>8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Fam_SiblingRivalry</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>the same old rivalry</label>
        <description>All grown up, and they still know exactly how to get under my skin.</description>
        <baseMoodEffect>-2</baseMoodEffect>
        <baseOpinionOffset>-8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Fam_ChildLookedIn</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>my child looked in on me</label>
        <description>My child came and sat with me a while. I'm not as young as I was, and it's a good thing to be looked in on.</description>
        <baseMoodEffect>4</baseMoodEffect>
        <baseOpinionOffset>6</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Fam_LookedAfterParent</defName>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>looked in on my parent</label>
        <description>I sat with my parent a while. They're getting on, and I'd rather be there than not.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
