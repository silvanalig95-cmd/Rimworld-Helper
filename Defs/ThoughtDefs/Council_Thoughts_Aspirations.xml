<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThoughtDef>
    <defName>Council_Asp_Fulfilled</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages><li><label>reached my life goal</label><description>I've done what I always said I'd do. I keep turning it over in my head, just to feel it again.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
    <!-- Counts in full: not shrunk by standards, not shortened in good times, not one of the good moods that add up slowly. -->
    <modExtensions><li Class="ColonyCouncil.Milestone" /></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Asp_InReach</defName>
    <workerClass>ColonyCouncil.ThoughtWorker_GoalInReach</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages><li><label>my goal is within reach</label><description>I've nearly done what I set my heart on. I think about it every night before I sleep.</description><baseMoodEffect>2</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
