<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThoughtDef>
    <defName>Council_Asp_Fulfilled</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages><li><label>lived my dream</label><description>I said I'd do it, and I did. Whatever happens now, I did that.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Asp_InReach</defName>
    <workerClass>ColonyCouncil.ThoughtWorker_GoalInReach</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages><li><label>my goal is within reach</label><description>I can almost touch it. Just a little longer.</description><baseMoodEffect>2</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
