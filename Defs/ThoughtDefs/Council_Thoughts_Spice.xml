<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Justice</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>justice was done</label>
        <description>The raider in the cell got what was coming. I sleep better now.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Mercy</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>we showed mercy</label>
        <description>The prisoner is out of that cell for good. I'm glad we're not the kind to keep someone caged.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Party</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>we needed that party</label>
        <description>I wanted one good night, and we had it.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Rescue</defName>
    <durationDays>12</durationDays>
    <stages>
      <li>
        <label>they came back for us</label>
        <description>Someone I love was taken, and the colony went and brought them home.</description>
        <baseMoodEffect>10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_BroughtHome</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>we don't leave our own behind</label>
        <description>One of us was taken, and we went and got them back. If it's ever me, they'll come.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Hunt</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>good hunt</label>
        <description>I got out in the open, tracked it down and made a clean kill. I needed that.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_FriendQuit</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>a friend walked out</label>
        <description>My friend packed up and left the colony because the council never listened to them.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Outside</defName>
    <durationDays>3</durationDays>
    <stages><li><label>finally outside</label><description>I finally got outside, with the sky over my head and wind in my face.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Fix</defName>
    <durationDays>3</durationDays>
    <stages><li><label>supply secured</label><description>There's enough in the stores to keep the shakes away. I've counted it twice.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Quit</defName>
    <durationDays>15</durationDays>
    <stages><li><label>got clean</label><description>I'm clean. The others kept it out of my reach when I couldn't keep my own hands off it.</description><baseMoodEffect>10</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Separate</defName>
    <durationDays>5</durationDays>
    <stages><li><label>sleeping in peace</label><description>I don't have to share a room with someone I can't stand anymore.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Infirmary</defName>
    <durationDays>5</durationDays>
    <stages><li><label>a stocked infirmary</label><description>Enough medicine for anyone who needs it. I can do my job properly.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Anniversary</defName>
    <durationDays>3</durationDays>
    <stages><li><label>another year here</label><description>I've been here another year now, and the others remembered.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_FriendAnniversary</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>a friend's anniversary</label><description>Another year with them around. I'd raise a cup to that.</description><baseMoodEffect>2</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Epithet</defName>
    <durationDays>6</durationDays>
    <stages><li><label>earned a name</label><description>The colony has a name for me now, for what I do. I could get used to that.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EpithetDubious</defName>
    <durationDays>4</durationDays>
    <stages><li><label>a dubious nickname</label><description>They've given me a name. I'm not sure it's a compliment.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EpithetLost</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>took my name</label><description>That name was mine, and now they call them by it.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_PetBed</defName>
    <durationDays>6</durationDays>
    <stages><li><label>my animal sleeps beside me</label><description>My animal sleeps next to my bed now. I sleep better hearing it breathe.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_HurtAnimal</defName>
    <durationDays>4</durationDays>
    <stages><li><label>my animal was patched up</label><description>They took care of my animal as if it were one of us. It's back on its feet.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
