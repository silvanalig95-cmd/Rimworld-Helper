<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Justice</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>justice was done</label>
        <description>The raider in the cell got what was coming. I sleep better now.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Mercy</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>we showed mercy</label>
        <description>We let them out of the cage. Whatever else we are out here, we're not that.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Party</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>we needed that party</label>
        <description>I asked for one good night, and we had it.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Rescue</defName>
    <durationDays>12</durationDays>
    <stages>
      <li>
        <label>they came back for us</label>
        <description>Someone I love was taken, and the colony went and brought them home.</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_BroughtHome</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>we don't leave our own behind</label>
        <description>One of us was taken, and we went and got them back. If it's ever me, they'll come.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Hunt</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>good hunt</label>
        <description>Out in the open with a weapon and a clean shot. I needed that.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_FriendQuit</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>a friend walked out</label>
        <description>They packed up and walked out, because nobody listened. I'd have listened.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Outside</defName>
    <durationDays>3</durationDays>
    <stages><li><label>finally outside</label><description>Sky over my head and wind in my face. I needed that more than I knew.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Fix</defName>
    <durationDays>3</durationDays>
    <stages><li><label>supply secured</label><description>There's enough to keep the shakes away. For now.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Quit</defName>
    <durationDays>15</durationDays>
    <stages><li><label>got clean</label><description>I beat it. The colony held the line when I couldn't. I feel like myself again.</description><baseMoodEffect>12</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Separate</defName>
    <durationDays>5</durationDays>
    <stages><li><label>sleeping in peace</label><description>No more sharing a room with someone I can't stand.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Infirmary</defName>
    <durationDays>5</durationDays>
    <stages><li><label>a stocked infirmary</label><description>Enough medicine for anyone who needs it. I can do my job properly.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Anniversary</defName>
    <durationDays>3</durationDays>
    <stages><li><label>another year here</label><description>Another year in this place. Still alive, still here. People remembered.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_FriendAnniversary</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>a friend's anniversary</label><description>Another year with them around. Glad of it.</description><baseMoodEffect>2</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Epithet</defName>
    <durationDays>6</durationDays>
    <stages><li><label>earned a name</label><description>The colony has a name for me now, for what I do. I could get used to that.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EpithetDubious</defName>
    <durationDays>4</durationDays>
    <stages><li><label>a dubious nickname</label><description>They've given me a name. I'm not sure it's a compliment.</description><baseMoodEffect>1</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EpithetLost</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>took my name</label><description>That name was mine. Now everyone uses it for them.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_PetBed</defName>
    <durationDays>6</durationDays>
    <stages><li><label>my animal sleeps beside me</label><description>Breathing in the dark next to my bed. I sleep better knowing they're there.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_HurtAnimal</defName>
    <durationDays>4</durationDays>
    <stages><li><label>my animal was patched up</label><description>They took care of my animal like it mattered. It does.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
