<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- What the maker of a piece of art feels when the colony sells it to a collector (Happenings/Workers_Callers.cs):
       proud of the sale, or, for an artist by passion who isn't greedy, hurt to see it go. -->

  <ThoughtDef>
    <defName>Rimfolk_Evt_ArtSoldProud</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a collector bought my work</label><description>A collector came all this way, looked at my piece for a long time, and paid good silver for it. Somewhere out there it stands in a stranger's hall.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Pride</li></feelings><felt>3</felt><journal>true</journal></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Rimfolk_Evt_ArtSoldHurt</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>they sold my work</label><description>I put more of myself into that piece than into anything I've made here, and the council sold it to the first collector who asked. The corner where it stood is bare.</description><baseMoodEffect>-4</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
