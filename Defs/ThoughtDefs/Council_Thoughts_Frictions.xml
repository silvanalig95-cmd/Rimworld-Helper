<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Everyday frictions between colonists (Defs/InteractionDefs/Council_Moments_Frictions.xml): small, short and never
    more than a few points of mood. One of each per other person at most (stackLimitForSameOtherPawn), so a pair can't
    pile them up. The two "Council_Mend_" thoughts are for making up afterward: no mood, a little opinion back.
  -->

  <ThoughtDef Name="Council_FrictionThoughtBase" Abstract="True">
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
  </ThoughtDef>

  <!-- ===================== Chores and shared work ===================== -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_ChoreSpat</defName>
    <stages><li><label>argued about the chores</label><description>We argued about whose turn it was. I know whose turn it was.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_LeftAMess</defName>
    <stages><li><label>cleaned up after them</label><description>They left their mess all over the bench for me to clear before I could start.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Nagged</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>got an earful</label><description>They went on at me about it. I heard them the first time.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_MuddyFloor</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>mud on my clean floor</label><description>I'd only just swept that floor. Now there's a trail of boot prints across it.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_DoingTheirShare</defName>
    <stages><li><label>doing their share for them</label><description>I worked, they sat. I'm keeping count, even if they aren't.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_UnaskedAdvice</defName>
    <stages><li><label>advice I didn't ask for</label><description>They watched me work for a moment, then told me how they'd do it. They're probably right, which makes it worse.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Sharing a room ===================== -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Snoring</defName>
    <stages><li><label>kept awake by snoring</label><description>Their snoring went on until the small hours. I lay there counting.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_SaysISnore</defName>
    <stages><li><label>says I snore</label><description>They claim I snore. I've never once heard it.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Woken</defName>
    <stages><li><label>woken in the dark</label><description>Someone I share a room with has no idea how loud they are in the dark.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_BedSquabble</defName>
    <stages><li><label>a squabble over beds</label><description>We argued about who gets the spot out of the draft. I'm still cold, and still right.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_LightsOut</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>argued about bedtime</label><description>One of us wanted to sleep, the other wanted the light on a while longer. Neither of us got much rest.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Small comforts ===================== -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_LastGoodMeal</defName>
    <stages><li><label>they took the last good meal</label><description>I was looking forward to it all afternoon, and they got there first.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_TookMySeat</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>they took my seat</label><description>That's been my seat since the day the table went in. They knew that.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_NotReturned</defName>
    <durationDays>1.5</durationDays>
    <stages><li><label>they still have my things</label><description>I lent it to them days ago. I've seen it in their hands since, so it isn't lost.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Accused</defName>
    <stages><li><label>accused of touching their things</label><description>They think I've been through their things. I haven't, and I wouldn't want any of it.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Words ===================== -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Corrected</defName>
    <stages><li><label>corrected with others listening</label><description>I got one small thing wrong, and they made sure the others at the table heard about it.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_BadJoke</defName>
    <stages><li><label>a joke at my expense</label><description>They meant it as a joke. I didn't take it as one.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Friction_JokeFell</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>a joke that fell flat</label><description>I made a joke and it landed wrong. I keep going over it.</description><baseMoodEffect>-1</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Teased</defName>
    <durationDays>1.5</durationDays>
    <stages><li><label>teased too far</label><description>It was funny the first few times. Then they kept going.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_TalkedAboutMe</defName>
    <durationDays>1.5</durationDays>
    <stages><li><label>they talked behind my back</label><description>I heard my name, and then I heard the rest of it.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_CaughtGossiping</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>caught gossiping</label><description>I said something about them I shouldn't have, and they heard every word.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_LeftOut</defName>
    <stages><li><label>not asked along</label><description>They had it all planned before anyone thought to ask me.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Habits ===================== -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Humming</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>their habit grates</label><description>They've been at it since breakfast, and now I can't stop hearing it.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Chewing</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>a noisy eater</label><description>I could hear every bite they took, from the other end of the table.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_PetMischief</defName>
    <stages><li><label>their animal again</label><description>Their animal got into my things again. They seem to think it's charming.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_TemperatureSpat</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>argued about the temperature</label><description>When I'm cold they're too warm, and they always get their way about the door.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_CookingCriticized</defName>
    <stages><li><label>my cooking was criticized</label><description>I stood over that pot all afternoon, and all they could say was that it needed salt.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_NaggedHabit</defName>
    <stages><li><label>lectured about my habits</label><description>They counted my drinks. Out loud.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Grudges and beliefs ===================== -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_SilentTreatment</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>the silent treatment</label><description>They're still sulking about the other day. It was one argument.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_ColdShoulder</defName>
    <stages><li><label>the cold shoulder</label><description>They looked right past me again. I don't know what I did, and I'm not going to ask.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_FaithRemark</defName>
    <durationDays>1.5</durationDays>
    <stages><li><label>a remark about my faith</label><description>They made a crack about what I believe. They wouldn't like it if I did the same to them.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Mods: Dubs Bad Hygiene ===================== -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Washroom</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>waited for the washroom</label><description>They took their time in there, and left the floor wet when they were done.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Making up ===================== -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Mend_AirCleared</defName>
    <durationDays>1.5</durationDays>
    <stages><li><label>cleared the air</label><description>We talked it over, and I can look them in the eye again.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Mend_TalkedItOut</defName>
    <durationDays>1.5</durationDays>
    <stages><li><label>talked it out</label><description>I was still stewing over that squabble. They let me get it all out, and now it seems smaller.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>3</baseOpinionOffset></li></stages>
  </ThoughtDef>

</Defs>
