<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Thoughts from Rimfolk's scenarios: two families who never got on, a tyrant in the cellar, a hunt that ended,
       a debt paid. The opinions fade over their last third, like any memory. -->

  <ThoughtDef>
    <defName>Council_Scen_Kin</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>90</durationDays>
    <stackLimit>100</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>family</label><description>We've shared a table since long before we came out here, and we'll go on sharing one.</description><baseOpinionOffset>20</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Scen_Feud</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>45</durationDays>
    <stackLimit>100</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>bad blood between our families</label><description>Their family and mine go back a long way, and none of it is good. Sharing a roof with them doesn't change that.</description><baseOpinionOffset>-20</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Scen_Tyrant</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>120</durationDays>
    <stackLimit>100</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>my old master</label><description>For years I worked when they said work and ate when they said eat. Now they're the one behind a door.</description><baseOpinionOffset>-60</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Scen_OldFriend</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>90</durationDays>
    <stackLimit>100</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>we go back a long way</label><description>We came out here together. Whatever this place throws at us, I know who I'm facing it with.</description><baseOpinionOffset>25</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Scen_HuntOver</defName>
    <durationDays>8</durationDays>
    <stages><li><label>the hunt is over</label><description>No one is hunting us anymore. I still watch the horizon out of habit.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Scen_DebtPaid</defName>
    <durationDays>5</durationDays>
    <stages><li><label>debt paid</label><description>Our debt is paid, down to the last coin. No more counting the days until they come to collect.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
