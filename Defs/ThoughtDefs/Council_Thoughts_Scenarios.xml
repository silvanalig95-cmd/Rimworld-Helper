<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Thoughts from Rimfolk's scenarios: two families who never got on, a tyrant in the cellar, a hunt that ended,
       a debt paid. The opinions fade over their last third, like any memory. -->

  <ThoughtDef>
    <defName>Council_Scen_Kin</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>90</durationDays>
    <stackLimit>100</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>family</label><description>Whatever happens out here, we stick together. We always have.</description><baseOpinionOffset>25</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Scen_Feud</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>60</durationDays>
    <stackLimit>100</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>bad blood between our families</label><description>Their family and mine go back a long way, and none of it is good. Sharing a roof with them doesn't change that.</description><baseOpinionOffset>-30</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Scen_Tyrant</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>120</durationDays>
    <stackLimit>100</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>my old master</label><description>For years I worked when they said work and ate when they said eat. Now they're the one behind a door.</description><baseOpinionOffset>-60</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Scen_HuntOver</defName>
    <durationDays>8</durationDays>
    <stages><li><label>the hunt is over</label><description>Nobody is coming for us any more. I keep looking at the horizon out of habit, and there's nothing there.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Scen_DebtPaid</defName>
    <durationDays>5</durationDays>
    <stages><li><label>debt paid</label><description>We don't owe anybody anything. It's amazing how much lighter that makes everything.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
