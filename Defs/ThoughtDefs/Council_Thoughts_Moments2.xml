<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Moods from the second set of moments (Defs/InteractionDefs/Council_Moments2.xml) and frictions
    (Council_Moments_Frictions2.xml). Small and short, one per other person. Their names start with Council_Moment_ and
    Council_Friction_, so the heart's feelings take them in the way they take the first set.
  -->

  <ThoughtDef Name="Council_Moment2Base" Abstract="True">
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
  </ThoughtDef>

  <!-- ===================== Natures that meet ===================== -->

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_FriendlyDisagreement</defName>
    <stages><li><label>a friendly disagreement</label><description>Whatever I say about tomorrow, they say the opposite. We had a good long argument about it.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>2</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_NightCompany</defName>
    <stages><li><label>company in the small hours</label><description>Two of us awake while the colony slept. The night went quicker for the company.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.06</joy><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_UnderTheMountain</defName>
    <stages><li><label>a fellow under the mountain</label><description>They like rock overhead as much as I do. We sat in the cool of the tunnels and didn't miss the sky.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_ComparedScars</defName>
    <stages><li><label>compared scars</label><description>We showed each other our scars and told the stories. Theirs were nearly as good as mine.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_FeltSafer</defName>
    <durationDays>2</durationDays>
    <stages><li><label>someone will stand in front</label><description>They promised to be close by if trouble comes again. My hands have stopped shaking.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_TheyRemembered</defName>
    <durationDays>2</durationDays>
    <stages><li><label>they remembered</label><description>They remembered something I said weeks ago. I didn't think anyone was listening.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_PlannedAFeast</defName>
    <stages><li><label>planned a feast</label><description>We planned a whole feast down to the sauces. We'll never cook it, and it was still a good hour.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.06</joy><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_AMindToMatch</defName>
    <stages><li><label>a mind to match mine</label><description>We talked through a problem the others gave up following hours ago. They kept up with every step.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><skill>Intellectual</skill><xp>100</xp><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_WorkedLate</defName>
    <stages><li><label>worked late together</label><description>We kept at it after the others stopped. Good to work beside someone who doesn't need telling.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_Steadied</defName>
    <durationDays>2</durationDays>
    <stages><li><label>they steadied me</label><description>I was coming apart, and they stayed calm until I wasn't.</description><baseMoodEffect>3</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Illness ===================== -->

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_VisitedWhileIll</defName>
    <durationDays>2</durationDays>
    <stages><li><label>visited while I was ill</label><description>I felt rotten, and they came by to sit with me and tell me all the news.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_SickTogether</defName>
    <stages><li><label>sick together</label><description>We're both feeling poorly, so we sat and sniffled at each other across the table.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>3</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_GotARemedy</defName>
    <stages><li><label>an old remedy</label><description>They swore by some old cure for what I've got. It might even work.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>2</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_WelcomedBack</defName>
    <durationDays>2</durationDays>
    <stages><li><label>welcomed back on my feet</label><description>They were so glad to see me up again. I hadn't known they'd been worried.</description><baseMoodEffect>2</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== The council, camps and the region ===================== -->

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_TalkedOverMeeting</defName>
    <stages><li><label>talked over the meeting</label><description>We went over the council meeting point by point on the way out. I know what I should have said now.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>2</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><trust>1</trust><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_WatchedTheCamp</defName>
    <stages><li><label>watched the camp together</label><description>We watched the camp from the wall and made up stories about the people in it.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>3</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.06</joy><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <!-- ===================== What they feel ===================== -->

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_SaidItOutLoud</defName>
    <durationDays>2</durationDays>
    <stages><li><label>said it out loud</label><description>I told them what I've been afraid of lately. They didn't laugh, and they didn't try to fix it.</description><baseMoodEffect>3</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_HeardTheirWorries</defName>
    <stages><li><label>trusted with their worries</label><description>They walked the walls with me and talked through what's been worrying them. I'll keep it to myself.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_ThankedAgain</defName>
    <durationDays>2</durationDays>
    <stages><li><label>thanked again</label><description>They thanked me again for what I did. I told them to stop, but I didn't mean it.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_RepaidAKindness</defName>
    <stages><li><label>repaid a kindness</label><description>They did me a good turn once. Today I did one back.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>3</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_Moment2Base">
    <defName>Council_Moment_PlansAhead</defName>
    <stages><li><label>plans for the years ahead</label><description>We talked about what this place could be in ten years. I want to see it.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>3</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Hope</li></feelings><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <!-- ===================== Frictions ===================== -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_ThatVoice</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>that voice</label><description>Their voice goes right through me. I had to say something.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_ToldToHush</defName>
    <stages><li><label>told to hush</label><description>They asked me to keep it down. I wasn't even being loud.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Startled</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>gave me a fright</label><description>They crept up on me again, breathing like that. My heart's still going.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_CalledCreepy</defName>
    <stages><li><label>treated like a creep</label><description>They jumped away from me as if I'd done something. I was only standing there.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_FireWorry</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>keeping an eye on the fire-lover</label><description>I keep catching them staring into the hearth. I've moved the lamp oil somewhere higher.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_NotTrusted</defName>
    <stages><li><label>not trusted near a fire</label><description>They took the tinderbox off me again, like a child.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Lectured</defName>
    <stages><li><label>lectured about my things</label><description>They told me I own too much. I'll own what I like, thank you.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_TooMuchSkin</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>saw more than I wanted to</label><description>Some of us would like to eat without seeing quite so much of a person.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_ToldToDress</defName>
    <stages><li><label>told to get dressed</label><description>They keep telling me to put more clothes on. My body is my business.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Pace</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>couldn't agree on a pace</label><description>We tried to walk somewhere together. One of us was too fast and one too slow.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_BodyArgument</defName>
    <stages><li><label>argued about implants</label><description>We argued about machine parts and what makes a person. Neither of us moved an inch.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_Shunned</defName>
    <stages><li><label>treated like I'm catching</label><description>I'm ill, not cursed. They moved away from me at the table.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_CampSpat</defName>
    <stages><li><label>argued about the camp</label><description>We argued about the people camped on our land. They're wrong about them.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_SnappedAt</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>snapped at</label><description>They bit my head off over nothing. Whatever's eating them, it wasn't me.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

</Defs>
