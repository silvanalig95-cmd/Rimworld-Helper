<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Moods from Rimfolk's world events (Defs/IncidentDefs/Council_Events_*.xml). -->

  <!-- ===================== Pasts catching up ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_Reunited</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>reunited with family</label><description>After all these years, we've found each other again. I still can't quite believe it.</description><baseMoodEffect>10</baseMoodEffect><baseOpinionOffset>20</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_KinTurnedAway</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my family was turned away</label><description>My family found me after all those years, and the colony sent them back down the road.</description><baseMoodEffect>-8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_OldComrade</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>back with an old comrade</label><description>An old comrade is with me again. I don't have to explain anything to them.</description><baseMoodEffect>6</baseMoodEffect><baseOpinionOffset>18</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FriendTurnedAway</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>an old friend was turned away</label><description>An old friend came all this way, and we turned them away. I understand why, but I don't like it.</description><baseMoodEffect>-4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_OldFlame</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my old flame is here</label><description>Of all the places to end up, my old flame ended up here. It's complicated, but I'm not sorry.</description><baseMoodEffect>3</baseMoodEffect><baseOpinionOffset>10</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_PartnersEx</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my partner's ex moved in</label><description>My partner's ex lives here now. I see them at every meal, smiling.</description><baseMoodEffect>-4</baseMoodEffect><baseOpinionOffset>-15</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_WelcomeBack</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>they came back</label><description>I always hoped they'd come back. It's good to see them at the table again.</description><baseMoodEffect>4</baseMoodEffect><baseOpinionOffset>12</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_UnwelcomeBack</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>they came back</label><description>We were rid of them. Now they're back, acting like nothing happened.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-12</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_HomeAgain</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>they let me come home</label><description>I walked away, and they still let me come back. I won't forget that.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_StoodByMe</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the colony stood by me</label><description>They came for me, for what I used to be, and the colony said no. I owe these people everything now.</description><baseMoodEffect>10</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_BoughtFreedom</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the colony paid for me</label><description>The colony paid good silver to settle my old mistakes. They didn't have to.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_GaveUpOneOfUs</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>we gave up one of our own</label><description>We handed one of us over to hunters. Whatever they did before, they were ours.</description><baseMoodEffect>-6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_DebtPaid</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my old debt is paid</label><description>The colony paid off what I owed from my old life. I don't have to watch the road anymore.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_PastCaughtUp</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my past caught up with me</label><description>I thought I'd left all that behind. Apparently it followed me here.</description><baseMoodEffect>-4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_Inheritance</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>an inheritance</label><description>An old acquaintance died and left me something. They remembered me at the end.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_TeacherLetter</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>word from my old teacher</label><description>My old teacher wrote to me, and still found things to correct in my technique. It made me smile.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_GoodNews</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>good news from home</label><description>The people I left behind are doing well. I didn't know how much I needed to hear that.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_HomeLost</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my old home is gone</label><description>The place I came from is gone. I can never go back now.</description><baseMoodEffect>-7</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_ApprenticeCame</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>someone came to learn from me</label><description>A young traveler walked all this way to learn from me, because they'd heard of my work. I'll try to be worth it.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FoundMaster</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>I found my master</label><description>The master from the stories is real, and here. I want to learn everything they know.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_Sheltered</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>they took me in</label><description>I ran from everything I knew, and these people didn't ask why. I'll repay that.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- ===================== Challenges ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_WonChallenge</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>2</stackLimit>
    <stages><li><label>beat the traveling champion</label><description>A champion came a long way to beat me, and I won. They'll be telling this one on the road.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_LostChallenge</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>2</stackLimit>
    <stages><li><label>lost to the traveling champion</label><description>The champion beat me while the others watched. I'll be practicing every evening until they come back.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_ChampionWon</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stages><li><label>our champion won</label><description>One of ours beat the traveling champion. Somebody ought to buy them a drink.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FelledBeast</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>felled the great beast</label><description>I brought down a beast out of the old stories. I'll be telling this one for the rest of my life.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_BeastDown</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the great beast is down</label><description>One of ours brought down a legendary beast. We'll be telling that story for years.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_TamedBeast</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>tamed a living legend</label><description>The others wanted to kill the great beast. It eats from my hand now.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_PaidTribute</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>we paid tribute</label><description>We handed over our silver because they had an army behind them.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_Defiance</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>we refused to bow</label><description>They demanded tribute, and we refused. Let them come.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_TreasureFound</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the map was true</label><description>We followed a stranger's scrap of a map, and the treasure was right where the mark said. I can't stop grinning.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_Swindled</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>swindled</label><description>We paid good silver for a map that led to nothing. I'll know that face if I ever see it again.</description><baseMoodEffect>-4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- ===================== Nature ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_Fireflies</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>saw the fireflies</label><description>Thousands of fireflies lit up over the fields last night. I stayed out watching until late.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_Hail</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>caught in the hail</label><description>I got caught out in hail the size of knuckles. My ears are still ringing.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_Comet</defName>
    <workerClass>ColonyCouncil.ThoughtWorker_Comet</workerClass>
    <stages>
      <li><label>the comet is a good omen</label><description>There's a comet in the sky. I'm sure it means good things are coming.</description><baseMoodEffect>4</baseMoodEffect></li>
      <li><label>the comet is a bad omen</label><description>A comet in the sky never means anything good. My grandmother always said so.</description><baseMoodEffect>-4</baseMoodEffect></li>
      <li><label>the comet</label><description>A tail of light across the whole sky. Whatever it means, it's beautiful.</description><baseMoodEffect>2</baseMoodEffect></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_PetCaughtVermin</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my animal saved the stores</label><description>Vermin got into the food stores, and my animal caught them before anyone else noticed.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FoundCache</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>found a buried cache</label><description>I found a cache someone buried long ago and never came back for. Their loss.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_WildBounty</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the land is generous</label><description>There are wild berries ripe for picking all over, and none of us planted a thing.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <!-- ===================== Visitors ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_HeardTales</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>an evening of tales</label><description>A traveler told us stories all evening, about faraway places and terrible battles. Best night we've had in a long time.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_DeadHonored</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>strangers honored our dead</label><description>Strangers came a long way just to stand at one of our graves. Our dead are remembered out there too.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FedPilgrims</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>we fed the pilgrims</label><description>Hungry pilgrims came to our door, and we fed them.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Pride</li></feelings><felt>4</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_TurnedAwayHungry</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>we turned away the hungry</label><description>They only asked for a meal. We had a meal.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_StrayChoseMe</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a stray chose me</label><description>It followed me all the way home and wouldn't leave. I didn't try very hard to make it.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_StrayLetGo</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>had to let the stray go</label><description>We had to let the stray go. It kept looking back at me.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_ReturnedChild</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a lost child went home</label><description>Somewhere out there, a family got their child back because of us.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_KeptChild</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>we kept someone's child</label><description>A family is still out there searching, and we know exactly where their child is.</description><baseMoodEffect>-4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_TakenFromFamily</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>they kept me from my family</label><description>I was lost, and they found me, but they didn't take me home. They're nice to me here, but I want my family.</description><baseMoodEffect>-6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_ScholarTalk</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>talked all night with a scholar</label><description>I talked all night with a visiting scholar who saw things in my work I'd never thought of. My head is still buzzing.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- ===================== Chains ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_ChildCameBack</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the lost child came back</label><description>We walked a lost child home once. Now they've come back to say thank you.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_KindnessRepaid</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>kindness repaid</label><description>We fed some hungry strangers once, and they came back to repay us.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- ===================== Victories and quests ===================== -->

  <ThoughtDef>
    <defName>Council_Victory</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>we held</label><description>They came for us, and we sent them running. Every one of us is still alive, and tonight we drink to that.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_VictoryCostly</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>we held, at a price</label><description>We drove them off, but not all of us lived to see it.</description><baseMoodEffect>1</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_BattleHero</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>hero of the fight</label><description>The others saw what I did in that fight. I'm trying to be modest about it, and it isn't going well.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_QuestDone</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>2</stackLimit>
    <stages><li><label>a job well done</label><description>We said we'd do it, and we did. The colony's word is good.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Pride</li></feelings><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <!-- ===================== More events ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_SoldOne</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>they sold one of us</label><description>A stranger offered silver for one of us, and the council took it. I wonder what they'd take for me.</description><baseMoodEffect>-5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_AskedMe</defName>
