<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Moods from the Rimfolk events of the land and the turning year (Defs/IncidentDefs/Council_Events_Land.xml). -->

  <ThoughtDef>
    <defName>Council_Evt_MushroomSupper</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>wild mushrooms for supper</label><description>We had wild mushrooms for supper, fried with salt straight from the pan. I had seconds.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.08</joy><joyKind>Gluttonous</joyKind><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_WhiteNight</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>up all through the white night</label><description>The sun never really set, so we didn't go to bed. We sat up together until the birds started again.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_SleptLate</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>slept late</label><description>The council let us sleep late after the bright night. I didn't get up until the sun was high.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><rest>0.25</rest><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_DesertBloom</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the desert in flower</label><description>After the rain the sand turned to flowers, yellow and red as far as I could see. It won't last, and I'm glad I saw it.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_DryAtLast</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>dry under the roof again</label><description>The roofs are patched and the drains run. It's still raining, but not on my bed.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><comfort>0.2</comfort><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_RainyEvenings</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>games while it rained</label><description>We spent the wet evenings together playing games and telling stories. The rain was almost nice to listen to.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_RainFever</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>cooped up by the rain</label><description>It's rained for days. Everything's damp, everyone's under my feet, and my boots never dry.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_IceFair</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a day on the ice</label><description>We spent the day out on the frozen river, sliding about and warming our hands at a fire. My cheeks still sting.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_BirdsBack</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the birds came back</label><description>We stopped work to watch the birds come back for the spring. Winter is properly over now.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_StalkedTheRut</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>stalked the rutting stags</label><description>I got close enough to the fighting stags to hear their breath. I've never stalked anything that well.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_StagsAtDusk</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>watched the stags at dusk</label><description>We lay up on the ridge and watched the stags circle and roar below us until it got dark.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_SnowDay</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a snow day</label><description>The council called a snow day for the first snow. I got a snowball down the back of my collar and didn't even mind.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_KeptLongestNight</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>kept the longest night</label><description>We kept the fire going all through the longest night and saw the sun come back together.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_MidwinterSupper</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a midwinter supper</label><description>A proper supper on the longest night, and then bed. A good way to get through the dark.</description><baseMoodEffect>2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_SunCameBack</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the sun came back</label><description>The sun went dark in the middle of the day. We stood together and made all the noise we could until it came back.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_WatchedEclipse</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>watched the eclipse</label><description>I looked at the sun through dark glass while it went out, and someone explained how it works. I almost understood.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Awe</li></feelings><felt>4</felt></li></modExtensions>
  </ThoughtDef>

</Defs>
