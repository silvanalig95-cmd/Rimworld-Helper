<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The colony calendar (Source/ColonyCouncil/Calendar): small moods for a day kept. All share the budget of good
    moods; a tradition kept or broken uses the council's own Council_TraditionKept and Council_TraditionBroken.
  -->

  <!-- A remembrance: those who knew the dead, or fought that day, keep a quiet hour. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Cal_Remembered</defName>
    <durationDays>1.5</durationDays>
    <stages>
      <li>
        <label>a day of remembrance</label>
        <description>We kept a quiet hour for the day it happened. I still miss them.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- A long-serving colonist's birthday. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Cal_Birthday</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>my birthday, remembered</label>
        <description>It's my birthday, and the others remembered it without being told.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- A feast day when no gathering could be held. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Cal_FeastDay</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>a feast day</label>
        <description>We marked the day with a better supper than usual.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Cal_GamesDay</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>a day of games</label>
        <description>We took the afternoon off for games. My legs ache from the races.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!--
    The newer ways to keep a day give something other than mood (RewardInstead): a bonfire some recreation, a day of
    gifts a little recreation (its friendships are the real gift: CalendarKeeping.GiveGifts), a hunt a day's practice.
  -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Cal_BonfireNight</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>a night round the fire</label>
        <description>We built a fire for the day and sat round it with music until it burned down.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.12</joy><feelings><li>Fellowship</li></feelings><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Cal_GiftDay</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>a day of gifts</label>
        <description>We swapped small gifts after supper. I didn't expect anyone to have thought so hard about mine.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.06</joy><feelings><li>Gratitude</li></feelings><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Cal_HuntDay</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>a hunting day</label>
        <description>Out with the hunters from first light after the day's game. My aim's steadier for it.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><skill>Shooting</skill><xp>300</xp><joy>0.06</joy><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Cal_RestDay</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>a day of rest</label>
        <description>No work today. I slept late and didn't do one useful thing.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
