<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ======================= Base ======================= -->

  <ThoughtDef Name="Council_MemoryBase" Abstract="True">
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
  </ThoughtDef>

  <!-- ======================= General ======================= -->

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_HelpedSomeone</defName>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>spoke up for someone</label>
        <description>I put in a word for someone who wouldn't ask for themselves. The council listened.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_SpokeUpForMe</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>25</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>spoke up for me</label>
        <baseOpinionOffset>15</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_WishIgnored</defName>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>my request was ignored</label>
        <description>I asked the council for one thing. They let it sit until it didn't matter anymore.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_AmbitionAchieved</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>reached our goal together</label>
        <description>We set the colony a goal at the council and saw it through. Every one of us had a hand in it.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_MyAmbitionAchieved</defName>
    <durationDays>8</durationDays>
    <stages>
      <li>
        <label>my idea worked out</label>
        <description>I told the council what we should aim for, and we actually did it. I may mention whose idea it was, now and then.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_AmbitionFailed</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>fell short together</label>
        <description>We promised ourselves we'd get it done. We didn't.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PersonalTouchDone</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>made my room my own</label>
        <description>The little thing I planned for my room got built. It stands right where I pictured it.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_HeardAtMeeting</defName>
    <durationDays>2</durationDays>
    <stages>
      <li>
        <label>had my say at the council</label>
        <description>We sat down and argued over what the colony should do next. I got my piece in.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Fellowship</li></feelings><felt>2</felt></li></modExtensions>
  </ThoughtDef>


  <!-- ======================= Trust and fairness ======================= -->

  <ThoughtDef>
    <defName>Council_Trust</defName>
    <workerClass>ColonyCouncil.ThoughtWorker_CouncilTrust</workerClass>
    <thoughtClass>ColonyCouncil.Thought_CouncilTrust</thoughtClass>
    <stages>
      <li>
        <label>the council never listens</label>
        <description>I've asked the council for things over and over, and none of it came. I've about given up asking.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>doubts about the council</label>
        <description>The last few things I asked for went nowhere. I'm starting to wonder if it's worth asking.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>the council listens</label>
        <description>When I bring a problem to the council, they hear me out, and usually it gets dealt with.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
      <li>
        <label>faith in the council</label>
        <description>Whatever I bring to the council, they take it seriously. I don't lie awake rehearsing how to ask anymore.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Refused</defName>
    <durationDays>2</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>my request was refused</label>
        <description>They said no. At least they said it to my face.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_TookMatters</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>had to do it myself</label>
        <description>I did it myself, on my own time, since the council wasn't going to.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PromiseKept</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>a promise kept</label>
        <description>They said they'd do it, and they did. I'll believe them next time.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_BrokenPromise</defName>
    <durationDays>8</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>a broken promise</label>
        <description>I stopped asking because they promised. Then they never did it.</description>
        <baseMoodEffect>-7</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_StoodTogether</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>stood together</label>
        <baseOpinionOffset>8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Favoritism</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>4</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>the favorite</label>
        <description>They only have to ask, and the council says yes. I'm still waiting on my own request.</description>
        <baseMoodEffect>-2</baseMoodEffect>
        <baseOpinionOffset>-10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_HappyForThem</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>4</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>happy for a friend</label>
        <description>A friend of mine finally got what they'd been asking the council for. I was nearly as pleased as they were.</description>
        <baseMoodEffect>0</baseMoodEffect>
        <baseOpinionOffset>3</baseOpinionOffset>
      </li>
    </stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_SaferNow</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>safer behind the new defenses</label>
        <description>The new defenses are up. I sleep better with them between us and whatever's out there.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_LaidToRest</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>laid to rest properly</label>
        <description>They're laid to rest now, properly, not left lying out in the weather.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ======================= Wishes granted ======================= -->

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_OwnRoom</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>a room of my own at last</label>
        <description>A room of my own, with a door that shuts. The only snoring in there is mine.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_NicerBedroom</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>a bedroom worth bragging about</label>
        <description>They made my room nicer, just like I asked. I've been finding excuses to show people.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Spacious</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>room to breathe</label>
        <description>My room isn't a closet anymore. I can stretch out without hitting a wall.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_ShareBed</defName>
    <durationDays>7</durationDays>
    <stages>
      <li>
        <label>together at night</label>
        <description>We finally share a bed. I fall asleep listening to them breathe.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Furniture</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>a nicer room</label>
        <description>The piece I wanted for my room is built and in its place. I've already moved everything else around it.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Light</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>a light in my room</label>
        <description>There's a light in my room now. I can find my boots without crawling around on the floor.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_ComfortTemp</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>comfortable nights</label>
        <description>My room holds a decent temperature through the night. No more waking up to kick the blankets off, or to pile them on.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Dining</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>a proper table</label>
        <description>We have a proper table now. I don't have to eat off my knees anymore.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Recreation</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>something new to do</label>
        <description>There's finally something to do in my free time besides watching the clouds.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Greenery</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>something green</label>
        <description>A plant in a pot, right by my bed. I've caught myself talking to it.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_PassionSpace</defName>
    <durationDays>7</durationDays>
    <stages>
      <li>
        <label>a place for my craft</label>
        <description>I have a proper place for my work now, with everything in reach. I mean to do my best work in there.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_LetMeWork</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>doing what I love</label>
        <description>They let me back at the work I actually care about. The days go faster.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Artwork</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>art where we gather</label>
        <description>There's new art in the room where we gather. It's the first thing I look at when I walk in.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Weapon</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>a weapon worth carrying</label>
        <description>I've got a weapon I can trust now. I check it over every evening anyway.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Brewery</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>brewing our own</label>
        <description>We're brewing our own beer now. I'm looking forward to the first barrel.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Food</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>real food</label>
        <description>Proper meals again, cooked and hot, not whatever we can scrounge.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Freezer</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>nothing will rot</label>
        <description>We have cold storage now. No more watching good meat turn green.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Clothes</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>decent clothes</label>
        <description>I have clean clothes now that didn't come off a corpse. I keep smoothing the sleeves.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Memorial</defName>
    <durationDays>8</durationDays>
    <stages>
      <li>
        <label>the burial I asked for</label>
        <description>I asked that they be laid to rest, and now they are. I know where to go when I want to talk to them.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Prosthetic</defName>
    <durationDays>8</durationDays>
    <stages>
      <li>
        <label>whole again</label>
        <description>It's not the body I was born with, but it works. I've caught myself using it without thinking.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Companion</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>a new animal friend</label>
        <description>We took in a new animal. I already have a name picked out.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Defenses</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>the defenses I asked for</label>
        <description>The defenses I asked for are built. I've walked the whole line twice just to look.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Royal</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>befitting my station</label>
        <description>My quarters finally reflect my title. One mustn't live like a peasant.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_ChildPlay</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>somewhere to learn and play</label>
        <description>The grown-ups made a place just for me to play!</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Wedding</defName>
    <durationDays>8</durationDays>
    <stages>
      <li>
        <label>we got married</label>
        <description>We're married now. The council made sure we had our day.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Birthday</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>a proper birthday</label>
        <description>They made a fuss over my birthday. Dinner was the best I've had in a season.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Art</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>art in my room</label>
        <description>My room has a piece of art in it now. I like looking at it before I sleep.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_DayOff</defName>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>finally some rest</label>
        <description>I have proper hours off now. I spent the first of them lying on my back doing nothing at all.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_LittleSomething</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>something to take the edge off</label>
        <description>There's drink and smoke in the stores again. The evenings go down easier.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Recruit</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>they joined us</label>
        <description>I said they belonged with us, and now they do.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Tidy</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>a clean home again</label>
        <description>Someone finally scrubbed the floors. I can cross the room without watching where I step.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Music</defName>
    <durationDays>6</durationDays>
    <stages>
      <li>
        <label>music in the evenings</label>
        <description>We have music in the evenings now. I catch myself humming the tunes at work.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_Armor</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>properly armored</label>
        <description>My new armor is heavy, but I'll take the weight over a hole in me.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_ObjectionIgnored</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>got their way over my objection</label>
        <description>I told the council it was a bad idea. They did it anyway, because this one asked.</description>
        <baseMoodEffect>-2</baseMoodEffect>
        <baseOpinionOffset>-6</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_ObjectionHeard</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>my objection was heard</label>
        <description>I told the council why it was a bad idea, and they agreed with me.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- A room of their own taken away again is one of the granted wishes watched by "promises kept": Council_Thoughts_Kept.xml. -->

</Defs>
