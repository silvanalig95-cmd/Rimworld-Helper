<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Moods from the answers added to older Rimfolk events: a letter from home, the lost child grown. -->

  <ThoughtDef>
    <defName>Council_Evt_ParcelHome</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>sent a parcel home</label><description>I packed a parcel for my family and sent it off with a trader. I keep picturing them opening it.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_LetterReadOut</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a letter read at supper</label><description>Someone read their letter from home out at supper. I've never met any of those people, and now I know all about their dog.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.08</joy><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_TaughtYoungGuest</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>taught a young guest a trade</label><description>I spent a day at the workbench showing a young visitor how we make things here. They left with sore hands and a trade.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
