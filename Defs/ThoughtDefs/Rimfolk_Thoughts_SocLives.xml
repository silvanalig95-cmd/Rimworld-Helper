<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The small rewards of the social events and moments of the old and of the newer quirks
    (Rimfolk_SocialEvents_Lives.xml, Rimfolk_Moments_Lives.xml): never a mood, something small instead.
  -->

  <ThoughtDef>
    <defName>Council_SocLv_HeardTheOldDays</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>heard about the old days</label><description>They told me how this place looked when they first came, with a name for every corner of it.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><joy>0.05</joy><feelings><li>Nostalgia</li></feelings></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_SocLv_Reminisced</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>remembered the old days</label><description>We talked about the old days, aches and all, and names no one else here would know.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><joy>0.06</joy><feelings><li>Nostalgia</li><li>Fellowship</li></feelings></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_SocLv_OldGame</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>played an old game</label><description>We played a game with pebbles and lines in the dirt, the old kind, until it was too dark to see the lines.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><joy>0.08</joy><joyKind>Gaming_Dexterity</joyKind></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_SocLv_WiseWord</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>an old saying that helped</label><description>They answered my grumbling with an old saying, and I've been chewing on it all afternoon.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><rest>0.05</rest></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_SocLv_StoryHour</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>a story at bedtime</label><description>A story before bed, with all the voices. I want another one tomorrow.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>6</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><joy>0.08</joy><rest>0.05</rest></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_SocLv_WorryEased</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>a worry eased</label><description>They went over it with me, every bit of it, until I believed it. I slept that night.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>6</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><rest>0.15</rest><feelings><li>Relief</li></feelings></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_SocLv_TookMyTurn</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>took my turn at the worst job</label><description>They took my turn at the worst job before I'd even finished dreading it. I owe them one.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>8</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><rest>0.1</rest><feelings><li>Gratitude</li></feelings></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Moment_ShownTheStars</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>shown the stars</label><description>They showed me shapes in the stars I'd never seen, and now I can't stop seeing them.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>4</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><joy>0.06</joy><joyKind>Meditative</joyKind><feelings><li>Awe</li></feelings></li></modExtensions>
  </ThoughtDef>

  <!-- A light left burning all night in a shared room (a friction, see Council_Moments_Frictions.xml). -->

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_KeptUpByLight</defName>
    <durationDays>0.5</durationDays>
    <stages><li><label>kept up by the night light</label><description>Their candle burned all night again. I lay there watching the shadows move.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_FrictionThoughtBase">
    <defName>Council_Friction_LightMocked</defName>
    <stages><li><label>complained about my light</label><description>They want me to sleep in the dark. They don't know what the dark is like for me.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

</Defs>
