<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Feelings from release F's peoples (Defs/IncidentDefs/Rimfolk_Events_PeoplesF.xml, Defs/MissionDefs/
       Rimfolk_Missions_PeoplesF.xml, Peoples/PeoplesF2.cs): the Last Republic's radio praising or denouncing the colony,
       a season served in its Civic Guard, a witness at its count, a shift worked with the Deepwell Union, a strike
       settled. Each a feeling rather than a mood, as the colony's other moments are. -->

  <!-- The Republic's radio (RepublicRadio): heard on the colony's console or the Line's mast, by everyone at home. -->
  <ThoughtDef>
    <defName>Rimfolk_Thought_RadioPraised</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>praised on the Republic's radio</label><description>The Last Republic's evening broadcast spoke of us by name, as good neighbours and good citizens. Somebody turned it up so everyone could hear.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Pride</li></feelings><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Rimfolk_Thought_RadioDenounced</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>denounced on the Republic's radio</label><description>The Last Republic's evening broadcast spoke of us by name, as a disorderly people who owe the Republic and pay it nothing. The whole region heard it.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Anger</li></feelings><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <!-- The conscript home again (Conscripts.Back). -->
  <ThoughtDef>
    <defName>Rimfolk_Mission_ServedRepublic</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a season in the Civic Guard</label><description>A whole season in the Republic's uniform, on its walls and its streets, and home again with the pay in my pack. It was hard, and I would not have missed it.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Pride</li></feelings><felt>4</felt></li></modExtensions>
  </ThoughtDef>

  <!-- The Republic's count (Defs/MissionDefs/Rimfolk_Missions_PeoplesF.xml): for the witness who went. -->
  <ThoughtDef>
    <defName>Rimfolk_Mission_WitnessedCount</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a witness at the count</label><description>A day at the Republic's town hall watching every ballot counted twice, as the law says. They wrote our name in the record as the witness.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Pride</li></feelings><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <!-- The union's short shift (Defs/MissionDefs/Rimfolk_Missions_PeoplesF.xml): for the miners who went. -->
  <ThoughtDef>
    <defName>Rimfolk_Mission_ShiftWithUnion</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a shift with the union</label><description>A day and a half underground with the Deepwell Union, and everyone up at the end of the shift. They wrote us in their book as if we were members.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.06</joy><felt>3</felt><feelings><li>Fellowship</li></feelings></li></modExtensions>
  </ThoughtDef>

  <!-- The strike settled at the gate with the colony's help (DilemmaEffect_UnionSettle): for whoever did it. -->
  <ThoughtDef>
    <defName>Rimfolk_Evt_StrikeSettled</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the strike settled</label><description>The Deepwell Union's strike is over, and we helped end it. The shift-captain shook hands on it at our gate.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Relief</li></feelings><felt>3</felt></li></modExtensions>
  </ThoughtDef>

</Defs>
