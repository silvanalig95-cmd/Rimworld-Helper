<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Moods from moments between colonists (Defs/InteractionDefs/Council_Moments.xml). Small and short. -->

  <ThoughtDef>
    <defName>Council_Moment_NotAlone</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>grieved together</label><description>We sat with it together. It didn't fix anything. It helped anyway.</description><baseMoodEffect>3</baseMoodEffect><baseOpinionOffset>8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Moment_WonContest</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>won a friendly contest</label><description>Fair and square. Mostly fair. Square enough.</description><baseMoodEffect>3</baseMoodEffect><baseOpinionOffset>3</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Moment_LostContest</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>lost a friendly contest</label><description>Next time. There will be a next time.</description><baseMoodEffect>1</baseMoodEffect><baseOpinionOffset>2</baseOpinionOffset></li></stages>
  </ThoughtDef>

</Defs>
