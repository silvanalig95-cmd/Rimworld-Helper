    <durationDays>1</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>shared my good news</label><description>I told them my wish had come true, and they were nearly as pleased as I was.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>3</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Moment_HappyForThem</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>happy for them</label><description>Their wish came true, and they couldn't stop grinning. It's catching.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>3</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

