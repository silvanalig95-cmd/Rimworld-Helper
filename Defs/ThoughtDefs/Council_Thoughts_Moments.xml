    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>talked about food</label><description>We talked about our favorite meals. Now I'm hungry again.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>2</baseOpinionOffset></li></stages>
