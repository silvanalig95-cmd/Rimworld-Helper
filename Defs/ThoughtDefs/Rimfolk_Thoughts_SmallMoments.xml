<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Small letdowns and small joys (Source/ColonyCouncil/Moods/SmallMoments.cs, phase 3 of the review, November 2026).
    Rimfolk's small letdowns (pressures, setbacks, quiet troubles, nuisances, frictions) and its small good moments are
    each felt for a moment, half a day and three points at most, in one row of the Mood tab per side; the row's tooltip
    says what each one was. What they would weigh beyond the moment goes to the heart (strain or relief). Each moment
    carries its own size and time (Thought_SmallMoment), so the row adds them up as they are: the stack counts in full.
  -->

  <ThoughtDef>
    <defName>Rimfolk_SmallLetdowns</defName>
    <thoughtClass>ColonyCouncil.Thought_SmallMoment</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>40</stackLimit>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
    <stages>
      <li>
        <label>small letdowns</label>
        <description>A few small things went wrong lately.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Rimfolk_SmallJoys</defName>
    <thoughtClass>ColonyCouncil.Thought_SmallMoment</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>40</stackLimit>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
    <stages>
      <li>
        <label>small joys</label>
        <description>A few small good things lately.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
