<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Dream memories. Thought_Dream carries the dream itself into the tooltip. One dream memory at a time. -->

  <ThoughtDef Name="Council_DreamBase" Abstract="True">
    <thoughtClass>ColonyCouncil.Thought_Dream</thoughtClass>
    <durationDays>0.6</durationDays>
    <stackLimit>1</stackLimit>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_DreamBase">
    <defName>Council_Dream_Sweet</defName>
    <stages><li><label>a sweet dream</label><description>I woke up smiling. I'd like to go back.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_DreamBase">
    <defName>Council_Dream_Strange</defName>
    <durationDays>0.4</durationDays>
    <stages><li><label>a strange dream</label><description>A strange dream. I keep turning it over.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_DreamBase">
    <defName>Council_Dream_Nightmare</defName>
    <stages><li><label>nightmare</label><description>I woke up with my heart pounding. It's still with me.</description><baseMoodEffect>-4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_DreamBase">
    <defName>Council_Dream_Omen</defName>
    <durationDays>1</durationDays>
    <stages><li><label>a vivid dream</label><description>It didn't feel like a dream. It felt like a warning, or a promise.</description><baseMoodEffect>-1</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_DreamBase">
    <defName>Council_Dream_Lost</defName>
    <durationDays>1</durationDays>
    <stages><li><label>visited in a dream</label><description>Someone I lost came back for a night. Waking up was the hard part.</description><baseMoodEffect>2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_DreamBase">
    <defName>Council_Dream_Fever</defName>
    <stages><li><label>fever dream</label><description>Everything melted and spoke at once. I'm still not sure what was real.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_DreamBase">
    <defName>Council_Dream_Inspiring</defName>
    <durationDays>1</durationDays>
    <stages><li><label>an inspiring dream</label><description>I woke up with an idea fully formed. I have to try it.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Dream_CameTrue</defName>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my dream came true</label><description>I saw it before it happened. What else will I see?</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Dream_DreamtOfMe</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>dreamt about me</label><description>They told me they dreamt about me. It was a good dream, apparently. That's nice to hear.</description><baseMoodEffect>1</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>

</Defs>
