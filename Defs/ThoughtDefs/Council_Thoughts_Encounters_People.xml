<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Thoughts from encounters with people who aren't colonists (Council_Encounters_People.xml).
    Memories are A's (first person). Socials given to A are about the stranger (X); socials given to X are about A,
    and are written from X's side. Socials given to Others (onlookers) are about A.
  -->

  <!-- ===================== Visitors ===================== -->

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_RoadNews</defName>
    <durationDays>2</durationDays>
    <stages><li><label>news from the road</label><description>A visitor went through all the news from the road with me, settlement by settlement. Most of it was bad, and I wanted every word.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_BladeTales</defName>
    <durationDays>3</durationDays>
    <stages><li><label>tales of a famous blade</label><description>A visitor told me about a famous swordfighter down south. I went out to the yard after dark to try the footwork.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_RecipeSwap</defName>
    <durationDays>4</durationDays>
    <stages><li><label>swapped recipes</label><description>A traveler and I traded recipes. I'm trying one of theirs in tonight's stew.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_WorkAdmired</defName>
    <durationDays>5</durationDays>
    <stages><li><label>a stranger admired my work</label><description>A traveler who's seen a hundred settlements stopped to admire my work.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_ArtMoved</defName>
    <durationDays>5</durationDays>
    <stages><li><label>my work moved a stranger</label><description>A stranger stood in front of my work for a long time without saying a word.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_PlayFriend</defName>
    <durationDays>3</durationDays>
    <stages><li><label>a friend from the road</label><description>I made a friend from the caravan. We have a secret password, and we gave a frog a funeral.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_FireSongs</defName>
    <durationDays>2</durationDays>
    <stages><li><label>songs from a traveler</label><description>A traveler had songs and stories I'd never heard. I've got one of the choruses already.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.1</joy><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_Flirted</defName>
    <durationDays>3</durationDays>
    <stages><li><label>flirted with a visitor</label><description>A visitor laughed at all my jokes, even the old ones, and sat closer than they needed to.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_Recognized</defName>
    <durationDays>5</durationDays>
    <stages><li><label>they've heard of me</label><description>A stranger knew my name before I said it. People out on the road tell stories about me.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_StrangersThanks</defName>
    <durationDays>4</durationDays>
    <stages><li><label>a stranger's thanks</label><description>I did a traveler a small favor, and they pressed silver and herbs into my hand and wouldn't take them back.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_StrangeDog</defName>
    <durationDays>2</durationDays>
    <stages><li><label>a stranger's dog</label><description>A visitor's dog leaned against my legs all afternoon and ate half my sausage.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.06</joy><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_DiceNight</defName>
    <durationDays>2</durationDays>
    <stages><li><label>dice with a stranger</label><description>Dice with a traveler all evening, for pebbles. We argued over every throw.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.1</joy><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_Insufferable</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>insufferable outsider</label><description>They walked up to our gate and told us how to live.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-12</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_FellowFighter</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>a fellow fighter</label><description>We've both stood in a battle line and lost friends. We were up half the night comparing scars.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>12</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_Stared</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>stared at me all day</label><description>They stared at me everywhere I went, and never said what they wanted.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-6</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- How the stranger feels about A afterward (given to X). -->

  <ThoughtDef>
    <defName>Council_EncP_GoodCompany</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>good company</label><description>Good company on a long road. I'll stop in again if I'm passing.</description><baseOpinionOffset>10</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_Smitten</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>flirted with me</label><description>They told terrible jokes, but they had a nice laugh. I'll think about them on the road.</description><baseOpinionOffset>15</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_RudeHost</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>rude host</label><description>They insulted me at their own gate. I'll remember them.</description><baseOpinionOffset>-15</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_KindToMe</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>kind to me when I needed it</label><description>They didn't have to be kind to me. They were anyway.</description><baseOpinionOffset>18</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Traders ===================== -->

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_OutHaggled</defName>
    <durationDays>4</durationDays>
    <stages><li><label>out-haggled a trader</label><description>I talked a professional trader down to almost nothing. They called me a bandit, and I've never been prouder.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_HardBargain</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>drove a hard bargain</label><description>They robbed me blind with a straight face. I respect that.</description><baseOpinionOffset>6</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_HaggledBadly</defName>
    <durationDays>3</durationDays>
    <stages><li><label>haggled badly</label><description>I thought I'd driven a hard bargain, until I saw what the others paid.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_Wanderlust</defName>
    <durationDays>5</durationDays>
    <stages><li><label>wanderlust</label><description>The trader talked about a warm sea and a city with a thousand chimneys. I keep looking at the road.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_Cheated</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>cheated me</label><description>They sold me rubbish with a smile. From now on I check the goods myself.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-20</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_WorkTraveled</defName>
    <durationDays>7</durationDays>
    <stages><li><label>my work is known on the road</label><description>A trader recognized something I made. My work has been places I've never seen, and people pay good silver for it.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_CaravanGossip</defName>
    <durationDays>2</durationDays>
    <stages><li><label>caravan gossip</label><description>The trader told me who's gone broke out there, and which settlements still pay fair.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>1</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_FreeSample</defName>
    <durationDays>2</durationDays>
    <stages><li><label>a free taste</label><description>The trader gave me a taste of their goods from very far south. I spent supper trying to describe it.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.06</joy><joyKind>Gluttonous</joyKind><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_FreeSampleGourmand</defName>
    <durationDays>4</durationDays>
    <stages><li><label>a taste of somewhere else</label><description>The trader let me taste a delicacy from three weeks south. Everything we cook tastes of nothing next to it.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- ===================== Lodgers ===================== -->

  <ThoughtDef>
    <defName>Council_EncP_TreatedLikeFurniture</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>treats me like furniture</label><description>They snap their fingers at me and send the soup back, and they've never once used my name.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>-10</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_NobleNotice</defName>
    <durationDays>5</durationDays>
    <stages><li><label>noticed by a noble</label><description>A noble showed me how to bow properly and said I'd do well at court. I've been practicing behind the barn.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_RefugeeThanks</defName>
    <durationDays>6</durationDays>
    <stages><li><label>a guest's thanks</label><description>I gave a frightened guest a bowl of stew and a blanket, and they thanked me like I'd saved their life.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_GuestPitchedIn</defName>
    <durationDays>2</durationDays>
    <stages><li><label>the guest pitched in</label><description>Our guest got tired of sitting around and picked up an axe to help.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_HuntedGuest</defName>
    <durationDays>3</durationDays>
    <stages><li><label>a hunted guest</label><description>We're sheltering a guest with killers on their trail. I jump at every noise at night.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_KeptWatch</defName>
    <durationDays>3</durationDays>
    <stages><li><label>kept watch for a guest</label><description>Our guest was too scared to sleep, so I sat up with them, facing the door.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Tenderness</li></feelings><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <!-- ===================== Prisoners ===================== -->

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_KindWords</defName>
    <durationDays>3</durationDays>
    <stages><li><label>kind words through a door</label><description>I talked to a prisoner like a person today. They talked back like one.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_Taunted</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>taunted me through the door</label><description>They're locked up, and they still got under my skin. I checked the cell walls twice.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-10</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_PrisonerStory</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>their story stays with me</label><description>They told me how they ended up raiding. I understand it better than I'd like.</description><baseMoodEffect>-1</baseMoodEffect><baseOpinionOffset>10</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_SamePast</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>came from the same place</label><description>We grew up in the same kind of place, eating the same bread and singing the same songs.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>15</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_NemesisFaced</defName>
    <durationDays>3</durationDays>
    <stages><li><label>face to face with them</label><description>I stood at the cell door and looked at the one who hurt me. They're the one locked in, but I could hardly breathe.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_NemesisStaredDown</defName>
    <durationDays>4</durationDays>
    <stages><li><label>stared them down</label><description>They looked up from the cell floor, saw it was me, and looked away first. I've been waiting a long time for that.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_FoodInsulted</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>insulted my cooking</label><description>They ate every crumb I brought to their cell, then called it slop.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_BuriedStash</defName>
    <durationDays>3</durationDays>
    <stages><li><label>a buried stash, supposedly</label><description>A prisoner told me where a chest of silver is buried. It's probably a lie. I've drawn the map out twice from memory.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><journal>true</journal><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_BribeOffered</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>tried to bribe me</label><description>They offered me a fortune for the key to their cell. As if I'd fall for that.</description><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== The fallen ===================== -->

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_Begged</defName>
    <durationDays>3</durationDays>
    <stages><li><label>an enemy begged me</label><description>A downed raider begged me not to leave them out there, and kept begging while I walked away.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_Cursed</defName>
    <durationDays>2</durationDays>
    <stages><li><label>cursed from the dirt</label><description>A raider who couldn't even stand spent their breath cursing me, my mother and my colony.</description><baseMoodEffect>-1</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_GaveWater</defName>
    <durationDays>3</durationDays>
    <stages><li><label>gave water to an enemy</label><description>A wounded raider asked for water, and I held the cup while they drank. We didn't talk about the fight.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_EnemyPrayer</defName>
    <durationDays>2</durationDays>
    <stages><li><label>an enemy's prayer</label><description>A fallen raider prayed in the mud to a god I don't know. I've learned the words without meaning to.</description><baseMoodEffect>-1</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_LastWords</defName>
    <durationDays>6</durationDays>
    <stages><li><label>a name to carry</label><description>A raider who thought they were dying gave me a name and a message. I don't know who to take it to.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_SpatOnRaider</defName>
    <durationDays>3</durationDays>
    <stages><li><label>spat on a raider</label><description>They came over our wall to kill us. I spat on them where they lay.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_CruelToFallen</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>12</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>spat on a helpless enemy</label><description>They spat on a raider who was down and bleeding, and walked off whistling.</description><baseOpinionOffset>-8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EncP_Spat</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
    <stages><li><label>spat on me when I was down</label><description>I was on the ground, bleeding, and they spat on me. I won't forget it.</description><baseOpinionOffset>-25</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncP_FarewellPostponed</defName>
    <durationDays>2</durationDays>
    <stages><li><label>a farewell, postponed</label><description>A raider gave me a whole deathbed speech over a sprained ankle. I laughed about it all evening.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.05</joy><felt>1</felt></li></modExtensions>
  </ThoughtDef>

</Defs>
