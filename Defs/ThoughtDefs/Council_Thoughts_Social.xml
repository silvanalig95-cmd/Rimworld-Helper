<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Opinion from the social web. The kind comes from the defName suffix; stages are new / solid / deep bonds. -->

  <ThoughtDef>
    <defName>Council_Tie_Friends</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ColonyCouncil.ThoughtWorker_SocialTie</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>new friends</label><baseOpinionOffset>5</baseOpinionOffset></li>
      <li><label>good friends</label><baseOpinionOffset>10</baseOpinionOffset></li>
      <li><label>close friends</label><baseOpinionOffset>18</baseOpinionOffset></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Tie_Rivals</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ColonyCouncil.ThoughtWorker_SocialTie</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>rivalry</label><baseOpinionOffset>-5</baseOpinionOffset></li>
      <li><label>bitter rivalry</label><baseOpinionOffset>-10</baseOpinionOffset></li>
      <li><label>sworn rivals</label><baseOpinionOffset>-18</baseOpinionOffset></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Tie_Comrades</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ColonyCouncil.ThoughtWorker_SocialTie</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>fought together</label><baseOpinionOffset>4</baseOpinionOffset></li>
      <li><label>comrades in arms</label><baseOpinionOffset>8</baseOpinionOffset></li>
      <li><label>bound by battle</label><baseOpinionOffset>14</baseOpinionOffset></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Tie_Mentor</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ColonyCouncil.ThoughtWorker_SocialTie</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>lessons together</label><baseOpinionOffset>4</baseOpinionOffset></li>
      <li><label>teacher and student</label><baseOpinionOffset>8</baseOpinionOffset></li>
      <li><label>devoted teacher and student</label><baseOpinionOffset>12</baseOpinionOffset></li>
    </stages>
  </ThoughtDef>

  <!-- Graduation -->

  <ThoughtDef>
    <defName>Council_ProudMentor</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>my student is ready</label><description>Everything I know, they know now, and some of it better than me. I watched them work today and had nothing to correct.</description><baseMoodEffect>5</baseMoodEffect><baseOpinionOffset>15</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_GratefulStudent</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>they taught me</label><description>I didn't know how to do any of this a season ago. They took the time, every day, even when I was slow.</description><baseMoodEffect>4</baseMoodEffect><baseOpinionOffset>20</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- Social events -->

  <ThoughtDef>
    <defName>Council_Soc_GoodTalk</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>a good talk</label><description>We got talking and lost all track of the time. I'd forgotten what that's like.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>6</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Laughed</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>laughed together</label><description>We laughed until our sides hurt, over something I can't even remember now.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><joy>0.1</joy><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Pranked</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>pranked</label><description>They pulled a prank on me. Very funny. I'll remember it.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-6</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Snubbed</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>snubbed</label><description>They looked straight through me, with the others watching.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-10</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Squabble</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>squabbled</label><description>A stupid argument about nothing. I'm still right, though.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_HadMyBack</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>had my back</label><description>When it mattered, they stood with me, and didn't have to be asked.</description><baseMoodEffect>3</baseMoodEffect><baseOpinionOffset>12</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Gift</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>a little gift</label><description>They made me something with their own hands. I've put it where I'll see it every morning.</description><baseMoodEffect>3</baseMoodEffect><baseOpinionOffset>8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Gossiped</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>gossiped about me</label><description>I heard what they've been saying about me behind my back.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-12</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Lesson</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>a good lesson</label><description>It finally clicked today. All that patience paid off.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Outdone</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>outdone by my rival</label><description>My rival beat me, and made sure I saw it. I'll get them next time.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Won</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>beat my rival</label><description>I beat my rival, and they know it.</description><baseMoodEffect>4</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Remembered</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>remembered the fallen together</label><description>We talked about the ones we lost, late into the night.</description><baseMoodEffect>2</baseMoodEffect><baseOpinionOffset>8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_LeftOut</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stages><li><label>left out</label><description>The others all went off together, and I wasn't asked along.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
