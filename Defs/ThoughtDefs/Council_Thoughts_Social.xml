<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Opinion from the social web. The kind comes from the defName suffix; stages are new / solid / deep bonds. -->

  <ThoughtDef>
    <defName>Council_Tie_Friends</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ColonyCouncil.ThoughtWorker_SocialTie</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>new friends</label><baseOpinionOffset>5</baseOpinionOffset></li>
      <li><label>good friends</label><baseOpinionOffset>10</baseOpinionOffset></li>
      <li><label>close friends</label><baseOpinionOffset>18</baseOpinionOffset></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Tie_Rivals</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ColonyCouncil.ThoughtWorker_SocialTie</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>rivalry</label><baseOpinionOffset>-5</baseOpinionOffset></li>
      <li><label>bitter rivalry</label><baseOpinionOffset>-10</baseOpinionOffset></li>
      <li><label>sworn rivals</label><baseOpinionOffset>-18</baseOpinionOffset></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Tie_Comrades</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ColonyCouncil.ThoughtWorker_SocialTie</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>fought together</label><baseOpinionOffset>4</baseOpinionOffset></li>
      <li><label>comrades in arms</label><baseOpinionOffset>8</baseOpinionOffset></li>
      <li><label>bound by battle</label><baseOpinionOffset>14</baseOpinionOffset></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Tie_Mentor</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>ColonyCouncil.ThoughtWorker_SocialTie</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>lessons together</label><baseOpinionOffset>4</baseOpinionOffset></li>
      <li><label>teacher and student</label><baseOpinionOffset>8</baseOpinionOffset></li>
      <li><label>devoted teacher and student</label><baseOpinionOffset>12</baseOpinionOffset></li>
    </stages>
  </ThoughtDef>

  <!-- Graduation -->

  <ThoughtDef>
    <defName>Council_ProudMentor</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>my student is ready</label><description>Everything I knew, they know now. Some of it better than me. That's the point.</description><baseMoodEffect>6</baseMoodEffect><baseOpinionOffset>15</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_GratefulStudent</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>they taught me</label><description>I didn't know how to do any of this a season ago. They took the time. I won't forget it.</description><baseMoodEffect>5</baseMoodEffect><baseOpinionOffset>20</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- Social events -->

  <ThoughtDef>
    <defName>Council_Soc_GoodTalk</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>a good talk</label><description>We talked half the night. I'd forgotten what that feels like.</description><baseMoodEffect>3</baseMoodEffect><baseOpinionOffset>6</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Laughed</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>laughed together</label><description>We laughed until it hurt. Out here, that counts for something.</description><baseMoodEffect>3</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Pranked</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>pranked</label><description>Very funny. Very, very funny. I'll remember this.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-6</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Snubbed</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>snubbed</label><description>They looked straight through me. In front of everyone.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-10</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Squabble</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>2</stackLimitForSameOtherPawn>
    <stages><li><label>squabbled</label><description>A stupid argument about nothing. I'm still right, though.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_HadMyBack</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>had my back</label><description>When it mattered, they stood with me. I won't forget it.</description><baseMoodEffect>4</baseMoodEffect><baseOpinionOffset>12</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Gift</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>a little gift</label><description>They made me something. Small, and a bit crooked, and I love it.</description><baseMoodEffect>4</baseMoodEffect><baseOpinionOffset>8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Gossiped</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>gossiped about me</label><description>I heard what they've been saying about me. Everyone heard.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-12</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Lesson</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>a good lesson</label><description>It finally clicked today. All that patience paid off.</description><baseMoodEffect>2</baseMoodEffect><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Outdone</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>outdone by my rival</label><description>They beat me. Of all people, them. Next time.</description><baseMoodEffect>-3</baseMoodEffect><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Won</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>beat my rival</label><description>I won. They know it, I know it, everyone knows it.</description><baseMoodEffect>4</baseMoodEffect><baseOpinionOffset>-2</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_Remembered</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>remembered the fallen together</label><description>We talked about the ones we lost. It hurt, and then it helped.</description><baseMoodEffect>2</baseMoodEffect><baseOpinionOffset>8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Soc_LeftOut</defName>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stages><li><label>left out</label><description>They all had somewhere to be together. Nobody asked me.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
