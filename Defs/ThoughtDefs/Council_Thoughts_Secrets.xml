<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Secrets -->

  <ThoughtDef>
    <defName>Council_Secret_Unburdened</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>unburdened</label><description>I finally told someone my secret. I'd carried it alone for so long.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Secret_Trusted</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>trusted me with a secret</label><description>They told me something they've never told anyone. I won't let them down.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>10</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Secret_Exposed</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my secret is out</label><description>My secret is out, and they all know. I can feel them looking at me.</description><baseMoodEffect>-7</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Secret_Confessed</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>confessed</label><description>I confessed it out loud, with the others listening. It was awful, but at least it's over.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Secret_Betrayed</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>30</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>betrayed my secret</label><description>I trusted them with the one thing I couldn't say, and they said it.</description><baseMoodEffect>-6</baseMoodEffect><baseOpinionOffset>-30</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Secret_Embarrassed</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>embarrassed</label><description>My embarrassing secret is out. They're being nice about it, and that's worse.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Secret_Seen</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>finally seen</label><description>They found out what I've been doing for them, and they're grateful. I didn't do it for thanks, but it's nice.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- How others take it (social, about the owner) -->

  <ThoughtDef Name="Council_SecretReactionBase" Abstract="True">
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Distrust</defName>
    <stages><li><label>learned what they were</label><description>I know what they did before they came here. I can't unknow it.</description><baseOpinionOffset>-12</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Disgust</defName>
    <durationDays>30</durationDays>
    <stages><li><label>appalled by their past</label><description>I eat at the same table as someone who did that.</description><baseMoodEffect>-2</baseMoodEffect><baseOpinionOffset>-22</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Forgave</defName>
    <stages><li><label>forgave their past</label><description>Whatever they were before, they're one of us now.</description><baseOpinionOffset>6</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Respect</defName>
    <stages><li><label>respect their past</label><description>They're tougher than they look. I respect that.</description><baseOpinionOffset>8</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Sympathy</defName>
    <stages><li><label>sympathy</label><description>All this time they've been carrying that, and never said a word.</description><baseOpinionOffset>10</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Contempt</defName>
    <stages><li><label>contempt</label><description>Now I know what they're really like, and I'm not impressed.</description><baseOpinionOffset>-15</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Grateful</defName>
    <stages><li><label>grateful for what they did</label><description>All this time it was them. I had no idea.</description><baseMoodEffect>0</baseMoodEffect><baseOpinionOffset>14</baseOpinionOffset></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Amused</defName>
    <durationDays>8</durationDays>
    <stages><li><label>amused by their secret</label><description>That's what they were hiding? I like them more for it.</description><baseOpinionOffset>5</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Mocking</defName>
    <durationDays>8</durationDays>
    <stages><li><label>laughing at their secret</label><description>I'm going to bring this up at every meal for a year.</description><baseOpinionOffset>-6</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_SecretReactionBase">
    <defName>Council_Secret_Wary</defName>
    <stages><li><label>wary of them now</label><description>If they kept that from us, what else are they keeping?</description><baseOpinionOffset>-7</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- Vendettas -->

  <ThoughtDef>
    <defName>Council_Vendetta_Debt</defName>
    <workerClass>ColonyCouncil.ThoughtWorker_Vendetta</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages><li><label>a debt of blood</label><description>The ones who did it are still out there. I haven't forgotten. I won't.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Vendetta_Blood</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>part of the debt paid</label><description>Some of them paid for it today. Not all of them, not yet.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Vendetta_Avenged</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>avenged</label><description>It's done. They paid for what they took, and now our dead can rest.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Vendetta_Betrayed</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>peace with the killers</label><description>The council made peace with the people who killed one of ours. As if it never happened.</description><baseMoodEffect>-8</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- Eulogies -->

  <ThoughtDef>
    <defName>Council_GaveEulogy</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>said goodbye</label><description>I spoke at the grave. I don't know if I got the words right, but I said them.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_EulogyHeard</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a fitting goodbye</label><description>The words spoken at the grave were the right ones.</description><baseMoodEffect>2</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
