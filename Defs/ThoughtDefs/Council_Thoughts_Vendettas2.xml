<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- More ways for a vendetta to end (Source/ColonyCouncil/Secrets/Vendettas.cs): laid down, or the one taken came home. -->

  <ThoughtDef>
    <defName>Council_Vendetta_LetGo</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>laid it down</label><description>I've stopped keeping the tally of what they owe us. The one we lost is still gone, and I'm sleeping again.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Vendetta_Home</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>they came home</label><description>The one they took is back at our table. I keep finding excuses to sit next to them at meals.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
