<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    PokéWorld (Source/ColonyCouncil/Integrations/PokeWorld.cs). These always load, so a saved memory still finds its
    def if the mod is removed later; without the mod nobody gets them.
  -->

  <!-- Caught a species the colony never had. Not given on top of the wish's own thanks below. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PW_CaughtNewSpecies</defName>
    <durationDays>3</durationDays>
    <stages>
      <li>
        <label>caught a new species</label>
        <description>I caught a kind of Pokémon the colony has never had, and walked it home myself.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Granted: the wish to catch a new species (Wishes_Mods_PokeWorld.xml). -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_PW_NewSpecies</defName>
    <durationDays>5</durationDays>
    <stages>
      <li>
        <label>a new species for the colony</label>
        <description>There's a kind of creature in the colony now that we never had before. I've been watching what it likes to eat.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ===================== The colony's Pokémon growing up (Integrations/PokeWorldLife.cs) ===================== -->

  <!-- Their Pokémon evolved: practice and pride, not mood. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PW_Evolved</defName>
    <durationDays>4</durationDays>
    <stages><li><label>my Pokémon evolved</label><description>It glowed, and changed, and when the light went it was bigger and new and still knew my voice.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>3</felt><skill>Animals</skill><xp>300</xp><feelings><li>Pride</li><li>Joy</li></feelings></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PW_LevelMilestone</defName>
    <durationDays>3</durationDays>
    <stages><li><label>my Pokémon grew stronger</label><description>All those fights, all that training, and you can see it now in the way it moves.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt><skill>Animals</skill><xp>200</xp><feelings><li>Pride</li></feelings></li></modExtensions>
  </ThoughtDef>

  <!-- Fainted in a fight: a short worry, until it's over. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PW_Fainted</defName>
    <durationDays>1</durationDays>
    <stages><li><label>my Pokémon fainted</label><description>It went down in the fight and I couldn't get to it. I need to know it's all right.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.HeartTags"><feelings><li>Worry</li></feelings><weight>0.4</weight></li></modExtensions>
  </ThoughtDef>

  <!-- Granted: a Pokémon of one's own (Wishes_Mods_PokeWorld.xml). -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_PW_OwnPokemon</defName>
    <durationDays>6</durationDays>
    <stages><li><label>a Pokémon of my own</label><description>It's mine to train now. I've already worked out three things it's good at.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- Granted: a supply of ball belts. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_PW_BallSupply</defName>
    <durationDays>4</durationDays>
    <stages><li><label>belts on the rack</label><description>There are ball belts on the rack now, enough to go after something without counting every throw.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt><trust>1</trust><feelings><li>Hope</li></feelings></li></modExtensions>
  </ThoughtDef>

  <!-- A rare Pokémon seen on the colony's land (Rimfolk_Events_PokeWorld.xml). -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PW_SawRareOne</defName>
    <durationDays>3</durationDays>
    <stages><li><label>saw a rare one</label><description>I lay flat in the grass and watched it until it moved on. Most trainers never see one in their lives.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt><joy>0.08</joy><feelings><li>Awe</li></feelings></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PW_RareOneMissed</defName>
    <durationDays>2</durationDays>
    <stages><li><label>let a rare one pass</label><description>A rare Pokémon walked across our land and the council told us to let it be. I watched it go over the hill.</description><baseMoodEffect>-1</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- A friendly spar between two trainers' Pokémon (Rimfolk_Moments_Animals.xml): nobody is hurt. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PW_SparWon</defName>
    <durationDays>2</durationDays>
    <stages><li><label>won a friendly spar</label><description>Our Pokémon sparred in the yard, nobody hurt, and mine came out on top. I'll be insufferable about it until supper.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><joy>0.06</joy><skill>Animals</skill><xp>100</xp></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_PW_SparLost</defName>
    <durationDays>2</durationDays>
    <stages><li><label>lost a friendly spar</label><description>Mine lost the spar. I saw exactly where it went wrong, and we'll practice that tomorrow.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><skill>Animals</skill><xp>160</xp></li></modExtensions>
  </ThoughtDef>

  <!-- The personal story of a trainer and their partner (Rimfolk_Arcs_Animals.xml): partners at last. -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Arc_PokemonPartners</defName>
    <durationDays>6</durationDays>
    <stages><li><label>partners</label><description>It turns to look at me before it does anything now. We're a team, the two of us.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>3</felt><skill>Animals</skill><xp>300</xp><feelings><li>Pride</li><li>Tenderness</li></feelings></li></modExtensions>
  </ThoughtDef>

  <!-- Encounters with wild Pokémon (Rimfolk_Encounters_PokeWorld.xml). -->
  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncPW_Curious</defName>
    <durationDays>1</durationDays>
    <stages><li><label>watched by a wild one</label><description>A wild Pokémon sat and watched me work for half the afternoon, as if I were the strange creature.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>1</felt><feelings><li>Curiosity</li></feelings></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_EncPW_SmallFriend</defName>
    <durationDays>2</durationDays>
    <stages><li><label>a small wild friend</label><description>A wild Pokémon came to play with me at the fence. It's not mine, but it's my friend.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt><joy>0.08</joy><feelings><li>Joy</li></feelings></li></modExtensions>
  </ThoughtDef>

</Defs>
