<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Faith and the council (Source/ColonyCouncil/Faith/FaithEvenings.cs, Wishes/WishWorkers_Faith.cs). A good evening of
    faith gives those who came recreation and a feeling of fellowship rather than mood (RewardInstead); only a fine one
    is a small good mood, through the shared good-mood budget. The wish to learn another faith, granted, is a wish's
    usual small lift. Nothing here is a bad mood: the costs of faith are trust and certainty.
  -->

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Faith_GoodEvening</defName>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>an ideoligion evening</label><description>An evening of someone's faith, spoken out loud for anyone who'd come. I sat with the others and listened.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><felt>2</felt><joy>0.12</joy><feelings><li>Fellowship</li></feelings></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Faith_FineEvening</defName>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a fine ideoligion evening</label><description>The words were good last night, and the company better. I'm still turning some of it over.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.HeartTags"><feelings><li>Fellowship</li><li>Awe</li></feelings><weight>0.4</weight></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef ParentName="Council_MemoryBase">
    <defName>Council_Granted_LearnFaith</defName>
    <durationDays>3</durationDays>
    <stages><li><label>heard another ideoligion out</label><description>I spent an evening hearing another ideoligion out, with every question answered. I lay awake afterward going over it.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.HeartTags"><feelings><li>Curiosity</li></feelings><weight>0.4</weight></li></modExtensions>
  </ThoughtDef>

</Defs>
