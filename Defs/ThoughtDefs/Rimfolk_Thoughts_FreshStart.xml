<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    A fresh start in the same world (Source/ColonyCouncil/Colonies/Foundings.cs; the player's decision 2A of 6 November
    2026): those sent or kept against their wish feel uprooted for a season, close bonds split between two colonies feel
    parted for a season, and the founders' first night at the new hearth.
  -->

  <ThoughtDef>
    <defName>Rimfolk_Uprooted</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>uprooted</label>
        <description>I didn't choose this. My place was somewhere else, and nobody asked me twice.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Rimfolk_Parted</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>parted from someone close</label>
        <description>We live in two places now. I keep turning to say something to them, and they aren't there.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Rimfolk_FirstNight</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>first night at the new hearth</label>
        <description>Our first night here, all of us in one place. Whatever comes, we started it together.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
