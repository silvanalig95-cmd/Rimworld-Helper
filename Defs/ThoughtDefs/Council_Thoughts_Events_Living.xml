<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Moods from the fourth batch of world events (Defs/IncidentDefs/Council_Events_Living*.xml). -->

  <!-- ===================== Family ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_FamilyMadePeace</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>made peace with family</label><description>My family came looking for us, and we talked behind a shut door all day without raising our voices. They went home with a letter from me.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FamilyQuarrel</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a row with family</label><description>My family came all this way, and it ended in the same argument we had the night I left.</description><baseMoodEffect>-4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FamilyGift</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a gift sent home</label><description>The colony sent a gift home to my family. I wrote a line to go with it, and crossed most of it out.</description><baseMoodEffect>2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_LetterFromHome</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a letter from home</label><description>A letter came from home, full of small news about people I haven't seen in years. I could hear their voices in it.</description><baseMoodEffect>4</baseMoodEffect><baseOpinionOffset>6</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_KinMovedIn</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages><li><label>family came to stay</label><description>Family of mine came all this way to live here. I keep looking in on them to make sure they're settling in.</description><baseMoodEffect>8</baseMoodEffect><baseOpinionOffset>15</baseOpinionOffset></li></stages>
  </ThoughtDef>

  <!-- ===================== Fortune, name and vengeance ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_FortuneSpent</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the bad fortune came and went</label><description>The fortune teller saw something bad coming for me. It came, it missed, and I'm done worrying about it.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_SettlementHeld</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my settlement held</label><description>The split I worked out between our neighbors has held all season. Both of them sent their thanks.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_SoughtOut</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>sought out for my skill</label><description>Someone walked a long way to ask for my help, and knew me by name before they got here.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_VendettaChance</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a chance at vengeance</label><description>They're coming to us now, on our ground. I'll be ready.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_VendettaPassed</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>let them pass</label><description>The people I swore vengeance on were camped a few hours away, and we let them go. I watched their smoke until it was gone.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_KindredSpirit</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>met a kindred spirit</label><description>I met someone who did the very thing I'm trying to do. So it can be done.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <!-- ===================== The colony's days ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_FoundingFeast</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>founding day feast</label><description>We feasted for the colony's founding day and told the old stories again, the first night and the first winter.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FoundingDay</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>founding day</label><description>Another year since the colony was founded. We raised a cup to it.</description><baseMoodEffect>2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FairPrize</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>won a prize at the fair</label><description>My crop took the prize at the harvest fair, over growers from all around.</description><baseMoodEffect>6</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_MidwinterGuest</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>a guest on a winter night</label><description>A traveler came in out of the cold and got a seat by our fire, a hot drink and a blanket for the night.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Fellowship</li></feelings><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_ShutTheGate</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>turned someone away in the cold</label><description>Someone knocked at the gate on a freezing night, and we didn't open it. The knocking went on a long while.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_Thaw</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>the thaw</label><description>The snow is going at last. There's mud everywhere, and I don't mind it at all.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><feelings><li>Relief</li></feelings><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <!-- ===================== With mods ===================== -->

  <ThoughtDef>
    <defName>Council_Evt_Starfall</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>lights fell from the sky</label><description>Pale lights came down near the colony in the night and left magicyte behind. I keep looking up.</description><baseMoodEffect>0</baseMoodEffect></li></stages>
    <modExtensions><li Class="ColonyCouncil.RewardInstead"><inspiration>0.03</inspiration><feelings><li>Awe</li></feelings><felt>3</felt></li></modExtensions>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_FeltStarfall</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>felt it coming</label><description>I felt the mana shift before the lights came down, and woke the others. I was right.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_WonOverCreature</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>won over a strange creature</label><description>A strange creature wandered onto our land, and I sat still by it all afternoon. When I got up to go home, it followed me.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Council_Evt_GuestPraised</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilMemory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>our guest was delighted</label><description>Our guest couldn't stop praising the room we gave them. I saw to that room myself.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>

</Defs>
