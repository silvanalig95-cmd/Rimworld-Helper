<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The peoples' own events, round 8 (Source/ColonyCouncil/Peoples/Events8/): the jobs they are seen doing on the map, and the moods the
       round gives. -->

  <!-- ===================== Their own work at a thing, a person or a place (JobDriver_PEv8Work) ===================== -->

  <JobDef>
    <defName>Rimfolk_PEv8_Roll</defName>
    <driverClass>ColonyCouncil.JobDriver_PEv8Work</driverClass>
    <reportString>checking TargetA against the Republic's roll.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.PEv8Work"><mark>look</mark></li>
    </modExtensions>
  </JobDef>

