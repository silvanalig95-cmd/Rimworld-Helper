<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Nine small habits, each the free-time moment of a quirk (Source/ColonyCouncil/Immersion/QuirkHabits.cs), under the
    same rules as the others in Rimfolk_SmallHabits.xml: only with the "Small habits" setting on, in free time, off
    cooldown, and only for a colonist who has the quirk (with the quirks setting on). Doing it lives the habit, so it
    doesn't fade while they keep at it. Nothing is used up or made; a tidy one wipes up a little of the mess at their
    feet, the game's own way. Looking in on a patient and remembering a birthday leave the other one a small good
    memory (Rimfolk_Thoughts_HabitMoments.xml).
  -->

  <!-- ===================== The jobs ===================== -->

  <!-- One who can't stand a mess: a while by the mess in a room at home, wiping a little of it up. -->
  <JobDef>
    <defName>Council_Habit_Tidy</defName>
    <driverClass>ColonyCouncil.JobDriver_SmallHabit</driverClass>
    <reportString>tidying up.</reportString>
    <joyKind>Meditative</joyKind>
    <joyGainRate>0.6</joyGainRate>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <modExtensions>
      <li Class="ColonyCouncil.HabitExtension">
        <kind>Tidy</kind>
        <pool>Council_Pool_HabitTidy</pool>
        <quirk>Council_Quirk_TidyTable</quirk>
      </li>
    </modExtensions>
  </JobDef>

  <!-- An early riser: out under the open sky at dawn, facing east. -->
  <JobDef>
    <defName>Council_Habit_Sunrise</defName>
