<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Goods and people that come and go on the map (Source/ColonyCouncil/Couriers). At the gate, a courier sets down
    what they brought, then fetches from the stores what they came for (JobGiver_CourierWork); otherwise they wait
    close by. Nothing else: no meals, no beds, no wandering into the colony.
  -->
  <DutyDef>
    <defName>Council_CourierWork</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ColonyCouncil.JobGiver_CourierWork" />
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>3</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!--
    A neighbors' stray held at the colony until their drover comes for it or the colony keeps it
    (Source/ColonyCouncil/Happenings/StrayBeast.cs): it eats when hungry and rests when tired close to where it was
    found, and otherwise wanders a few steps, keeping to the barn it stands in.
  -->
  <DutyDef>
    <defName>Rimfolk_StrayHold</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>6</maxDistToSquadFlag>
          <subNodes>
            <li Class="JobGiver_GetFood">
              <minCategory>Hungry</minCategory>
            </li>
            <li Class="JobGiver_GetRest">
              <minCategory>Tired</minCategory>
            </li>
          </subNodes>
        </li>
        <li Class="ColonyCouncil.JobGiver_StrayWander">
          <wanderRadius>3</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <JobDef>
    <defName>Council_CourierDrop</defName>
    <driverClass>ColonyCouncil.JobDriver_CourierDrop</driverClass>
    <reportString>setting down what they brought.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>Council_CourierFetch</defName>
    <driverClass>ColonyCouncil.JobDriver_CourierFetch</driverClass>
    <reportString>coming for TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>Council_CourierLoad</defName>
    <driverClass>ColonyCouncil.JobDriver_CourierLoad</driverClass>
    <reportString>loading up TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
