<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Two colonists trading weapons, a suggestion better for both (Source/ColonyCouncil/Weapons/WeaponSwapJob.cs,
       WeaponPick.cs): the one ordered walks over to the other and each hands the other what they hold. -->
  <JobDef>
    <defName>Rimfolk_SwapWeapons</defName>
    <driverClass>ColonyCouncil.JobDriver_SwapWeapons</driverClass>
    <reportString>trading weapons with TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <!-- A colonist taking a weapon another carries beyond their own kit, to fill an empty slot of theirs
       (Source/ColonyCouncil/Weapons/WeaponSwapJob.cs, WeaponKitMath.cs): they walk over and the other hands it over. -->
  <JobDef>
    <defName>Rimfolk_TakeSpareWeapon</defName>
    <driverClass>ColonyCouncil.JobDriver_TakeSpareWeapon</driverClass>
    <reportString>taking a spare weapon from TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

</Defs>
