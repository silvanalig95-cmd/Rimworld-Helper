    <driverClass>ColonyCouncil.JobDriver_PEv7Work</driverClass>
    <reportString>making the colony's call on TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.PEv7Work"><mark>sparks</mark></li>
    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_PEv7_String</defName>
    <driverClass>ColonyCouncil.JobDriver_PEv7Work</driverClass>
