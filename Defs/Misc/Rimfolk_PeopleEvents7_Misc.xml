<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The peoples' own events, round 7 (Source/ColonyCouncil/Peoples/Events7/): the jobs they are seen doing on the map, the Signal
       Line's flag-and-lamp tower for a Line before the industrial age (drawn by Tools/make_signal_tower.py), and the moods the round
       gives. -->

  <!-- ===================== Their own work at a thing or a place (JobDriver_PEv7Work) ===================== -->

  <JobDef>
    <defName>Rimfolk_PEv7_Judge</defName>
    <driverClass>ColonyCouncil.JobDriver_PEv7Work</driverClass>
    <reportString>judging TargetA for the guild's mark.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.PEv7Work"><mark>look</mark></li>
    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_PEv7_StandBy</defName>
    <driverClass>ColonyCouncil.JobDriver_PEv7Work</driverClass>
    <reportString>standing by while TargetA is judged.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.PEv7Work"><mark>quiet</mark></li>
    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_PEv7_Carve</defName>
