    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_PEv7_Listen</defName>
    <driverClass>ColonyCouncil.JobDriver_PEv7Work</driverClass>
    <reportString>listening for the region's news.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.PEv7Work"><mark>quiet</mark></li>
    </modExtensions>
