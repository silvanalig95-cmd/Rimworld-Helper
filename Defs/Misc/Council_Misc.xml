<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Rimfolk's four windows, one button each, placed together right after one another at startup
       (CouncilStartup.ApplyButtonPosition) in this order. Each window has the four in its top right corner, so any of
       them can be reached from another even with its button hidden or put away under More. -->

  <!-- The colony's own life: the council, its people, the colony and the Almanac. -->
  <MainButtonDef>
    <defName>Council_MainButton</defName>
    <label>council</label>
    <description>The colony's own life: the council (decrees, offices and elections, the ambition and its meetings, the colony's ways, dilemmas, wishes and petitions), its people (the roster, bonds, faiths, moods, dreams and journals), the colony (this week, the overview, priorities, the calendar and the chronicle), and the Almanac.</description>
    <tabWindowClass>ColonyCouncil.MainTabWindow_Council</tabWindowClass>
    <order>1000</order>
    <iconPath>ColonyCouncil/UI/MainButton</iconPath>
  </MainButtonDef>

  <!-- The Rimfolk map and everything beyond the colony. Labelled "region" because the game already has a "world" button
       (the planet view). Hidden by the setting "worldButton". -->
  <MainButtonDef>
    <defName>Rimfolk_WorldButton</defName>
    <label>region</label>
    <description>The Rimfolk map and everything beyond the colony: the region map, the neighbours and what's coming, the peoples of the world, letters and calls, journeys, world events and the world's history.</description>
    <tabWindowClass>ColonyCouncil.MainTabWindow_World</tabWindowClass>
    <order>1000</order>
    <iconPath>ColonyCouncil/Icons/World</iconPath>
  </MainButtonDef>

  <!-- The colony's defenses: the Defenses page in a window of its own. Hidden by the setting "defenseButton". -->
  <MainButtonDef>
    <defName>Council_DefenseButton</defName>
    <label>defense</label>
    <description>The colony's defenses read from its map: the ways raiders walk in, what the colony faces, the defense lines, and the advice, each with a button that puts the plan down where it's needed.</description>
    <tabWindowClass>ColonyCouncil.MainTabWindow_Defenses</tabWindowClass>
    <order>1000</order>
    <iconPath>ColonyCouncil/Icons/Defenses</iconPath>
  </MainButtonDef>

  <!-- Planning the base and its rooms. It took the rooms button's place and kept its name, so a bar arranged around the
       rooms button, and other mods' settings for it, still apply. Hidden by the setting "planButton". -->
  <MainButtonDef>
    <defName>Council_RoomsButton</defName>
    <label>planning</label>
    <description>Planning the base: the colony's next steps and the ground plan, the base looked over with what a click can put right, what you could make from the stock, the room plans with Rearrange a room, and every room at a glance, ready to plan.</description>
    <tabWindowClass>ColonyCouncil.MainTabWindow_Planning</tabWindowClass>
    <order>1000</order>
    <iconPath>ColonyCouncil/Icons/Plan</iconPath>
  </MainButtonDef>

  <!-- More: the bottom bar's buttons the player put away (UI/BarMore.cs). Placed just before the game's menu at
       startup; can be switched off in the settings, which puts every button back on the bar. -->
  <MainButtonDef>
    <defName>Rimfolk_MoreButton</defName>
    <label>more</label>
    <description>The bottom bar's buttons you put away. Right-click any button on the bar to put it here, and click the pin beside one to put it back. "Arrange the bottom bar" lists them all.</description>
    <workerClass>ColonyCouncil.MainButtonWorker_More</workerClass>
    <order>1000</order>
    <minimized>true</minimized>
    <iconPath>ColonyCouncil/Icons/More</iconPath>
    <validWithoutMap>true</validWithoutMap>
  </MainButtonDef>

  <!-- The gathering behind a council meeting. Never picked at random: only the council calls it. -->
  <GatheringDef>
    <defName>Council_MeetingGathering</defName>
    <label>council meeting</label>
    <randomSelectionWeight>0</randomSelectionWeight>
    <letterTitle>Council meeting</letterTitle>
    <letterText>The colony council is meeting.</letterText>
    <calledOffMessage>The council meeting broke up early.</calledOffMessage>
    <finishedMessage>The council meeting is over.</finishedMessage>
    <duty>Party</duty>
    <respectTimetable>false</respectTimetable>
    <workerClass>ColonyCouncil.GatheringWorker_CouncilMeeting</workerClass>
  </GatheringDef>

  <LetterDef>
    <defName>Council_MeetingLetter</defName>
    <letterClass>ColonyCouncil.ChoiceLetter_CouncilMeeting</letterClass>
    <color>(120, 175, 235)</color>
    <flashColor>(160, 205, 255)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive_Good</arriveSound>
    <bounce>true</bounce>
  </LetterDef>

  <LetterDef>
    <defName>Council_DilemmaLetter</defName>
    <letterClass>ColonyCouncil.ChoiceLetter_Dilemma</letterClass>
    <color>(215, 170, 90)</color>
    <flashColor>(240, 200, 120)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive</arriveSound>
    <bounce>true</bounce>
  </LetterDef>

</Defs>
