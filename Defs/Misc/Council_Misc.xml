<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <MainButtonDef>
    <defName>Council_MainButton</defName>
    <label>council</label>
    <description>The colony council: what the colony needs most, what your colonists are wishing for, the ambition you are working toward, room plans, and the chronicle of it all.</description>
    <tabWindowClass>ColonyCouncil.MainTabWindow_Council</tabWindowClass>
    <order>1000</order>
    <iconPath>ColonyCouncil/UI/MainButton</iconPath>
  </MainButtonDef>

  <!-- The colony's defenses, one click away: the Defenses page in a window of its own. Placed right after the council
       button at startup (before the rooms button); can be hidden in the settings. -->
  <MainButtonDef>
    <defName>Council_DefenseButton</defName>
    <label>defense</label>
    <description>The colony's defenses read from its map: the ways raiders walk in, what the colony faces, the defense lines, and the advice, each with a button that puts the plan down where it's needed.</description>
    <tabWindowClass>ColonyCouncil.MainTabWindow_Defenses</tabWindowClass>
    <order>1000</order>
    <iconPath>ColonyCouncil/Icons/Defenses</iconPath>
  </MainButtonDef>

  <!-- Room plans, one click away. Placed right after the council button at startup; can be hidden in the settings. -->
  <MainButtonDef>
    <defName>Council_RoomsButton</defName>
    <label>rooms</label>
    <description>Whole rooms planned for you: walls, door, furniture and floor in one go, adapted to what your colony can build. Pick one to open the planner.</description>
    <tabWindowClass>ColonyCouncil.MainTabWindow_Rooms</tabWindowClass>
    <order>1000</order>
    <iconPath>ColonyCouncil/UI/RoomsButton</iconPath>
  </MainButtonDef>

  <!-- The council's pages for planning the base, and rearranging a room, one click away (UI/PageButtons.cs). Placed
       right after the rooms button at startup; hidden together by the setting "planButtons". -->
  <MainButtonDef>
    <defName>Rimfolk_PlanButton</defName>
    <label>plan</label>
    <description>The colony's next steps: what the council proposes, in your order, each step opening what does it, and the ground plan that draws the next rooms on the map together.</description>
    <workerClass>ColonyCouncil.MainButtonWorker_Page</workerClass>
    <order>1000</order>
    <minimized>true</minimized>
    <iconPath>ColonyCouncil/Icons/Plan</iconPath>
    <modExtensions>
      <li Class="ColonyCouncil.PageButtonExtension"><page>Plan</page></li>
    </modExtensions>
  </MainButtonDef>

  <MainButtonDef>
    <defName>Rimfolk_BaseButton</defName>
    <label>base</label>
    <description>The base looked over: rooms far from what they belong with, long walks, doors that separate nothing, stubs of wall, conduits and pipes that lead nowhere, the stores, each with what a click can put right.</description>
    <workerClass>ColonyCouncil.MainButtonWorker_Page</workerClass>
    <order>1000</order>
    <minimized>true</minimized>
    <iconPath>ColonyCouncil/Icons/Base</iconPath>
    <modExtensions>
      <li Class="ColonyCouncil.PageButtonExtension"><page>Base</page></li>
    </modExtensions>
  </MainButtonDef>

  <MainButtonDef>
    <defName>Rimfolk_MakingButton</defName>
    <label>making</label>
    <description>What you could make: batches the stock allows at the benches you have with no bill for them, harvests nothing here uses and the bench that would, and benches standing without bills.</description>
    <workerClass>ColonyCouncil.MainButtonWorker_Page</workerClass>
    <order>1000</order>
    <minimized>true</minimized>
    <iconPath>ColonyCouncil/Icons/Making</iconPath>
    <modExtensions>
      <li Class="ColonyCouncil.PageButtonExtension"><page>Making</page></li>
    </modExtensions>
  </MainButtonDef>

  <MainButtonDef>
    <defName>Rimfolk_RearrangeButton</defName>
    <label>rearrange</label>
    <description>Rearrange a room: click a built room to see where the council would put its furniture, then say go. The moves are carried out with the game's own reinstall orders.</description>
    <workerClass>ColonyCouncil.MainButtonWorker_Page</workerClass>
    <order>1000</order>
    <minimized>true</minimized>
    <iconPath>ColonyCouncil/Icons/Rearrange</iconPath>
    <modExtensions>
      <li Class="ColonyCouncil.PageButtonExtension"><tool>rearrange</tool></li>
    </modExtensions>
  </MainButtonDef>

  <!-- More: the bottom bar's buttons the player put away (UI/BarMore.cs). Placed just before the game's menu at
       startup; can be switched off in the settings, which puts every button back on the bar. -->
  <MainButtonDef>
    <defName>Rimfolk_MoreButton</defName>
    <label>more</label>
    <description>The bottom bar's buttons you put away. Right-click any button on the bar to put it here, and click the pin beside one to put it back. "Arrange the bottom bar" lists them all.</description>
    <workerClass>ColonyCouncil.MainButtonWorker_More</workerClass>
    <order>1000</order>
    <minimized>true</minimized>
    <iconPath>ColonyCouncil/Icons/More</iconPath>
    <validWithoutMap>true</validWithoutMap>
  </MainButtonDef>

  <!-- The gathering behind a council meeting. Never picked at random: only the council calls it. -->
  <GatheringDef>
    <defName>Council_MeetingGathering</defName>
    <label>council meeting</label>
    <randomSelectionWeight>0</randomSelectionWeight>
    <letterTitle>Council meeting</letterTitle>
    <letterText>The colony council is meeting.</letterText>
    <calledOffMessage>The council meeting broke up early.</calledOffMessage>
    <finishedMessage>The council meeting is over.</finishedMessage>
    <duty>Party</duty>
    <respectTimetable>false</respectTimetable>
    <workerClass>ColonyCouncil.GatheringWorker_CouncilMeeting</workerClass>
  </GatheringDef>

  <LetterDef>
    <defName>Council_MeetingLetter</defName>
    <letterClass>ColonyCouncil.ChoiceLetter_CouncilMeeting</letterClass>
    <color>(120, 175, 235)</color>
    <flashColor>(160, 205, 255)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive_Good</arriveSound>
    <bounce>true</bounce>
  </LetterDef>

  <LetterDef>
    <defName>Council_DilemmaLetter</defName>
    <letterClass>ColonyCouncil.ChoiceLetter_Dilemma</letterClass>
    <color>(215, 170, 90)</color>
    <flashColor>(240, 200, 120)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive</arriveSound>
    <bounce>true</bounce>
  </LetterDef>

</Defs>
