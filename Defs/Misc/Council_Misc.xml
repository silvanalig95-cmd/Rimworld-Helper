<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <MainButtonDef>
    <defName>Council_MainButton</defName>
    <label>council</label>
    <description>The colony council: what the colony needs most, what your colonists are wishing for, the ambition you are working towards, room plans, and the chronicle of it all.</description>
    <tabWindowClass>ColonyCouncil.MainTabWindow_Council</tabWindowClass>
    <order>1000</order>
    <iconPath>ColonyCouncil/UI/MainButton</iconPath>
  </MainButtonDef>

  <!-- Room plans, one click away. Placed right after the council button at startup; can be hidden in the settings. -->
  <MainButtonDef>
    <defName>Council_RoomsButton</defName>
    <label>rooms</label>
    <description>Whole rooms planned for you: walls, door, furniture and floor in one go, adapted to what your colony can build. Pick one to open the planner.</description>
    <tabWindowClass>ColonyCouncil.MainTabWindow_Rooms</tabWindowClass>
    <order>1000</order>
    <iconPath>ColonyCouncil/UI/RoomsButton</iconPath>
  </MainButtonDef>

  <!-- The gathering behind a council meeting. Never picked at random: only the council calls it. -->
  <GatheringDef>
    <defName>Council_MeetingGathering</defName>
    <label>council meeting</label>
    <randomSelectionWeight>0</randomSelectionWeight>
    <letterTitle>Council meeting</letterTitle>
    <letterText>The colony council is meeting.</letterText>
    <calledOffMessage>The council meeting broke up early.</calledOffMessage>
    <finishedMessage>The council meeting is over.</finishedMessage>
    <duty>Party</duty>
    <respectTimetable>false</respectTimetable>
    <workerClass>ColonyCouncil.GatheringWorker_CouncilMeeting</workerClass>
  </GatheringDef>

  <LetterDef>
    <defName>Council_MeetingLetter</defName>
    <letterClass>ColonyCouncil.ChoiceLetter_CouncilMeeting</letterClass>
    <color>(120, 175, 235)</color>
    <flashColor>(160, 205, 255)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive_Good</arriveSound>
    <bounce>true</bounce>
  </LetterDef>

  <LetterDef>
    <defName>Council_DilemmaLetter</defName>
    <letterClass>ColonyCouncil.ChoiceLetter_Dilemma</letterClass>
    <color>(215, 170, 90)</color>
    <flashColor>(240, 200, 120)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive</arriveSound>
    <bounce>true</bounce>
  </LetterDef>

</Defs>
