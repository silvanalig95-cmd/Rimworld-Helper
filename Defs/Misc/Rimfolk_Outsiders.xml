<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Talking with people from outside the colony (Source/ColonyCouncil/Outsiders/): the colonist's walk over and talk,
       the outsider stopping to listen, a gift handed over, a lesson and its teacher, a bout (practice or a duel), those
       who watch a duel, and a favour brought on the next visit. -->

  <JobDef>
    <defName>Council_OutsiderTalk</defName>
    <driverClass>ColonyCouncil.JobDriver_OutsiderTalk</driverClass>
    <reportString>talking with someone.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_OutsiderListen</defName>
    <driverClass>ColonyCouncil.JobDriver_OutsiderListen</driverClass>
    <reportString>talking with someone.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_OutsiderGift</defName>
    <driverClass>ColonyCouncil.JobDriver_OutsiderGift</driverClass>
    <reportString>bringing someone a gift.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_OutsiderLesson</defName>
    <driverClass>ColonyCouncil.JobDriver_OutsiderLesson</driverClass>
    <reportString>having a lesson.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_OutsiderTeach</defName>
    <driverClass>ColonyCouncil.JobDriver_OutsiderTeach</driverClass>
    <reportString>teaching someone.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_OutsiderBout</defName>
    <driverClass>ColonyCouncil.JobDriver_OutsiderBout</driverClass>
    <reportString>fighting a bout.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_OutsiderWatch</defName>
    <driverClass>ColonyCouncil.JobDriver_OutsiderWatch</driverClass>
    <reportString>watching a duel.</reportString>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_OutsiderMeal</defName>
    <driverClass>ColonyCouncil.JobDriver_OutsiderMeal</driverClass>
    <reportString>eating with company.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <suspendable>false</suspendable>
  </JobDef>

  <JobDef>
    <defName>Council_OutsiderBring</defName>
    <driverClass>ColonyCouncil.JobDriver_OutsiderBring</driverClass>
    <reportString>bringing something over.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

</Defs>
