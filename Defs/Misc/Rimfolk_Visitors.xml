<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    People from outside who are really there (Source/ColonyCouncil/Visitors): a rider waiting at the gate for the
    colony's answer, guests given a night, mourners and herds passing on the road, prospectors on the creek. At their
    spot they keep close to it, and sleep when they're tired or night has come, on open ground near it; their animals
    rest nearby. They eat what they brought (the visit feeds them from their own packs, never from the colony's stores
    or fields). Out of doors they never go into the colony's rooms or onto its fields. Those who came to do something
    do it (Rimfolk_VisitWork, VisitorWork.cs): panning the creek (and pocketing what it shows), gleaning the stubble
    into their sacks, singing at their camp after dark, watching for game on the far side. A camp out on the land has
    its own fire to sit round of an evening (VisitorCamp.cs); colonists may walk out to sit with them. Waiting at the
    gate, they take a seat out there if there's one.
  -->
  <DutyDef>
    <defName>Rimfolk_VisitWait</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>12</maxDistToSquadFlag>
          <subNodes>
            <li Class="ColonyCouncil.JobGiver_VisitRest" />
          </subNodes>
        </li>
        <li Class="ColonyCouncil.JobGiver_VisitFire" />
        <li Class="ColonyCouncil.JobGiver_VisitSit" />
        <li Class="ColonyCouncil.JobGiver_VisitWander">
          <wanderRadius>4</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>Rimfolk_VisitWork</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>12</maxDistToSquadFlag>
          <subNodes>
            <li Class="ColonyCouncil.JobGiver_VisitRest" />
          </subNodes>
        </li>
        <li Class="ColonyCouncil.JobGiver_VisitWork" />
        <li Class="ColonyCouncil.JobGiver_VisitFire" />
        <li Class="ColonyCouncil.JobGiver_VisitWander">
          <wanderRadius>4</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- Guests given a corner inside for the night: they keep to the room they were shown. -->
  <DutyDef>
    <defName>Rimfolk_VisitIndoors</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>4</maxDistToSquadFlag>
          <subNodes>
            <li Class="ColonyCouncil.JobGiver_VisitRest">
              <indoors>true</indoors>
            </li>
          </subNodes>
        </li>
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>2</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>Rimfolk_VisitBeasts</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>16</maxDistToSquadFlag>
          <subNodes>
            <li Class="ColonyCouncil.JobGiver_VisitRest" />
          </subNodes>
        </li>
        <li Class="ColonyCouncil.JobGiver_VisitWander">
          <wanderRadius>7</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- What visitors came to do, at their spot (VisitorWork.cs): one stint at a time, in the work's hours. -->
  <JobDef>
    <defName>Rimfolk_VisitProspect</defName>
    <driverClass>ColonyCouncil.JobDriver_VisitWork</driverClass>
    <reportString>panning the creek for silver.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.VisitWorkExtension">
        <work>prospect</work>
        <effecter>ConstructDirt</effecter>
        <ticks>1500~3000</ticks>
      </li>
    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_VisitGlean</defName>
    <driverClass>ColonyCouncil.JobDriver_VisitWork</driverClass>
    <reportString>gleaning the stubble.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.VisitWorkExtension">
        <work>glean</work>
        <effecter>Harvest_Plant</effecter>
        <ticks>500~900</ticks>
      </li>
    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_VisitSing</defName>
    <driverClass>ColonyCouncil.JobDriver_VisitWork</driverClass>
    <reportString>singing with the others.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.VisitWorkExtension">
        <work>sing</work>
        <music>true</music>
        <ticks>2000~3000</ticks>
      </li>
    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_VisitHunt</defName>
    <driverClass>ColonyCouncil.JobDriver_VisitWork</driverClass>
    <reportString>watching for game.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.VisitWorkExtension">
        <work>hunt</work>
        <ticks>900~1800</ticks>
      </li>
    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_VisitFire</defName>
    <driverClass>ColonyCouncil.JobDriver_VisitWork</driverClass>
    <reportString>sitting by the fire.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.VisitWorkExtension">
        <work>fire</work>
        <social>SuperActive</social>
        <ticks>1500~2500</ticks>
      </li>
    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_VisitSit</defName>
    <driverClass>ColonyCouncil.JobDriver_VisitWork</driverClass>
    <reportString>sitting while waiting.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <modExtensions>
      <li Class="ColonyCouncil.VisitWorkExtension">
        <work>sit</work>
        <ticks>1200~2400</ticks>
      </li>
    </modExtensions>
  </JobDef>

  <!-- Colonists at leisure walk out to sit with visitors by their camp's fire (VisitorCamp.cs). -->
  <JobDef>
    <defName>Rimfolk_SitWithVisitors</defName>
    <driverClass>ColonyCouncil.JobDriver_SitWithVisitors</driverClass>
    <reportString>sitting with the visitors by their fire.</reportString>
    <joyDuration>2500</joyDuration>
    <joyKind>Social</joyKind>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <JoyGiverDef>
    <defName>Rimfolk_SitWithVisitors</defName>
    <giverClass>ColonyCouncil.JoyGiver_SitWithVisitors</giverClass>
    <baseChance>0.5</baseChance>
    <jobDef>Rimfolk_SitWithVisitors</jobDef>
    <joyKind>Social</joyKind>
    <requiredCapacities>
      <li>Moving</li>
      <li>Talking</li>
    </requiredCapacities>
  </JoyGiverDef>

</Defs>
