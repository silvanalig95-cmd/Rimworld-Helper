    <apiVersion>1</apiVersion>
  </RimHUD.CustomValueDef>

  <!-- Bars (RimHUD's custom bar API, version 1): strain fills and reddens as it builds; the heart's needs fill as they're met. -->
  <RimHUD.CustomBarDef MayRequire="jaxe.rimhud">
    <defName>Council_Hud_StrainBar</defName>
    <label>Rimfolk: strain (bar)</label>
    <colorStyle>MainToLow</colorStyle>
    <defClass>ColonyCouncil.RimHud_StrainBar</defClass>
    <apiVersion>1</apiVersion>
  </RimHUD.CustomBarDef>

  <RimHUD.CustomBarDef MayRequire="jaxe.rimhud">
    <defName>Council_Hud_BelongingBar</defName>
