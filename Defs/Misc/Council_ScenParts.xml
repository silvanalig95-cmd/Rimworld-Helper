<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Rimfolk's scenario parts: stakes already in play when the game starts. Rimfolk's own scenarios use them, and
       they can be added to any scenario in the scenario editor. They're never added to random scenarios. -->

  <ScenPartDef>
    <defName>Council_ScenFoe</defName>
    <label>Rimfolk: a sworn enemy</label>
    <category>Misc</category>
    <scenPartClass>ColonyCouncil.ScenPart_CouncilFoe</scenPartClass>
    <selectionWeight>0</selectionWeight>
    <canBeRandomlyAdded>false</canBeRandomlyAdded>
    <maxUses>1</maxUses>
    <summaryPriority>500</summaryPriority>
  </ScenPartDef>

