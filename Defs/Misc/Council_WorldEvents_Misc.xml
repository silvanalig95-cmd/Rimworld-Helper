<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Rimfolk's world events live in their own category: Rimfolk schedules them itself (Settings: World events),
       so they never take a slot from the storyteller's own events. Dev mode can fire any of them. -->
  <IncidentCategoryDef>
    <defName>Council_WorldEvent</defName>
    <label>Rimfolk world event</label>
  </IncidentCategoryDef>

  <LetterDef>
    <defName>Council_EventLetter</defName>
    <letterClass>ColonyCouncil.ChoiceLetter_Happening</letterClass>
    <color>(120, 165, 225)</color>
    <flashColor>(160, 200, 250)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive</arriveSound>
    <bounce>true</bounce>
  </LetterDef>

  <LetterDef>
    <defName>Council_EventLetterThreat</defName>
    <letterClass>ColonyCouncil.ChoiceLetter_Happening</letterClass>
    <color>(205, 80, 60)</color>
    <flashColor>(240, 110, 90)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive_BadUrgentSmall</arriveSound>
    <bounce>true</bounce>
  </LetterDef>

  <!-- The great beast: old, huge, scarred, and very hard to bring down. -->
  <HediffDef>
    <defName>Council_Legendary</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>legendary</label>
    <description>This creature is far older than most of its kind, and scarred by everything that ever tried to bring it down. Its hide turns blows that would fell an ordinary animal, and it hits back harder.</description>
    <defaultLabelColor>(0.85, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>0.5</IncomingDamageFactor>
          <MeleeDamageFactor>1.3</MeleeDamageFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <GameConditionDef>
    <defName>Council_Comet</defName>
    <conditionClass>ColonyCouncil.GameCondition_Comet</conditionClass>
    <label>comet</label>
    <description>A comet hangs in the sky, visible by day and brilliant by night. Colonists stargaze more often, and enjoy it more.</description>
    <endMessage>The comet has faded from the sky.</endMessage>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>

  <GameConditionDef>
    <defName>Council_Fireflies</defName>
    <conditionClass>ColonyCouncil.GameCondition_Fireflies</conditionClass>
    <label>firefly nights</label>
    <description>The nights are full of fireflies. Anyone outside after dark gets to see them.</description>
    <endMessage>The fireflies are gone for this year.</endMessage>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>

  <GameConditionDef>
    <defName>Council_Hail</defName>
    <conditionClass>ColonyCouncil.GameCondition_Hail</conditionClass>
    <label>hailstorm</label>
    <description>Hail is hammering down. Crops in open fields are losing growth, and some young plants will be destroyed. Anything under a roof is safe. The hail won't injure anyone, but colonists caught outside will be unhappy about it.</description>
    <endMessage>The hail has stopped.</endMessage>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>

  <!-- A month of shaking off sickness better: a travelling doctor's shot, or a herbalist's tonic. -->
  <HediffDef>
    <defName>Council_Inoculated</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>inoculated</label>
    <description>A traveling doctor's vaccine. For a month, the body builds immunity to sickness faster.</description>
    <defaultLabelColor>(0.6, 0.85, 0.65)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800000~1800000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ImmunityGainSpeed>0.15</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Council_HerbalTonic</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>herbal tonic</label>
    <description>A wandering herbalist's bitter tonic. For a month, the body fights off sickness faster.</description>
    <defaultLabelColor>(0.6, 0.85, 0.65)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800000~1800000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ImmunityGainSpeed>0.15</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
