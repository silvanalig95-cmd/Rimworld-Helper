<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Answers that play out on the map (Source/ColonyCouncil/PlayOut). The gathering behind a feast, a bonfire, a toast
    or a party an answer called: the game's own party duty, never picked at random. Only an answer starts one.
  -->
  <GatheringDef>
    <defName>Council_PlayOutGathering</defName>
    <label>gathering</label>
    <randomSelectionWeight>0</randomSelectionWeight>
    <letterTitle>Gathering</letterTitle>
    <letterText>The colony is gathering.</letterText>
    <calledOffMessage>The gathering broke up early.</calledOffMessage>
    <finishedMessage>The gathering is over.</finishedMessage>
    <duty>Party</duty>
    <respectTimetable>false</respectTimetable>
    <workerClass>ColonyCouncil.GatheringWorker_PlayOut</workerClass>
  </GatheringDef>

  <!--
    A colonist an answer sent somewhere for a while: keeping someone company, sitting by a grave, at the camp's fire,
    on a long walk, or learning at a teacher's side (JobDriver_PlayOutVisit).
  -->
  <JobDef>
    <defName>Council_PlayOutVisit</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutVisit</driverClass>
    <reportString>spending time with TargetA.</reportString>
    <joyKind>Social</joyKind>
    <joyGainRate>0.6</joyGainRate>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <!--
    Words said to a gathering (a lesson, a story, a letter read out; PlayOut/PlayListen.cs): the speaker stands at the
    head of the table, the listeners take the chairs round it or stand close by, all facing each other.
  -->
  <JobDef>
    <defName>Council_PlayOutListen</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutListen</driverClass>
    <reportString>listening.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_PlayOutSpeak</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutSpeak</driverClass>
    <reportString>speaking to those gathered.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <DutyDef>
    <defName>Council_PlayOutListenDuty</defName>
    <hook>MediumPriority</hook>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ColonyCouncil.JobGiver_PlayOutListen" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>Council_PlayOutSpeakDuty</defName>
    <hook>MediumPriority</hook>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ColonyCouncil.JobGiver_PlayOutSpeak" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!--
    Work parties, walks together, vigils, searches and errands an answer called (PlayOut/PlayGroups.cs). Each person is
    on a job of their own, never in a lord, so the game's own gatherings and rituals can always take them.
  -->
  <JobDef>
    <defName>Council_PlayOutWalk</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutGroup</driverClass>
    <reportString>walking with the others.</reportString>
    <joyKind>Social</joyKind>
    <joyGainRate>0.4</joyGainRate>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_PlayOutVigil</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutGroup</driverClass>
    <reportString>keeping watch.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_PlayOutSearch</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutGroup</driverClass>
    <reportString>searching.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>Council_PlayOutCarry</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutCarry</driverClass>
    <reportString>carrying TargetA out.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <!-- The step between two of a work party's jobs: counts the last, queues the next. Takes no time. -->
  <JobDef>
    <defName>Council_PlayOutWorkNext</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutWorkNext</driverClass>
    <reportString>looking for the next job.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <!--
    A thing carried by hand (PlayOut/OnMapPlays.cs): a gift walked over to the one it's for, a stash carried out to the
    yard and burned, a thing collected from beside a visitor and taken in to the table.
  -->
  <JobDef>
    <defName>Council_PlayOutGive</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutGive</driverClass>
    <reportString>carrying TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

  <!-- Rounds: going from one colonist to the next, a few minutes with each (a doctor's look, a pot of soup). -->
  <JobDef>
    <defName>Council_PlayOutRounds</defName>
    <driverClass>ColonyCouncil.JobDriver_PlayOutGroup</driverClass>
    <reportString>making the rounds.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
  </JobDef>

</Defs>
