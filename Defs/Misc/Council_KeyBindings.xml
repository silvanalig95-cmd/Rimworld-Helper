<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Optional keyboard shortcuts for the pages of Rimfolk's windows (Source/ColonyCouncil/UI/CouncilKeys.cs). None has a
    key until the player picks one in Options, Keyboard, under "Rimfolk", so they never clash with the game's own keys or
    another mod's. A page's key opens the window that has the page on it, or closes it when that page is already
    showing (the world key's page is the region window's Neighbours, the defenses key's the defense window); the next
    and previous page keys step through the pages of the window that is open. The def names stay as they were, so keys
    already picked keep working.
  -->

  <KeyBindingCategoryDef>
    <defName>Rimfolk</defName>
    <label>Rimfolk</label>
    <description>Shortcuts for the pages of Rimfolk's windows. None is set until you pick a key.</description>
  </KeyBindingCategoryDef>

  <KeyBindingDef Name="Council_KeyBase" Abstract="True">
    <category>Rimfolk</category>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_Week</defName>
    <label>council: this week</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_Everyone</defName>
    <label>council: everyone (the people table)</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_Wishes</defName>
    <label>council: wishes</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_Moods</defName>
    <label>council: moods</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_World</defName>
    <label>region: neighbours and what's coming</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_Defenses</defName>
    <label>defense: the defenses</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_Calendar</defName>
    <label>council: calendar</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_Dilemmas</defName>
    <label>council: dilemmas</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_Almanac</defName>
    <label>council: almanac</label>
  </KeyBindingDef>

  <!-- The region window on its map (Source/ColonyCouncil/UI/MainTabWindow_World.cs), opened or closed. -->
  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_RegionMap</defName>
    <label>region: the map (open or close)</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_NextPage</defName>
    <label>next page</label>
  </KeyBindingDef>

  <KeyBindingDef ParentName="Council_KeyBase">
    <defName>Council_Key_PreviousPage</defName>
    <label>previous page</label>
  </KeyBindingDef>

</Defs>
