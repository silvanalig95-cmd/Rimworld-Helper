<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    A joke passed on (ColonyCouncil.InteractionWorker_JokeRetold, Source/ColonyCouncil/Social/Talk/JokesRetold.cs): a
    colonist tells a friend about an in-joke the friend wasn't there for. It comes up in the game's own conversation
    picker only when the teller has such a joke (laughed over at least once, not yet worn out, from the last two
    months) and the friend isn't already in on it. From then on the two share it (Rimfolk_Mem_JokeHeard). The words
    themselves are said over their heads (Rimfolk_SharedTimes_Lines.xml); the social log gets one of these.
  -->

  <InteractionDef>
    <defName>Rimfolk_JokeRetold</defName>
    <label>passed on a joke</label>
    <workerClass>ColonyCouncil.InteractionWorker_JokeRetold</workerClass>
    <symbol>ColonyCouncil/Symbols/Moment</symbol>
    <recipientThought>Rimfolk_JokeRetold_Heard</recipientThought>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] told [RECIPIENT_nameDef] a story [RECIPIENT_pronoun] had missed, and [RECIPIENT_pronoun] laughed.</li>
        <li>r_logentry->[INITIATOR_nameDef] let [RECIPIENT_nameDef] in on an old joke.</li>
        <li>r_logentry->[INITIATOR_nameDef] told [RECIPIENT_nameDef] about something funny from before [RECIPIENT_pronoun] knew about it.</li>
        <li>r_logentry->[INITIATOR_nameDef] acted out an old mishap for [RECIPIENT_nameDef], doing all the parts.</li>
        <li>r_logentry->[RECIPIENT_nameDef] asked what the joke was, and [INITIATOR_nameDef] told [RECIPIENT_objective].</li>
      </rulesStrings>
    </logRulesInitiator>
  </InteractionDef>

  <ThoughtDef>
    <defName>Rimfolk_JokeRetold_Heard</defName>
    <thoughtClass>ColonyCouncil.Thought_CouncilSocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>let me in on a joke</label>
        <baseOpinionOffset>3</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
