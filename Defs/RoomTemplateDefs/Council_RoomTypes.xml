<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Room types: the sizes and kinds of one room. Menus show each type once (its main variant) and the planner offers
    the others as buttons, keeping the turn, style and materials when the player switches. A variant whose template
    isn't loaded (a DLC or mod that's off) is skipped. A template in no type stands on its own.
  -->

  <ColonyCouncil.RoomTypeDef>
    <defName>Council_RT_Bedroom</defName>
    <label>bedroom</label>
    <main>Council_Bedroom</main>
    <variants>
      <li><template>Council_SmallBedroom</template><label>cozy</label></li>
      <li><template>Council_Bedroom</template><label>standard</label></li>
      <li><template>Council_Bedroom_Roomy</template><label>roomy</label></li>
      <li><template>Council_Bedroom_Hut</template><label>hut</label></li>
    </variants>
  </ColonyCouncil.RoomTypeDef>

  <ColonyCouncil.RoomTypeDef>
    <defName>Council_RT_CoupleBedroom</defName>
    <label>couple's bedroom</label>
