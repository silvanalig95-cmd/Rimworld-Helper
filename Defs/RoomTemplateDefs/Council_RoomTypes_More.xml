<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    More room types: rooms that stood alone before, with their new sizes and kinds (Council_RoomTemplates_Variety.xml,
    Council_RoomTemplates_VarietyDLC.xml, Council_RoomTemplates_Hygiene3.xml). Same rules as Council_RoomTypes.xml: a
    variant whose template isn't loaded is skipped, so a DLC size simply isn't offered without its DLC. A type whose
    every size needs a DLC or a mod loads only with it.
  -->

  <!-- ==================== Leisure ==================== -->

  <ColonyCouncil.RoomTypeDef>
    <defName>Council_RT_CouncilRoom</defName>
    <label>council chamber</label>
    <main>Council_CouncilChamber</main>
    <variants>
      <li><template>Council_CouncilFire</template><label>council fire</label></li>
      <li><template>Council_CouncilTable</template><label>for 6</label></li>
      <li><template>Council_CouncilChamber</template><label>for 10</label></li>
      <li><template>Council_CouncilHall</template><label>for 20</label></li>
    </variants>
  </ColonyCouncil.RoomTypeDef>

