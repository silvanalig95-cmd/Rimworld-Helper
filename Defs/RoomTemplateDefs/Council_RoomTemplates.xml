<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Room templates for the planner. Coordinates are interior floor cells: (0,0) is the bottom-left floor
    cell, the door sits in the bottom (south) wall at doorX (default: the middle). The whole template
    rotates with Q/E when placing.

    Furniture: <defs> lists defNames best-first. The first one the colony can actually build (research,
    tech, power) is used; otherwise any building with the same <role> and footprint (so modded or medieval
    furniture works). Missing optional pieces are skipped. A non-optional piece that can't be built makes
    the whole template unavailable, with a reason shown.
  -->

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Bedroom</defName>
    <group>Living</group>
    <tips>
      <li>A 5x5 bedroom feels spacious and is still small enough to make impressive cheaply.</li>
      <li>A bedroom's impressiveness gives a mood bonus every morning. A floor, a light and a piece of art go a long way.</li>
    </tips>
    <label>bedroom</label>
    <description>A private bedroom for one: bed, bedside table, dresser, a light and a plant.</description>
    <order>10</order>
    <size>(5,5)</size>
    <floors>
      <li>WoodPlankFloor</li>
    </floors>
    <things>
      <li>
        <defs><li>Bed</li><li>Bedroll</li></defs>
        <role>bed</role>
        <pos>(0,4)</pos>
        <rot>South</rot>
        <optional>false</optional>
      </li>
      <li>
        <defs><li>EndTable</li></defs>
        <role>endtable</role>
        <pos>(1,4)</pos>
        <rot>South</rot>
      </li>
      <li>
        <defs><li>Dresser</li></defs>
        <role>dresser</role>
        <pos>(4,4)</pos>
        <rot>South</rot>
      </li>
      <li>
        <defs><li>StandingLamp</li><li>TorchLamp</li></defs>
        <role>light</role>
        <pos>(4,0)</pos>
      </li>
      <li>
        <defs><li>PlantPot</li></defs>
        <role>plantpot</role>
        <pos>(0,0)</pos>
      </li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_CoupleBedroom</defName>
    <group>Living</group>
    <tips>
      <li>Lovers who sleep apart get a mood penalty. A double bed in a shared room keeps couples happy.</li>
      <li>With an end table on each side, the room counts as properly furnished for both.</li>
    </tips>
    <label>couple's bedroom</label>
    <description>A bedroom for two: a double bed with a table on each side, a dresser, a light and a plant.</description>
    <order>11</order>
    <size>(5,5)</size>
    <floors>
      <li>WoodPlankFloor</li>
    </floors>
    <things>
      <li>
        <defs><li>DoubleBed</li><li>BedrollDouble</li></defs>
        <role>doublebed</role>
        <pos>(2,4)</pos>
        <rot>South</rot>
        <optional>false</optional>
      </li>
      <li>
        <defs><li>EndTable</li></defs>
        <role>endtable</role>
        <pos>(0,4)</pos>
        <rot>South</rot>
      </li>
      <li>
        <defs><li>EndTable</li></defs>
        <role>endtable</role>
        <pos>(3,4)</pos>
        <rot>South</rot>
      </li>
      <li>
        <defs><li>Dresser</li></defs>
        <role>dresser</role>
        <pos>(3,0)</pos>
      </li>
      <li>
        <defs><li>StandingLamp</li><li>TorchLamp</li></defs>
        <role>light</role>
        <pos>(4,4)</pos>
      </li>
      <li>
        <defs><li>PlantPot</li></defs>
        <role>plantpot</role>
        <pos>(0,0)</pos>
      </li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_DiningRoom</defName>
    <group>Food</group>
    <near><li>Kitchen</li></near>
    <tips>
      <li>Eating without a table costs mood at every meal. One chair per colonist, or at least one per two if meals are staggered.</li>
      <li>An impressive dining room gives a mood bonus with every meal. It's the room colonists see most, so it's worth decorating.</li>
      <li>Put it next to the kitchen and freezer so meals travel a few steps, not across the base.</li>
    </tips>
    <label>dining room</label>
    <description>A table for eight with chairs all around, lights and plants. Every colonist eats here once or twice a day, so this pays off fast.</description>
    <order>20</order>
    <size>(6,5)</size>
    <floors>
      <li>WoodPlankFloor</li>
    </floors>
    <things>
      <li>
        <defs><li>Table2x2c</li></defs>
        <role>table</role>
        <pos>(2,2)</pos>
        <optional>false</optional>
      </li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(1,2)</pos><rot>East</rot></li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(1,3)</pos><rot>East</rot></li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(4,2)</pos><rot>West</rot></li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(4,3)</pos><rot>West</rot></li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(2,1)</pos><rot>North</rot></li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(3,1)</pos><rot>North</rot></li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(2,4)</pos><rot>South</rot></li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(3,4)</pos><rot>South</rot></li>
      <li><defs><li>StandingLamp</li><li>TorchLamp</li></defs><role>light</role><pos>(0,0)</pos></li>
      <li><defs><li>StandingLamp</li><li>TorchLamp</li></defs><role>light</role><pos>(5,4)</pos></li>
      <li><defs><li>PlantPot</li></defs><role>plantpot</role><pos>(0,4)</pos></li>
      <li><defs><li>PlantPot</li></defs><role>plantpot</role><pos>(5,0)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_RecRoom</defName>
    <group>Leisure</group>
    <near><li>DiningRoom</li></near>
    <tips>
      <li>Colonists get bored of doing the same thing for fun. Different kinds of recreation keep the need full.</li>
      <li>A rec room next to the dining room means colonists relax right after eating instead of walking across the map.</li>
    </tips>
    <label>recreation room</label>
    <description>Somewhere to unwind: a game table with seats, horseshoes, a light and a plant. Add more kinds of games over time for variety.</description>
    <order>21</order>
    <size>(6,5)</size>
    <things>
      <li>
        <defs><li>ChessTable</li></defs>
        <role>joy</role>
        <pos>(1,3)</pos>
      </li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(0,3)</pos><rot>East</rot></li>
      <li><defs><li>DiningChair</li><li>Stool</li></defs><role>chair</role><pos>(2,3)</pos><rot>West</rot></li>
      <li>
        <defs><li>HorseshoesPin</li></defs>
        <role>joy</role>
        <pos>(5,4)</pos>
      </li>
      <li><defs><li>StandingLamp</li><li>TorchLamp</li></defs><role>light</role><pos>(5,0)</pos></li>
      <li><defs><li>PlantPot</li></defs><role>plantpot</role><pos>(0,0)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Workshop</defName>
    <group>Work</group>
    <near><li>Storeroom</li></near>
    <tips>
      <li>Workbenches near a stockpile save hours of walking every day.</li>
      <li>A floor and a light make work faster and colonists happier.</li>
    </tips>
    <label>workshop</label>
    <description>Two crafting stations along the back wall and a sculpting table by the door, with room to work at each.</description>
    <order>30</order>
    <size>(6,5)</size>
    <things>
      <li>
        <defs><li>ElectricTailoringBench</li><li>HandTailoringBench</li></defs>
        <role>craft</role>
        <pos>(1,3)</pos>
        <optional>false</optional>
      </li>
      <li>
        <defs><li>ElectricSmithy</li><li>FueledSmithy</li></defs>
        <role>craft</role>
        <pos>(4,3)</pos>
      </li>
      <li>
        <defs><li>TableSculpting</li></defs>
        <role>art</role>
        <pos>(1,0)</pos>
        <rot>South</rot>
      </li>
      <li><defs><li>StandingLamp</li><li>TorchLamp</li></defs><role>light</role><pos>(5,0)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Kitchen</defName>
    <group>Food</group>
    <near><li>DiningRoom</li></near>
    <tips>
      <li>A clean kitchen means fewer food poisonings. Lay tiles, keep a cleaner busy, and keep the butcher table in another room.</li>
      <li>Put the kitchen, freezer and dining room side by side, so the cook and the diners only walk a few steps.</li>
    </tips>
    <label>kitchen</label>
    <description>A cooking station, a shelf for ingredients and a clean floor. Keep butchering in a separate room: blood and guts make kitchens filthy and meals risky.</description>
    <order>31</order>
    <size>(5,4)</size>
    <floors>
      <li>SterileTile</li>
    </floors>
    <things>
      <li>
        <defs><li>ElectricStove</li><li>FueledStove</li></defs>
        <role>cook</role>
        <pos>(1,2)</pos>
        <optional>false</optional>
      </li>
      <li>
        <defs><li>Shelf</li></defs>
        <role>storage</role>
        <pos>(4,3)</pos>
        <rot>South</rot>
      </li>
      <li><defs><li>StandingLamp</li><li>TorchLamp</li></defs><role>light</role><pos>(4,0)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Laboratory</defName>
    <group>Work</group>
    <tips>
      <li>Researchers work faster in clean, tidy rooms. A floor and a light help.</li>
      <li>A hi-tech research bench with a multi-analyzer is much faster, once you can build them.</li>
    </tips>
    <label>laboratory</label>
    <description>A quiet room with a research bench and good light. A clean floor speeds up research.</description>
    <order>32</order>
    <size>(5,4)</size>
    <floors>
      <li>SterileTile</li>
    </floors>
    <things>
      <li>
        <defs><li>HiTechResearchBench</li><li>SimpleResearchBench</li></defs>
        <role>research</role>
        <pos>(2,2)</pos>
        <optional>false</optional>
      </li>
      <li><defs><li>StandingLamp</li><li>TorchLamp</li></defs><role>light</role><pos>(4,0)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Hospital</defName>
    <group>Care</group>
    <avoid><li>Kitchen</li></avoid>
    <tips>
      <li>Hospital beds and sterile floors improve treatment and reduce infections.</li>
      <li>Build the hospital near the entrance, so the wounded don't have to be carried across the base.</li>
    </tips>
    <label>hospital</label>
    <description>Three beds along the back wall and a shelf for medicine. Set the beds to "medical" once built. A clean floor lowers infection risk.</description>
    <order>40</order>
    <size>(5,5)</size>
    <floors>
      <li>SterileTile</li>
    </floors>
    <things>
      <li>
        <defs><li>HospitalBed</li><li>Bed</li><li>Bedroll</li></defs>
        <role>bed</role>
        <pos>(0,4)</pos>
        <rot>South</rot>
        <optional>false</optional>
      </li>
      <li>
        <defs><li>HospitalBed</li><li>Bed</li><li>Bedroll</li></defs>
        <role>bed</role>
        <pos>(2,4)</pos>
        <rot>South</rot>
      </li>
      <li>
        <defs><li>HospitalBed</li><li>Bed</li><li>Bedroll</li></defs>
        <role>bed</role>
        <pos>(4,4)</pos>
        <rot>South</rot>
      </li>
      <li>
        <defs><li>Shelf</li></defs>
        <role>storage</role>
        <pos>(3,0)</pos>
      </li>
      <li><defs><li>StandingLamp</li><li>TorchLamp</li></defs><role>light</role><pos>(0,0)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Freezer</defName>
    <group>Food</group>
    <near><li>Kitchen</li></near>
    <tips>
      <li>[!lowtech] Set coolers to -10 °C so open doors and short power cuts don't thaw anything.</li>
      <li>[!lowtech] Coolers blow hot air out the back. Make sure that side faces outside or an open space, not another room.</li>
      <li>A double door (airlock) keeps the cold in when people walk in and out.</li>
    </tips>
    <label>freezer</label>
    <description>Cold storage: two coolers built into the back wall and shelves inside. The coolers' hot side should face outside; if a blueprint faces the wrong way, rotate it before it's built. A double door (an airlock) keeps the cold in even better.</description>
    <order>50</order>
    <size>(5,5)</size>
    <things>
      <li>
        <defs><li>Cooler</li></defs>
        <role>cooler</role>
        <inWall>true</inWall>
        <pos>(2,6)</pos>
        <optional>false</optional>
      </li>
      <li>
        <defs><li>Cooler</li></defs>
        <role>cooler</role>
        <inWall>true</inWall>
        <pos>(4,6)</pos>
      </li>
      <li><defs><li>Shelf</li></defs><role>storage</role><pos>(1,4)</pos><rot>South</rot></li>
      <li><defs><li>Shelf</li></defs><role>storage</role><pos>(4,4)</pos><rot>South</rot></li>
      <li><defs><li>Shelf</li></defs><role>storage</role><pos>(0,2)</pos></li>
      <li><defs><li>Shelf</li></defs><role>storage</role><pos>(3,2)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Storeroom</defName>
    <group>Food</group>
    <tips>
      <li>Items left outside deteriorate. A roofed storeroom keeps them in good condition.</li>
      <li>Shelves hold more per tile and items on them don't count as clutter.</li>
    </tips>
    <label>storeroom</label>
    <description>A roofed room lined with shelves, so materials stop deteriorating in the rain.</description>
    <order>51</order>
    <size>(6,5)</size>
    <things>
      <li>
        <defs><li>Shelf</li></defs>
        <role>storage</role>
        <pos>(1,4)</pos>
        <rot>South</rot>
        <optional>false</optional>
      </li>
      <li><defs><li>Shelf</li></defs><role>storage</role><pos>(3,4)</pos><rot>South</rot></li>
      <li><defs><li>Shelf</li></defs><role>storage</role><pos>(5,4)</pos><rot>South</rot></li>
      <li><defs><li>Shelf</li></defs><role>storage</role><pos>(0,2)</pos></li>
      <li><defs><li>Shelf</li></defs><role>storage</role><pos>(4,2)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Barn</defName>
    <group>Food</group>
    <avoid><li>Bedroom</li></avoid>
    <tips>
      <li>Animals sleep better in a barn and are protected from the weather.</li>
      <li>Haul hay and kibble into the barn so animals don't wander off to graze in winter.</li>
    </tips>
    <label>barn</label>
    <description>A sheltered room with sleeping places for the colony's animals.</description>
    <order>60</order>
    <size>(6,5)</size>
    <things>
      <li>
        <defs><li>AnimalBed</li><li>AnimalSleepingBox</li><li>AnimalSleepingSpot</li></defs>
        <role>animalbed</role>
        <pos>(0,4)</pos>
        <optional>false</optional>
      </li>
      <li><defs><li>AnimalBed</li><li>AnimalSleepingBox</li><li>AnimalSleepingSpot</li></defs><role>animalbed</role><pos>(2,4)</pos></li>
      <li><defs><li>AnimalBed</li><li>AnimalSleepingBox</li><li>AnimalSleepingSpot</li></defs><role>animalbed</role><pos>(4,4)</pos></li>
      <li><defs><li>AnimalBed</li><li>AnimalSleepingBox</li><li>AnimalSleepingSpot</li></defs><role>animalbed</role><pos>(0,2)</pos></li>
      <li><defs><li>AnimalBed</li><li>AnimalSleepingBox</li><li>AnimalSleepingSpot</li></defs><role>animalbed</role><pos>(5,2)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Greenhouse</defName>
    <group>Food</group>
    <tips>
      <li>Hydroponic basins grow fast but die quickly when the power fails. Keep batteries or a generator in reserve.</li>
      <li>Sun lamps switch off at night, when plants rest. One lamp covers a large area.</li>
    </tips>
    <keepPlants>true</keepPlants>
    <label>greenhouse</label>
    <description>Four hydroponics basins under a sun lamp, with a heat source for the cold months. It grows food in any season.</description>
    <order>61</order>
    <size>(7,5)</size>
    <things>
      <li>
        <defs><li>HydroponicsBasin</li></defs>
        <role>hydroponics</role>
        <pos>(0,2)</pos>
        <optional>false</optional>
      </li>
      <li><defs><li>HydroponicsBasin</li></defs><role>hydroponics</role><pos>(2,2)</pos></li>
      <li><defs><li>HydroponicsBasin</li></defs><role>hydroponics</role><pos>(4,2)</pos></li>
      <li><defs><li>HydroponicsBasin</li></defs><role>hydroponics</role><pos>(6,2)</pos></li>
      <li>
        <defs><li>SunLamp</li></defs>
        <pos>(3,2)</pos>
        <optional>false</optional>
      </li>
      <li>
        <defs><li>Heater</li></defs>
        <role>heater</role>
        <pos>(6,0)</pos>
      </li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

  <ColonyCouncil.RoomTemplateDef>
    <defName>Council_Crypt</defName>
    <group>Care</group>
    <avoid><li>DiningRoom</li><li>Kitchen</li></avoid>
    <tips>
      <li>A proper grave lets friends and family stop grieving.</li>
      <li>Sarcophagi are beautiful and count as art in a crypt; graves outside are cheaper.</li>
    </tips>
    <label>crypt</label>
    <description>A quiet room with three graves, so the dead rest indoors and their friends can visit.</description>
    <order>70</order>
    <size>(5,3)</size>
    <things>
      <li>
        <defs><li>Sarcophagus</li><li>Grave</li></defs>
        <role>grave</role>
        <pos>(0,1)</pos>
        <optional>false</optional>
      </li>
      <li><defs><li>Sarcophagus</li><li>Grave</li></defs><role>grave</role><pos>(2,1)</pos></li>
      <li><defs><li>Sarcophagus</li><li>Grave</li></defs><role>grave</role><pos>(4,1)</pos></li>
    </things>
  </ColonyCouncil.RoomTemplateDef>

</Defs>
