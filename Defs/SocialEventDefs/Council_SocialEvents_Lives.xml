<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Social events about secrets, vendettas, quirks and life goals.
    bKeepsSecretOfA: B keeps a secret A confided. sharedVendetta: both swore vengeance on {FACTION}.
    aHasQuirk: A has a quirk ({QUIRK}). aHasGoal: A is pursuing a life goal ({GOAL}).
  -->

  <ColonyCouncil.SocialEventDef>
    <defName>Council_SocLife_KnowingLook</defName>
    <label>a knowing look</label>
    <tone>warm</tone>
    <bKeepsSecretOfA>true</bKeepsSecretOfA>
    <texts>
      <li>When the talk came close to a sore subject, {B_nameDef} changed it smoothly, without a glance at {A_nameDef}.</li>
      <li>When the questions came {A_nameDef}'s way, {B_nameDef} stepped in and answered most of them.</li>
      <li>{B_nameDef} caught {A_nameDef}'s eye as the talk turned to where people came from, and steered it elsewhere.</li>
    </texts>
    <effects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Soc_HadMyBack</thought></li>
    </effects>
    <changeTie>Friends</changeTie>
    <change>4</change>
    <note>{B_nameDef} kept the secret</note>
  </ColonyCouncil.SocialEventDef>

  <ColonyCouncil.SocialEventDef>
    <defName>Council_SocLife_SecretStrain</defName>
    <label>a secret wearing thin</label>
    <tone>friction</tone>
    <weight>0.6</weight>
    <bKeepsSecretOfA>true</bKeepsSecretOfA>
    <maxOpinion>30</maxOpinion>
    <texts>
      <li>{B_nameDef} snapped at {A_nameDef} over nothing, muttering about "what I know," and {A_nameDef} went pale.</li>
      <li>{B_nameDef} told {A_nameDef}, under {B_possessive} breath, that keeping {A_possessive} secret was getting hard, in a voice that sounded like a warning.</li>
    </texts>
    <effects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Soc_Snubbed</thought></li>
    </effects>
    <changeTie>Rivals</changeTie>
    <change>5</change>
    <note>a secret wearing on them</note>
    <notable>true</notable>
  </ColonyCouncil.SocialEventDef>

  <ColonyCouncil.SocialEventDef>
    <defName>Council_SocLife_SharedHatred</defName>
    <label>a shared vow</label>
    <tone>warm</tone>
    <sharedVendetta>true</sharedVendetta>
    <texts>
      <li>{A_nameDef} and {B_nameDef} talked about {FACTION} in low voices and made each other a promise.</li>
      <li>{A_nameDef} counted off on {A_possessive} fingers what {FACTION} owes them, and {B_nameDef} added the ones {A_pronoun} had missed.</li>
    </texts>
    <effects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>AAndB</target><thought>Council_Soc_GoodTalk</thought></li>
    </effects>
    <changeTie>Comrades</changeTie>
    <change>8</change>
    <note>sworn against {FACTION} together</note>
  </ColonyCouncil.SocialEventDef>

  <ColonyCouncil.SocialEventDef>
    <defName>Council_SocLife_TeasedQuirk</defName>
    <label>teased about a quirk</label>
    <tone>friction</tone>
    <aHasQuirk>true</aHasQuirk>
    <maxOpinion>25</maxOpinion>
    <texts>
      <li>{B_nameDef} made fun of {A_nameDef}'s habit ({QUIRK}), and {A_nameDef} didn't laugh.</li>
      <li>{B_nameDef} did an impression of {A_nameDef} ({QUIRK}) for anyone who would watch.</li>
    </texts>
    <effects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Soc_Pranked</thought></li>
    </effects>
    <changeTie>Rivals</changeTie>
    <change>4</change>
    <note>mocked a quirk</note>
  </ColonyCouncil.SocialEventDef>

  <ColonyCouncil.SocialEventDef>
    <defName>Council_SocLife_SharedQuirk</defName>
    <label>a quirk shared</label>
    <tone>warm</tone>
    <aHasQuirk>true</aHasQuirk>
    <minOpinion>10</minOpinion>
    <texts>
      <li>{B_nameDef} asked {A_nameDef} about {A_possessive} habit ({QUIRK}), expecting a joke, and got a real story instead.</li>
      <li>{B_nameDef} caught {A_nameDef} at it ({QUIRK}) and, instead of laughing, joined in.</li>
      <li>{B_nameDef} told {A_nameDef} that {B_pronoun} understands it now ({QUIRK}), more than {B_pronoun} expected to.</li>
    </texts>
    <effects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>AAndB</target><thought>Council_Soc_GoodTalk</thought></li>
    </effects>
    <changeTie>Friends</changeTie>
    <change>5</change>
    <note>a quirk shared</note>
  </ColonyCouncil.SocialEventDef>

  <ColonyCouncil.SocialEventDef>
    <defName>Council_SocLife_GoalEncouraged</defName>
    <label>encouragement</label>
    <tone>warm</tone>
    <aHasGoal>true</aHasGoal>
    <minOpinion>15</minOpinion>
    <texts>
      <li>{A_nameDef} admitted to {B_nameDef} that {A_pronoun} wants to {GOAL}, and {B_nameDef} just said, "Then do it."</li>
      <li>{B_nameDef} asked {A_nameDef} how the plan to {GOAL} is coming along, and listened to the whole answer.</li>
      <li>{B_nameDef} told {A_nameDef} that if anyone here could {GOAL}, it was {A_objective}.</li>
    </texts>
    <effects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Soc_HadMyBack</thought></li>
      <li Class="ColonyCouncil.DilemmaEffect_Inspiration"><target>A</target><chance>0.1</chance></li>
    </effects>
    <changeTie>Friends</changeTie>
    <change>5</change>
    <note>believed in {A_nameDef}'s dream</note>
  </ColonyCouncil.SocialEventDef>

  <ColonyCouncil.SocialEventDef>
    <defName>Council_SocLife_GoalMocked</defName>
    <label>a dream mocked</label>
    <tone>friction</tone>
    <soreHours>24</soreHours>
    <weight>0.6</weight>
    <aHasGoal>true</aHasGoal>
    <maxOpinion>0</maxOpinion>
    <texts>
      <li>{B_nameDef} found out {A_nameDef} wants to {GOAL}, and laughed in {A_possessive} face.</li>
      <li>"You want to {GOAL}?" {B_nameDef} asked {A_nameDef}, loud enough to carry, and didn't wait for an answer.</li>
    </texts>
    <effects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Soc_Snubbed</thought></li>
    </effects>
    <changeTie>Rivals</changeTie>
    <change>7</change>
    <note>laughed at {A_nameDef}'s dream</note>
  </ColonyCouncil.SocialEventDef>

  <ColonyCouncil.SocialEventDef>
    <defName>Council_SocLife_GoalHelp</defName>
    <label>a helping hand</label>
    <tone>warm</tone>
    <aHasGoal>true</aHasGoal>
    <tie>Friends</tie>
    <minStrength>40</minStrength>
    <texts>
      <li>{B_nameDef} gave up {B_possessive} free time to help {A_nameDef}, who means to {GOAL} one day.</li>
      <li>{B_nameDef} offered to help {A_nameDef} with the plan to {GOAL}, and meant it.</li>
      <li>{B_nameDef} talked through the next step of {A_nameDef}'s plan to {GOAL} with {A_objective}, and wouldn't take thanks for it.</li>
    </texts>
    <effects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>A</target><thought>Council_Soc_Gift</thought></li>
    </effects>
    <changeTie>Friends</changeTie>
    <change>6</change>
    <note>helped with {A_nameDef}'s goal</note>
  </ColonyCouncil.SocialEventDef>

</Defs>
