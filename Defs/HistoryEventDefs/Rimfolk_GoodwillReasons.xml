<Defs>

  <!--
    The reasons Rimfolk gives the game for each change in a people's goodwill (World/GoodwillWhy.cs, named in
    World/GoodwillReasonMath.cs). The game's message ends with the label in brackets ("Relations with Stormriders have
    changed from 53 to 45 (a letter that slighted their god)."), and the Factions tab lists it among that people's recent
    events. No precept or other mod reads these; the faction memory's hooks skip them (each deed is noted by the code that
    made it). Labels in the game's own style: plain, lower case, what happened.
  -->

  <!-- Letters, word and the colony's name -->
  <HistoryEventDef><defName>Rimfolk_GW_Slight</defName><label>a letter that slighted their god</label></HistoryEventDef>
  <HistoryEventDef><defName>Rimfolk_GW_Letter</defName><label>the colony's letter to them</label></HistoryEventDef>
