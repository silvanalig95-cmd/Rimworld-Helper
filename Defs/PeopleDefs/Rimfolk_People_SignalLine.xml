        <options>
          <Rimfolk_SignalLine_Lineman>12</Rimfolk_SignalLine_Lineman>
          <Rimfolk_SignalLine_Operator>3</Rimfolk_SignalLine_Operator>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Rimfolk_SignalLine_Operator>12</Rimfolk_SignalLine_Operator>
          <Rimfolk_SignalLine_Lineman>8</Rimfolk_SignalLine_Lineman>
          <Rimfolk_SignalLine_RelayKeeper>1</Rimfolk_SignalLine_RelayKeeper>
          <Villager_Child MayRequire="Ludeon.RimWorld.Biotech">3</Villager_Child>
        </options>
      </li>
      <li>
        <!-- The wire-trader's mules: parts, wire, medicine and the line's own sets -->
        <kindDef>Trader</kindDef>
        <traders>
          <Rimfolk_SignalLine_WireTrader>1</Rimfolk_SignalLine_WireTrader>
        </traders>
        <carriers>
          <Muffalo>3</Muffalo>
          <Donkey>3</Donkey>
          <Horse>2</Horse>
        </carriers>
        <guards>
          <Rimfolk_SignalLine_Lineman>8</Rimfolk_SignalLine_Lineman>
          <Rimfolk_SignalLine_Operator>2</Rimfolk_SignalLine_Operator>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Rimfolk_SignalLine_Lineman>12</Rimfolk_SignalLine_Lineman>
          <Rimfolk_SignalLine_Operator>6</Rimfolk_SignalLine_Operator>
          <Rimfolk_SignalLine_RelayKeeper>2</Rimfolk_SignalLine_RelayKeeper>
          <Rimfolk_SignalLine_WireTrader>2</Rimfolk_SignalLine_WireTrader>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleExtension">
        <calling>linesmen</calling>
        <!-- Their age over the years (Peoples/PeopleAges.cs): everything the line hears of the world's new ways comes down it first, and they sell it on: to the spacer age, and soon. -->
        <agePace>8</agePace>
        <ageLimit>3</ageLimit>
        <townWord>relay</townWord>
        <townWords>relays</townWords>
        <head>relay-keeper</head>
        <heir>second keeper</heir>
        <envoy>lineman</envoy>
        <trader>wire-trader</trader>
        <courier>line-runner</courier>
        <couriers>line-runners</couriers>
        <caravanWeight>0.8</caravanWeight>
        <camps>
          <li>Council_Camp_Surveyors</li>
          <li>Rimfolk_Camp_Watchers</li>
          <li>Council_Camp_Smith</li>
        </camps>
        <plan>Rimfolk_Plan_LineRelay</plan>
        <honours>a mast kept singing, a message passed on true and a lineman back down safe</honours>
        <fears>silence on the line, a storm that takes a mast and news passed on wrong</fears>
        <sayings>
          <li>Every mast is a voice.</li>
          <li>A voice is a road nobody has to walk.</li>
          <li>Keep it singing.</li>
          <li>Say where you heard it.</li>
          <li>Silence is the only storm.</li>
        </sayings>
        <townGoods>
          <ComponentIndustrial>6~14</ComponentIndustrial>
          <Steel>80~180</Steel>
          <MedicineIndustrial>4~8</MedicineIndustrial>
          <Chemfuel>20~60</Chemfuel>
          <Cloth>20~50</Cloth>
        </townGoods>
        <herd>
          <li>Donkey</li>
        </herd>
        <herdCount>2~4</herdCount>
        <ariseAges>0~3</ariseAges>
      </li>
    </modExtensions>
  </FactionDef>

  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md, "Release F"): the linemen share one kit, the operators and families do
    not. A lineman wears the Line's oilskin (the game's duster) in signal orange over a collar shirt and trousers, a hard
    hat (Vanilla Apparel Expanded), and climbing gear: a tool belt or a pack (Vanilla Apparel Expanded - Accessories);
    rifles, the game's and Frontier's lever guns, and a component or a length of steel in the pack. In another age the kit
    takes the age's form (ageArms): an oiled poncho of hide (Vanilla Apparel Expanded) and a bow among the tribes, a waxed
    cape and a great bow in the medieval age, a charge rifle in the spacer age. Operators, clerks and families dress as
    they like, the game's and the mods' everyday clothes, around a cap or hat of signal orange; the relay-keepers and the
    chief lineman wear the oilskin over their own clothes. A share are crafters and intellectuals; a few are A RimWorld of
    Magic's technomancers and snipers, and with Royalty a few operators hear the psychic hum in the static (Staticlords).
    Without any mod: the game's duster, shirts, trousers, hats, rifles and pistols.
  -->
  <PawnKindDef Name="Rimfolk_SignalLineKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_SignalLine</defaultFactionDef>
    <chemicalAddictionChance>0.04</chemicalAddictionChance>
    <backstoryCryptosleepCommonality>0.01</backstoryCryptosleepCommonality>
    <invNutrition>2.55</invNutrition>
    <specificApparelRequirements>
      <!-- Signal orange on the oilskin, whoever wears one, and on the kit of the other ages. -->
      <li><apparelDef>Apparel_Duster</apparelDef><color>(0.88, 0.46, 0.14)</color></li>
      <li><apparelDef>Apparel_Cape</apparelDef><color>(0.88, 0.46, 0.14)</color></li>
      <li MayRequire="VanillaExpanded.VAPPE"><apparelDef>VAE_Apparel_TribalPoncho</apparelDef><color>(0.88, 0.46, 0.14)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

