  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md, "Release G"): the vault suit, a collar shirt and trousers of the one olive
    cloth with the vault's number on the back, on everyone, worn thin (low gear health); the security in recon armour over
    it, the overseer a jacket of the same olive, the scouts something for the weather over the suit. In a later, poorer age
    the suit is patched with whatever is at hand (ageArms): a duster or a parka in the industrial age, a cape in the
    medieval age; and the security take the age's issue: flak and rifles, then plate and spears. Without any mod: the
    game's shirts, trousers, jackets, recon armour, charge rifles and pistols, and the suit's olive.
  -->
  <PawnKindDef Name="Rimfolk_SunkenVaultKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_SunkenVault</defaultFactionDef>
    <chemicalAddictionChance>0.03</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <specificApparelRequirements>
      <!-- The vault suit in vault olive: the shirt and the trousers, and the overseer's jacket. -->
      <li><apparelDef>Apparel_CollarShirt</apparelDef><color>(0.42, 0.44, 0.28)</color></li>
      <li><apparelDef>Apparel_Pants</apparelDef><color>(0.42, 0.44, 0.28)</color></li>
      <li><apparelDef>Apparel_Jacket</apparelDef><color>(0.42, 0.44, 0.28)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

