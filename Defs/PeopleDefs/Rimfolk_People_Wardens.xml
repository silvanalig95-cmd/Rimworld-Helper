    </modExtensions>
  </FactionDef>

  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md, "Release D"): no uniform. Every Warden wears a hood dyed lantern red, its
    cord knotted for every beast felled (a hood, or with Vanilla Factions Expanded - Medieval 2 a chaperon or cap, in the
    same red); everything else is furs and oiled leather of every make, whatever the last hunt paid for (the game's
    tribalwear, parkas and pelts; Vanilla Apparel Expanded's pelt coats and ponchos; Vanilla Armour Expanded's gambesons
    and quilted vests; Tribals' war wraps). Their fighters share nothing but the hood, as the design has it: trackers
    with bows, crossbows (Vanilla Weapons Expanded, Medieval 2's arbalest) and a quiver; boar-spears with spears and
    pikes. A few are A RimWorld of Magic's rangers and snipers; the lantern-master may be a Wildspeaker (Vanilla Psycasts
    Expanded) or a ranger. In the industrial and spacer ages (a people of their ways that arose there) the trackers hunt
    with rifles. They carry pemmican, herbs or a spare hide. Without any mod: hoods, tribalwear and parkas, spears, clubs,
    bows and great bows.
  -->
  <PawnKindDef Name="Rimfolk_WardensKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_Wardens</defaultFactionDef>
    <chemicalAddictionChance>0.04</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <invFoodDef>Pemmican</invFoodDef>
    <maxGenerationAge>70</maxGenerationAge>
    <specificApparelRequirements>
      <!-- Lantern red on the hood, whichever it is. -->
      <li><apparelDef>Apparel_HatHood</apparelDef><color>(0.72, 0.18, 0.12)</color></li>
      <li MayRequire="OskarPotocki.VFE.Medieval2"><apparelDef>VFEM2_Apparel_Chaperon</apparelDef><color>(0.72, 0.18, 0.12)</color></li>
      <li MayRequire="OskarPotocki.VFE.Medieval2"><apparelDef>VFEM2_Apparel_Cap</apparelDef><color>(0.72, 0.18, 0.12)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

