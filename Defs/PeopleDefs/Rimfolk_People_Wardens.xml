        <ageLimit>2</ageLimit>
        <townWord>lodge</townWord>
        <townWords>lodges</townWords>
        <head>keeper of the book</head>
        <heir>under-keeper</heir>
        <envoy>tracker</envoy>
        <trader>pelt-buyer</trader>
