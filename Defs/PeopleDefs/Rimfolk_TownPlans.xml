<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The plans of Rimfolk's peoples' towns (Source/ColonyCouncil/Peoples/PeopleDefs.cs, TownPlanDef; PeopleTowns.cs places
    them when the game makes a town's map, where the land suits, with the code that places a town the colony was). Each
    row is a line of the town from the north; each character a key: a building (thing), what it is made of (stuff, or the
    town's wall material: wall), which way it faces (rot: a bed's head to the north is South), the floor under it, a roof,
    and what the cell is for (mark: store, the town's goods and loot; pen, its herd; plant:DEFNAME, a garden bed). An
    underscore is the ground as it is. A building larger than one cell is written once, at its origin (a bed facing South
    covers the cell below it, a 2 by 2 table the cells to its right and above), its other cells a floor of their own; the
    tests check every plan (Tools/Tests/PeoplesTests.cs). Only the base game's buildings, so every plan stands without the
    DLCs.
  -->

  <ColonyCouncil.TownPlanDef>
    <defName>Rimfolk_Plan_Waystation</defName>
    <label>waystation</label>
    <description>The road league's waystation: a walled yard with market stalls and a fire, rooms for travellers and the league's storehouse along its north side, the waymaster's hall, a wide gate to the road and pens for the caravans' beasts.</description>
    <wallStuff>
      <li>BlocksGranite</li>
      <li>WoodLog</li>
    </wallStuff>
    <keys>
      <li><key>#</key><thing>Wall</thing><wall>true</wall></li>
      <li><key>D</key><thing>Door</thing><wall>true</wall></li>
      <li><key>.</key><floor>WoodPlankFloor</floor><roof>true</roof></li>
      <li><key>b</key><thing>Bed</thing><stuff>WoodLog</stuff><rot>South</rot><floor>WoodPlankFloor</floor><roof>true</roof></li>
      <li><key>L</key><thing>TorchLamp</thing><floor>WoodPlankFloor</floor><roof>true</roof></li>
      <li><key>T</key><thing>Table2x2c</thing><stuff>WoodLog</stuff><floor>WoodPlankFloor</floor><roof>true</roof></li>
      <li><key>s</key><thing>Stool</thing><stuff>WoodLog</stuff><floor>WoodPlankFloor</floor><roof>true</roof></li>
      <li><key>x</key><floor>WoodPlankFloor</floor><roof>true</roof><mark>store</mark></li>
      <li><key>S</key><thing>ShelfSmall</thing><stuff>WoodLog</stuff><floor>WoodPlankFloor</floor><roof>true</roof><mark>store</mark></li>
      <li><key>,</key><floor>FlagstoneGranite</floor></li>
      <li><key>l</key><thing>TorchLamp</thing><floor>FlagstoneGranite</floor></li>
      <li><key>1</key><thing>Table1x2c</thing><stuff>WoodLog</stuff><floor>FlagstoneGranite</floor></li>
      <li><key>F</key><thing>Campfire</thing><floor>FlagstoneGranite</floor></li>
      <li><key>f</key><thing>Fence</thing><stuff>WoodLog</stuff></li>
      <li><key>g</key><thing>FenceGate</thing><stuff>WoodLog</stuff></li>
      <li><key>p</key><mark>pen</mark></li>
      <li><key>a</key><thing>AnimalSleepingSpot</thing><mark>pen</mark></li>
    </keys>
    <rows>
      <li>#################################</li>
      <li>#b.b.b.#b.b.b.#xxxxxx#..........#</li>
      <li>#......#......#xxxxxx#.T...L.T..#</li>
      <li>#L.....#L.....#SSxSSx#.ss....ss.#</li>
      <li>###D######D######D######D########</li>
      <li>#,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#</li>
      <li>#,,1,,1,,,,,,,,,,,,,,,,,,1,,1,,,#</li>
      <li>#,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#</li>
      <li>#,l,,,,,,,,,,,,F,,,,,,,,,,,,,,l,#</li>
      <li>#,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#</li>
      <li>#,,1,,1,,,,,,,,,,,,,,,,,,1,,1,,,#</li>
      <li>#,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#</li>
