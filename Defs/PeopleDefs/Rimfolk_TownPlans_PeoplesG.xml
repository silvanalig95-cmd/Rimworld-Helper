<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The town plans of release G's peoples (Defs/PeopleDefs/Rimfolk_People_HelixWorks.xml, _Lattice.xml, _Choir.xml,
    _SunkenVault.xml; docs/design/peoples.md, "Release G"), laid by the same code as the others (Peoples/PeopleTowns.cs),
    only the base game's buildings so they stand without any DLC: the Helix Works' gene lab with its benches, the vat
    hall's cradles and a quiet garden; the Lattice's charging yards with the control tower, the gestation hall's benches
    and the batteries under the turrets; the Choir of the Spire's ring of quiet halls round a pale monolith; the Sunken
    Vault's door in the hillside, the vault behind it and a surface camp growing round it. Rows from the north; an
    underscore is the ground as it is.
  -->

  <ColonyCouncil.TownPlanDef>
    <defName>Rimfolk_Plan_HelixLab</defName>
    <label>Helix Works&apos; lab</label>
    <description>The Helix Works' gene lab: a sterile hall with two research benches where the sequencers work and the vat hall's cradles where the newly grown wake, the Works' stores of medicine, a house of quarters with its table, and a quiet garden of roses round two willows where the editors walk between edits.</description>
    <wallStuff>
      <li>Steel</li>
      <li>Plasteel</li>
      <li>BlocksMarble</li>
    </wallStuff>
    <keys>
      <li><key>#</key><thing>Wall</thing><wall>true</wall></li>
      <li><key>D</key><thing>Door</thing><wall>true</wall></li>
      <li><key>,</key><floor>SterileTile</floor><roof>true</roof></li>
      <li><key>R</key><thing>HiTechResearchBench</thing><stuff>Steel</stuff><floor>SterileTile</floor><roof>true</roof></li>
      <li><key>H</key><thing>HospitalBed</thing><stuff>Steel</stuff><rot>South</rot><floor>SterileTile</floor><roof>true</roof></li>
