      <li MayRequire="Ludeon.RimWorld.Anomaly"><apparelDef>Apparel_LabCoat</apparelDef><color>(0.80, 0.93, 0.88)</color></li>
      <li MayRequire="VanillaExpanded.VAPPE"><apparelDef>VAE_Apparel_LabCoat</apparelDef><color>(0.80, 0.93, 0.88)</color></li>
      <li><apparelDef>Apparel_ArmorRecon</apparelDef><color>(0.80, 0.93, 0.88)</color></li>
      <li><apparelDef>Apparel_ArmorHelmetRecon</apparelDef><color>(0.80, 0.93, 0.88)</color></li>
