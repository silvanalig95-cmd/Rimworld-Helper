<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The spacer enclave (docs/design/peoples.md, "Release C"; DESIGN.md "Rimfolk's peoples"; Source/ColonyCouncil/Peoples/):
    high-tech brokers who live on the planet between its towns and the ships above, buying from the one and selling to
    the other. Spacer, on the game's outlander parent: plain clothes and jackets dyed pale cyan, marshals in recon armour
    with charge rifles, a few bionics. Very few towns (settlementGenerationWeight 0.3), each a market round a landing pad
    (TownPlanDef Rimfolk_Plan_LandingMarket). Their caravans walk with pack beasts as the Empire's do, less often than
    another people's (caravanWeight 0.7); for an industrial or spacer colony their factor asks by radio for leave to come
    down by the gate with goods, and comes by drop pod when bidden (Rimfolk_Evt_EnclaveLander). Busy orbital lanes and a
    ship come down come from them likeliest (Patches/Rimfolk_PeoplesC.xml). They defend their markets and raid only when
    the colony has turned them hostile (raidCommonalityFromPointsCurve 0.15: few, and well armed). Listed once among the
    world's peoples when a world is made, never required. Faith (Ideology): a fixed creed of the body improved (VE Memes'
    trader where loaded), the techist style. Kind of people (Biotech): hussars, genies and highmates among them, and
    Odyssey's starjacks.
  -->

  <FactionDef ParentName="OutlanderFactionBase">
    <defName>Rimfolk_Enclave</defName>
    <label>spacer enclave</label>
    <description>An enclave of brokers who live between the planet's towns and the ships above it, buying from the one and selling to the other. They keep a few markets round their landing pads and come down by drop pod wherever there is trade to be had, with goods most towns have only heard of.\n\nThey are polite, exact and very well armed, and their marshals wear the armour of another world. Each market is run by its pad master, and the enclave by the chair of the exchange.</description>
    <pawnSingular>broker</pawnSingular>
    <pawnsPlural>brokers</pawnsPlural>
    <leaderTitle>chair of the exchange</leaderTitle>
    <techLevel>Spacer</techLevel>
    <basicMemberKind>Rimfolk_Enclave_Hand</basicMemberKind>
    <factionNameMaker>Rimfolk_Namer_Enclave</factionNameMaker>
    <settlementNameMaker>Rimfolk_Namer_EnclaveTown</settlementNameMaker>
    <factionIconPath>ColonyCouncil/Peoples/Enclave</factionIconPath>
    <settlementTexturePath>ColonyCouncil/Peoples/EnclaveTown</settlementTexturePath>
    <colorSpectrum>
      <li>(0.50, 0.74, 0.82)</li>
      <li>(0.76, 0.92, 0.96)</li>
    </colorSpectrum>
    <hidden>false</hidden>
    <naturalEnemy>false</naturalEnemy>
    <permanentEnemy>false</permanentEnemy>
    <canSiege>false</canSiege>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>17</configurationListOrderPriority>
    <settlementGenerationWeight>0.3</settlementGenerationWeight>
    <backstoryFilters Inherit="False">
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
        <commonality>0.6</commonality>
      </li>
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
        <commonality>0.4</commonality>
      </li>
    </backstoryFilters>
    <raidCommonalityFromPointsCurve Inherit="False">
      <points>
        <li>(0, 0.15)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <Hussar MayRequire="Ludeon.RimWorld.Biotech">0.03</Hussar>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.04</Genie>
        <Highmate MayRequire="Ludeon.RimWorld.Biotech">0.04</Highmate>
        <Starjack MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">0.04</Starjack>
      </xenotypeChances>
    </xenotypeSet>
    <fixedIdeo>true</fixedIdeo>
    <ideoName>The Exchange</ideoName>
    <ideoDescription>Everything has a price, and a fair price is the closest thing to justice the stars allow. The body is a tool to be kept sharp and made better, a bargain once struck is kept to the last digit, and the ships above and the towns below are both the enclave's to serve.</ideoDescription>
    <forcedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_Trader</li>
    </forcedMemes>
    <structureMemeWeights Inherit="False">
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">3</Structure_Ideological>
      <Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Archist>
    </structureMemeWeights>
    <styles>
      <li MayRequire="Ludeon.RimWorld.Ideology">Techist</li>
    </styles>
    <caravanTraderKinds Inherit="False">
      <li>Rimfolk_Caravan_Enclave_Goods</li>
      <li>Rimfolk_Caravan_Enclave_Exotic</li>
    </caravanTraderKinds>
    <visitorTraderKinds Inherit="False">
      <li>Rimfolk_Visitor_Enclave</li>
    </visitorTraderKinds>
    <baseTraderKinds Inherit="False">
      <li>Rimfolk_Base_Enclave</li>
    </baseTraderKinds>
    <pawnGroupMakers Inherit="False">
      <li>
        <!-- A fight: the enclave's marshals, and hired guns -->
        <kindDef>Combat</kindDef>
        <options>
          <Rimfolk_Enclave_Marshal>10</Rimfolk_Enclave_Marshal>
          <Mercenary_Gunner>4</Mercenary_Gunner>
          <Rimfolk_Enclave_Hand>2</Rimfolk_Enclave_Hand>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Rimfolk_Enclave_Hand>20</Rimfolk_Enclave_Hand>
          <Villager_Child MayRequire="Ludeon.RimWorld.Biotech">3</Villager_Child>
          <Rimfolk_Enclave_Marshal>6</Rimfolk_Enclave_Marshal>
          <Rimfolk_Enclave_Factor>3</Rimfolk_Enclave_Factor>
        </options>
      </li>
      <li>
        <!-- A caravan on the ground: a factor, pack beasts for the crates, marshals; the lander takes the factor and marshals only -->
        <kindDef>Trader</kindDef>
        <traders>
          <Rimfolk_Enclave_Factor>1</Rimfolk_Enclave_Factor>
        </traders>
        <carriers>
          <Muffalo>5</Muffalo>
          <Dromedary>4</Dromedary>
          <Horse>3</Horse>
          <Alpaca>2</Alpaca>
        </carriers>
        <guards>
          <Rimfolk_Enclave_Marshal>10</Rimfolk_Enclave_Marshal>
          <Mercenary_Gunner>3</Mercenary_Gunner>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Rimfolk_Enclave_Marshal>10</Rimfolk_Enclave_Marshal>
          <Mercenary_Gunner>4</Mercenary_Gunner>
          <Rimfolk_Enclave_Hand>8</Rimfolk_Enclave_Hand>
          <Rimfolk_Enclave_Factor>2</Rimfolk_Enclave_Factor>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleExtension">
        <calling>brokers</calling>
        <townWord>market</townWord>
        <townWords>markets</townWords>
        <head>pad master</head>
        <heir>second pad master</heir>
        <envoy>enclave factor</envoy>
        <trader>factor</trader>
        <courier>runner</courier>
        <couriers>runners</couriers>
        <caravanWeight>0.7</caravanWeight>
        <camps>
          <li>Council_Camp_FarMerchants</li>
          <li>Rimfolk_Camp_Spacers</li>
          <li>Rimfolk_Camp_Salvagers</li>
          <li>Council_Camp_Market</li>
        </camps>
        <plan>Rimfolk_Plan_LandingMarket</plan>
        <townGoods>
          <ComponentIndustrial>8~16</ComponentIndustrial>
          <ComponentSpacer>1~3</ComponentSpacer>
          <Plasteel>40~100</Plasteel>
          <MedicineIndustrial>6~12</MedicineIndustrial>
          <Chocolate>20~40</Chocolate>
          <Silver>300~700</Silver>
        </townGoods>
      </li>
    </modExtensions>
  </FactionDef>

