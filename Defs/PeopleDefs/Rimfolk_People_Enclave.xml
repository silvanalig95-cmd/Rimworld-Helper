    <label>enclave hand</label>
    <combatPower>45</combatPower>
    <isFighter>false</isFighter>
    <itemQuality>Normal</itemQuality>
    <gearHealthRange>0.8~1.6</gearHealthRange>
    <specificApparelRequirements>
      <!-- The enclave's pale cyan coat, of any cut. -->
      <li>
        <apparelLayer>Shell</apparelLayer>
        <bodyPartGroup>Torso</bodyPartGroup>
        <color>(0.66, 0.84, 0.90)</color>
        <alternateTagChoices>
          <li><tag>IndustrialAdvanced</tag><chance>1</chance></li>
        </alternateTagChoices>
      </li>
    </specificApparelRequirements>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialAdvanced</li>
      <li MayRequire="VanillaExpanded.VAEAccessories">VAEA_Utility_Industrial</li>
      <li MayRequire="Rimsenal.Spacer">Spacer</li>
      <li MayRequire="Rimsenal.Spacer">DataGlasses</li>
    </apparelTags>
    <!-- A pack, a tool belt or a medic's bag, never a soldier's belt, turret pack, ammo pack or battle banner. -->
    <apparelDisallowTags>
      <li>IndustrialMilitaryBasic</li>
      <li>IndustrialMilitaryAdvanced</li>
      <li>BeltDefensePop</li>
      <li>MedievalMilitary</li>
      <li MayRequire="VanillaExpanded.VAEAccessories">VAEA_AmmoPack</li>
    </apparelDisallowTags>
    <apparelAllowHeadgearChance>0.3</apparelAllowHeadgearChance>
    <apparelMoney>400~800</apparelMoney>
    <weaponTags>
      <li>SimpleGun</li>
    </weaponTags>
    <weaponMoney>150~320</weaponMoney>
    <inventoryOptions>
      <skipChance>0.4</skipChance>
      <subOptionsChooseOne>
        <li><thingDef>ComponentIndustrial</thingDef><countRange>1~2</countRange></li>
        <li><thingDef>Chemfuel</thingDef><countRange>5~12</countRange></li>
        <li><thingDef>MedicineIndustrial</thingDef><countRange>1~1</countRange></li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <initialWillRange>2~4</initialWillRange>
    <initialResistanceRange>12~20</initialResistanceRange>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleKindExtension">
        <gifts>
          <li><trait>Technomancer</trait><chance>0.04</chance></li>
          <li>
            <psylink>1~1</psylink>
            <paths>
              <li>VPE_Skipmaster</li>
              <li>VPE_Empath</li>
            </paths>
            <chance>0.03</chance>
          </li>
          <li>
            <genes>
              <li>Immunity_Strong</li>
            </genes>
            <chance>0.04</chance>
          </li>
        </gifts>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="Rimfolk_EnclaveKindBase">
