  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md "Their gear, their kinds of people and their gifts"): pilgrims come from
    everywhere and vary freely around their signature, a travelling cloak dyed sage, whether a cape, a robe or (Vanilla
    Factions Expanded - Medieval 2) a mantle, worn old or new; the fellowship's wide cone hats (Ideology) on its pilgrims
    and keeper, hoods and caps (Medieval 2) on the rest or none. The wardens of the way are its guards and wear one kit:
    a helmet, the sage cape, padding (Vanilla Armour Expanded), with spears, pikes (Medieval 2) and the game's axes; its
    archers a quiver (Vanilla Apparel Expanded - Accessories). Pilgrims carry a book of the road or herbs. A few are A
    RimWorld of Magic's priests (the keeper), wanderers and minstrels (pilgrims), paladins (wardens) or rangers (archers).
    Without any mod: capes, robes and hoods, the game's shirts and trousers, helmets, clubs, knives, spears and bows.
  -->
  <PawnKindDef Name="Rimfolk_PilgrimsKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_Pilgrims</defaultFactionDef>
    <chemicalAddictionChance>0.02</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <invFoodDef>Pemmican</invFoodDef>
    <maxGenerationAge>75</maxGenerationAge>
    <specificApparelRequirements>
      <!-- Sage on the travelling cloak, whichever it is. -->
      <li><apparelDef>Apparel_Cape</apparelDef><color>(0.56, 0.62, 0.50)</color></li>
      <li><apparelDef>Apparel_Robe</apparelDef><color>(0.56, 0.62, 0.50)</color></li>
      <li MayRequire="Ludeon.RimWorld.Royalty"><apparelDef>Apparel_RobeRoyal</apparelDef><color>(0.56, 0.62, 0.50)</color></li>
      <li MayRequire="OskarPotocki.VFE.Medieval2"><apparelDef>VFEM2_Apparel_Mantle</apparelDef><color>(0.56, 0.62, 0.50)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

