<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The pilgrim fellowship (docs/design/peoples.md, "Release C"; DESIGN.md "Rimfolk's peoples"; Source/ColonyCouncil/Peoples/):
    wandering faithful who walk the long roads between holy places and keep hostels at the shrines for anyone on the
    road. Medieval, on the game's tribal parent: capes over plain clothes dyed sage grey, wide cone hats (Ideology),
    wardens of the way with spears and short bows. Few towns (settlementGenerationWeight 0.5), each a shrine and its
    hostel (TownPlanDef Rimfolk_Plan_ShrineHostel); small caravans, a chandler's string of pack beasts, less often than
    another people's (caravanWeight 0.6). At dusk a band of them asks the colony for a night's shelter
    (Rimfolk_Evt_PilgrimShelter); in a holy year their hostel asks for food for the road (Rimfolk_Mission_HostelBread);
    hungry pilgrims, pilgrims to a relic or an anima tree, the great pilgrimage, the holy year and the prophet on the roads
    come from them likeliest (Patches/Rimfolk_PeoplesC.xml). They defend their hostels and raid only when the colony has
    turned them hostile (raidCommonalityFromPointsCurve 0.2). Listed once among the world's peoples when a world is made,
    never required. Faith (Ideology): a fixed creed of the road and of carrying the faith (VE Memes' nomad where loaded),
    the Buddhist style. Kind of people (Biotech): every kind walks with them, a few of each.
  -->

  <FactionDef ParentName="TribeBase">
    <defName>Rimfolk_Pilgrims</defName>
    <label>pilgrim fellowship</label>
    <description>A fellowship of wandering faithful who walk the long roads between holy places: old shrines, the graves of the good, springs and stones the faith remembers. They keep a hostel at each shrine for anyone on the road, and wherever they come to a door at dusk they ask for a night's shelter.\n\nThe wardens of the way walk with every band, with spear and bow, but the fellowship is quick to bless and slow to anger. Each hostel is kept by its hosteller, and the fellowship by the keeper of the shrines.</description>
    <pawnSingular>pilgrim</pawnSingular>
    <pawnsPlural>pilgrims</pawnsPlural>
    <leaderTitle>keeper of the shrines</leaderTitle>
    <techLevel>Medieval</techLevel>
    <basicMemberKind>Rimfolk_Pilgrims_Pilgrim</basicMemberKind>
    <factionNameMaker>Rimfolk_Namer_Pilgrims</factionNameMaker>
    <settlementNameMaker>Rimfolk_Namer_PilgrimsTown</settlementNameMaker>
    <factionIconPath>ColonyCouncil/Peoples/Pilgrims</factionIconPath>
    <settlementTexturePath>ColonyCouncil/Peoples/PilgrimsTown</settlementTexturePath>
    <colorSpectrum>
      <li>(0.46, 0.52, 0.40)</li>
      <li>(0.68, 0.74, 0.62)</li>
    </colorSpectrum>
    <hidden>false</hidden>
    <naturalEnemy>false</naturalEnemy>
    <permanentEnemy>false</permanentEnemy>
    <canSiege>false</canSiege>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>37</configurationListOrderPriority>
    <settlementGenerationWeight>0.5</settlementGenerationWeight>
    <allowedCultures Inherit="False">
      <li>Rustican</li>
    </allowedCultures>
    <backstoryFilters Inherit="False">
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
        <commonality>0.6</commonality>
      </li>
      <li>
        <categories>
          <li>Tribal</li>
        </categories>
        <commonality>0.4</commonality>
      </li>
    </backstoryFilters>
    <raidCommonalityFromPointsCurve Inherit="False">
      <points>
        <li>(0, 0.2)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <Hussar MayRequire="Ludeon.RimWorld.Biotech">0.02</Hussar>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.02</Genie>
        <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0.02</Neanderthal>
        <Impid MayRequire="Ludeon.RimWorld.Biotech">0.02</Impid>
        <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0.02</Pigskin>
      </xenotypeChances>
    </xenotypeSet>
    <fixedIdeo>true</fixedIdeo>
    <ideoName>The Pilgrim's Way</ideoName>
    <ideoDescription>The faith is carried on foot. A pilgrim walks from shrine to shrine as those before walked, asks for shelter at any door and blesses the house that gives it, and keeps a hostel open for whoever walks the road behind. What is holy is not kept behind walls: it is visited, and told of on the way.</ideoDescription>
    <forcedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Proselytizer</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_Nomad</li>
    </forcedMemes>
    <structureMemeWeights Inherit="False">
      <Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">2</Structure_TheistEmbodied>
      <Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">2</Structure_TheistAbstract>
      <Structure_OriginBuddhist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginBuddhist>
    </structureMemeWeights>
    <styles>
      <li MayRequire="Ludeon.RimWorld.Ideology">Buddhist</li>
    </styles>
    <caravanTraderKinds Inherit="False">
      <li>Rimfolk_Caravan_Pilgrims</li>
    </caravanTraderKinds>
    <visitorTraderKinds Inherit="False">
      <li>Rimfolk_Visitor_Pilgrims</li>
    </visitorTraderKinds>
    <baseTraderKinds Inherit="False">
      <li>Rimfolk_Base_Pilgrims</li>
    </baseTraderKinds>
    <pawnGroupMakers Inherit="False">
      <li>
        <!-- A fight: the wardens of the way, with spears and short bows -->
        <kindDef>Combat</kindDef>
        <options>
          <Rimfolk_Pilgrims_Warden>10</Rimfolk_Pilgrims_Warden>
          <Rimfolk_Pilgrims_Bowman>8</Rimfolk_Pilgrims_Bowman>
          <Rimfolk_Pilgrims_Pilgrim>2</Rimfolk_Pilgrims_Pilgrim>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Rimfolk_Pilgrims_Pilgrim>24</Rimfolk_Pilgrims_Pilgrim>
          <Villager_Child MayRequire="Ludeon.RimWorld.Biotech">3</Villager_Child>
          <Rimfolk_Pilgrims_Warden>6</Rimfolk_Pilgrims_Warden>
        </options>
      </li>
      <li>
        <!-- A chandler's string: candles, tokens and plain goods on a few pack beasts, a warden or two -->
        <kindDef>Trader</kindDef>
        <traders>
          <Rimfolk_Pilgrims_Chandler>1</Rimfolk_Pilgrims_Chandler>
        </traders>
        <carriers>
          <Donkey>5</Donkey>
          <Alpaca>3</Alpaca>
          <Dromedary>2</Dromedary>
          <Horse>2</Horse>
        </carriers>
        <guards>
          <Rimfolk_Pilgrims_Warden>8</Rimfolk_Pilgrims_Warden>
          <Rimfolk_Pilgrims_Bowman>6</Rimfolk_Pilgrims_Bowman>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Rimfolk_Pilgrims_Warden>10</Rimfolk_Pilgrims_Warden>
          <Rimfolk_Pilgrims_Bowman>8</Rimfolk_Pilgrims_Bowman>
          <Rimfolk_Pilgrims_Pilgrim>10</Rimfolk_Pilgrims_Pilgrim>
          <Rimfolk_Pilgrims_Chandler>2</Rimfolk_Pilgrims_Chandler>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleExtension">
        <calling>pilgrims</calling>
        <townWord>hostel</townWord>
        <townWords>hostels</townWords>
        <head>hosteller</head>
        <heir>under-hosteller</heir>
        <envoy>palmer</envoy>
        <trader>chandler</trader>
        <courier>palmer</courier>
        <couriers>palmers</couriers>
        <caravanWeight>0.6</caravanWeight>
        <camps>
          <li>Council_Camp_Pilgrims</li>
          <li>Council_Camp_Procession</li>
          <li>Council_Camp_Penitents</li>
          <li>Council_Camp_Mourners</li>
        </camps>
        <plan>Rimfolk_Plan_ShrineHostel</plan>
        <townGoods>
          <Pemmican>60~120</Pemmican>
          <MedicineHerbal>8~16</MedicineHerbal>
          <Cloth>40~90</Cloth>
          <WoodLog>60~120</WoodLog>
          <Beer>10~25</Beer>
        </townGoods>
        <ariseAges>1~3</ariseAges>
      </li>
    </modExtensions>
  </FactionDef>

  <!-- ===================== Their people ===================== -->

