  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md "Their gear, their kinds of people and their gifts"): the league's
    wayfarers, factors and master vary freely around their signature, an outer coat dyed teal of whatever cut (a duster,
    a jacket, Vanilla Apparel Expanded's suit jackets and coats), and dress below it as travelling folk do: the game's
    industrial clothes and the mods' (Vanilla Apparel Expanded's boots, scarves and hats, Vanilla Factions Expanded -
    Settlers' bandanas, sombreros and vests, a fez from Vanilla Ideology Expanded - Hats and Rags), a pack, a tool belt or a
    medic's bag (Vanilla Apparel Expanded - Accessories, never its soldiers' belts), the factor's bowler, the master's top
    hat and Royalty's finery. Their caravan guards and outriders are hired soldiers in the league's one kit: the teal duster,
    a cowboy hat and a flak vest (the outriders in a helmet and flak trousers too, with Vanilla Weapons Expanded - Grenades'
    belts and a lasso with Melee Animation), an ammo pack (Accessories), the game's guns and the mods' under its tags
    (Vanilla Weapons Expanded and its Quickdraw, Rimsenal's, Advanced Armaments') and Vanilla Weapons Expanded - Frontier's
    revolvers, lever-action shotguns and rolling-block rifles. Wayfarers carry beer, cloth or a little silver to trade,
    with Medieval 2 a bottle of wine, with Odyssey now and then a map. A few are A RimWorld of Magic's wayfarers and bards
    (wayfarers), sharpshooters (outriders), gladiators (guards) or a commander (the league master). Without any mod:
    dusters, jackets, the game's shirts, trousers and hats, its guns.
  -->
  <PawnKindDef Name="Rimfolk_LeagueKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_League</defaultFactionDef>
    <chemicalAddictionChance>0.03</chemicalAddictionChance>
    <backstoryCryptosleepCommonality>0.02</backstoryCryptosleepCommonality>
    <invNutrition>2.55</invNutrition>
    <specificApparelRequirements>
      <!-- Teal on the duster, whoever wears one. -->
      <li><apparelDef>Apparel_Duster</apparelDef><color>(0.24, 0.58, 0.60)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

  <PawnKindDef ParentName="Rimfolk_LeagueKindBase">
    <defName>Rimfolk_League_Wayfarer</defName>
    <label>wayfarer</label>
    <combatPower>45</combatPower>
    <isFighter>false</isFighter>
    <itemQuality>Normal</itemQuality>
    <gearHealthRange>0.6~1.6</gearHealthRange>
    <specificApparelRequirements>
      <!-- The league's teal coat, of any cut. -->
      <li>
        <apparelLayer>Shell</apparelLayer>
        <bodyPartGroup>Torso</bodyPartGroup>
        <color>(0.24, 0.58, 0.60)</color>
        <alternateTagChoices>
          <li><tag>IndustrialAdvanced</tag><chance>1</chance></li>
        </alternateTagChoices>
      </li>
    </specificApparelRequirements>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialAdvanced</li>
      <li>Western</li>
      <li MayRequire="OskarPotocki.VanillaFactionsExpanded.SettlersModule">Outlander</li>
      <li>Rimfolk_Fez</li>
      <li MayRequire="VanillaExpanded.VAEAccessories">VAEA_Utility_Industrial</li>
    </apparelTags>
    <!-- A pack, a tool belt or a medic's bag, never a soldier's belt, ammo pack or battle banner. -->
    <apparelDisallowTags>
      <li>IndustrialMilitaryBasic</li>
      <li>IndustrialMilitaryAdvanced</li>
      <li>BeltDefensePop</li>
      <li>MedievalMilitary</li>
      <li MayRequire="VanillaExpanded.VAEAccessories">VAEA_AmmoPack</li>
    </apparelDisallowTags>
    <apparelAllowHeadgearChance>0.6</apparelAllowHeadgearChance>
    <apparelMoney>300~650</apparelMoney>
    <weaponTags>
      <li>SimpleGun</li>
      <li MayRequire="VanillaExpanded.VWEFT">FrontierGunSimple</li>
    </weaponTags>
    <weaponMoney>100~280</weaponMoney>
    <!-- Something of their own to trade on the road; with Medieval 2 a bottle of wine, with Odyssey now and then a map. -->
    <inventoryOptions>
      <skipChance>0.4</skipChance>
      <subOptionsChooseOne>
        <li><thingDef>Beer</thingDef><countRange>1~3</countRange></li>
        <li><thingDef>Cloth</thingDef><countRange>6~15</countRange></li>
        <li><thingDef>Silver</thingDef><countRange>8~30</countRange></li>
        <li MayRequire="OskarPotocki.VFE.Medieval2"><thingDef>VFEM2_Wine</thingDef><countRange>1~2</countRange></li>
        <li MayRequire="Ludeon.RimWorld.Odyssey"><thingDef>Map</thingDef><countRange>1~1</countRange><choiceChance>0.3</choiceChance></li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <initialWillRange>1~3</initialWillRange>
    <initialResistanceRange>10~17</initialResistanceRange>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleKindExtension">
        <gifts>
          <li><trait>TM_Wayfarer</trait><chance>0.03</chance></li>
          <li><trait>TM_Bard</trait><chance>0.02</chance></li>
        </gifts>
      </li>
    </modExtensions>
  </PawnKindDef>

