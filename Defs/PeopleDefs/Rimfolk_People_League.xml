        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleExtension">
        <calling>traders</calling>
        <townWord>waystation</townWord>
        <townWords>waystations</townWords>
        <head>waymaster</head>
        <heir>second waymaster</heir>
        <envoy>league factor</envoy>
        <trader>caravan master</trader>
        <courier>road rider</courier>
        <couriers>road riders</couriers>
        <caravanWeight>3</caravanWeight>
        <camps>
          <li>Council_Camp_Market</li>
          <li>Council_Camp_SaltCaravan</li>
          <li>Council_Camp_FarMerchants</li>
          <li>Council_Camp_Wardens</li>
        </camps>
        <plan>Rimfolk_Plan_Waystation</plan>
        <honours>the word given at a waystone, a fair price and a caravan home whole</honours>
        <fears>the robber, the broken word and a road nobody keeps</fears>
        <sayings>
          <li>Every crate home.</li>
          <li>A word given at the waystone stands.</li>
          <li>Good ink or red ink.</li>
          <li>The road won't wait.</li>
        </sayings>
        <townGoods>
          <Cloth>80~160</Cloth>
          <Steel>60~140</Steel>
          <ComponentIndustrial>4~10</ComponentIndustrial>
          <MedicineIndustrial>3~8</MedicineIndustrial>
          <Chocolate>10~30</Chocolate>
          <Silver>150~400</Silver>
        </townGoods>
        <herd>
          <li>Muffalo</li>
          <li>Dromedary</li>
