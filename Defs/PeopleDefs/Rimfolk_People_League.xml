          <Mercenary_Gunner>2</Mercenary_Gunner>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Rimfolk_League_Guard>10</Rimfolk_League_Guard>
          <Rimfolk_League_Outrider>5</Rimfolk_League_Outrider>
          <Rimfolk_League_Wayfarer>8</Rimfolk_League_Wayfarer>
          <Rimfolk_League_Factor>2</Rimfolk_League_Factor>
        </options>
      </li>
      <li MayRequire="Ludeon.RimWorld.Ideology">
        <kindDef>Miners</kindDef>
