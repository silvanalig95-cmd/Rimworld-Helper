        </gifts>
        <!-- In the industrial age they keep spear and shield (the shield is held in the left hand, so no rifle), with a belt
             of frag grenades (Vanilla Weapons Expanded - Grenades) to throw before they close in. -->
        <ageArms>
          <li>
            <ages>2~2</ages>
            <weaponTags>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Spear</li>
            </weaponTags>
            <money>1500</money>
            <apparel>
              <li MayRequire="vanillaexpanded.vweg">VWE_Apparel_GrenadeFragBelt</li>
            </apparel>
          </li>
        </ageArms>
      </li>

      <!-- The Darkshards, the crossbow line: their whole kit, the cape in the look's colour. -->
      <li>
        <name>crossbow</name>
        <kinds>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Darkshard</li>
        </kinds>
        <dyeAccent>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Cape</li>
        </dyeAccent>
        <gifts>
          <li><trait>Ranger</trait><chance>0.06</chance></li>
          <li><trait>StormBorn</trait><chance>0.03</chance></li>
        </gifts>
        <!-- In the industrial age the repeating crossbow gives way to a repeating gun: an assault rifle, a heavy SMG, a
             light machine gun or a chain shotgun, the game's or any mod's under the same tag (Vanilla Weapons Expanded's
             battle and service rifles, Rimsenal's modular rifles and the like), with an ammo pack (Vanilla Apparel Expanded
             - Accessories). -->
        <ageArms>
          <li>
            <ages>2~2</ages>
            <weaponTags>
              <li>IndustrialGunAdvanced</li>
            </weaponTags>
            <money>600</money>
            <apparel>
              <li MayRequire="vanillaexpanded.vaeaccessories">VAEA_Apparel_AmmoPack</li>
            </apparel>
          </li>
        </ageArms>
      </li>

      <!-- The Dark Riders, their scouts: a bolt quiver with a crossbow, hood and cloak in the look's colours. -->
      <li>
        <name>rider</name>
        <kinds>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_DarkRider</li>
        </kinds>
        <pieces>
          <li>
            <chance>0.6</chance>
            <ranged>true</ranged>
            <apparel>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Quiver</li>
            </apparel>
          </li>
        </pieces>
        <dyeMain>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodA</li>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodB</li>
        </dyeMain>
        <dyeAccent>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Cape</li>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_HighElves_Cloak</li>
        </dyeAccent>
        <gifts>
          <li><trait>StormBorn</trait><chance>0.08</chance></li>
          <li><trait>Ranger</trait><chance>0.04</chance></li>
        </gifts>
        <!-- In the industrial age the scouts carry a light gun: a bolt-action rifle, a pump shotgun, a revolver or a
             machine pistol, the game's or any mod's under the same tag. -->
        <ageArms>
          <li>
            <ages>2~2</ages>
            <weaponTags>
              <li>Gun</li>
            </weaponTags>
            <money>300</money>
          </li>
        </ageArms>
      </li>

      <!-- The Black Guard: their whole kit and colours, now and then a banner. -->
      <li>
        <name>guard</name>
        <kinds>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_BlackGuard</li>
        </kinds>
        <pieces>
          <li>
            <chance>0.1</chance>
            <apparel>
              <li MayRequire="vanillaexpanded.vaeaccessories">VAEA_Apparel_BattleBanner</li>
            </apparel>
          </li>
        </pieces>
        <gifts>
          <li><trait>Gladiator</trait><chance>0.08</chance></li>
          <li><trait>TM_Commander</trait><chance>0.04</chance></li>
        </gifts>
        <!-- In the industrial age the Black Guard keep their halberds, with a belt of frag grenades. -->
        <ageArms>
          <li>
            <ages>2~2</ages>
            <weaponTags>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Halberd</li>
            </weaponTags>
            <money>1500</money>
            <apparel>
              <li MayRequire="vanillaexpanded.vweg">VWE_Apparel_GrenadeFragBelt</li>
            </apparel>
          </li>
        </ageArms>
      </li>

      <!-- The Cold One Knights: their whole kit and colours. -->
      <li>
        <name>knight</name>
        <kinds>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_ColdOneKnight</li>
        </kinds>
        <gifts>
          <li><trait>TM_Commander</trait><chance>0.06</chance></li>
          <li><trait>Gladiator</trait><chance>0.06</chance></li>
        </gifts>
        <!-- In the industrial age the knights keep their own arms and shield: a charge on a Cold One is still a charge. -->
        <ageArms>
          <li>
            <ages>2~2</ages>
            <weaponTags>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Spear</li>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Greatsword</li>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Sword</li>
            </weaponTags>
            <money>1500</money>
          </li>
        </ageArms>
      </li>

      <!-- The witch elves: their whole look; some are bladedancers. -->
      <li>
        <name>witch</name>
        <kinds>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Witch</li>
        </kinds>
        <gifts>
          <li><trait>Bladedancer</trait><chance>0.15</chance></li>
        </gifts>
        <!-- In the industrial age the witch elves keep their blades: theirs is a fight close in. -->
        <ageArms>
          <li>
            <ages>2~2</ages>
            <weaponTags>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Sword</li>
            </weaponTags>
            <money>1500</money>
          </li>
        </ageArms>
      </li>

      <!-- The sorceresses, casters by their own name: their whole look; about half have a class of A RimWorld of Magic,
           without it a psylink (with Vanilla Psycasts Expanded the Staticlord's or the Nightstalker's path). -->
      <li>
        <name>sorceress</name>
        <casters>true</casters>
        <kinds>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Sorceress</li>
        </kinds>
        <gifts>
          <li><trait>StormBorn</trait><chance>0.2</chance></li>
          <li><trait>HeartOfFrost</trait><chance>0.12</chance></li>
          <li><trait>InnerFire</trait><chance>0.12</chance></li>
          <li><trait>Arcanist</trait><chance>0.1</chance></li>
        </gifts>
        <giftsWithoutMagic>
          <li>
            <psylink>1~3</psylink>
            <paths>
              <li MayRequire="vanillaexpanded.vpsycastse">VPE_Staticlord</li>
              <li MayRequire="vanillaexpanded.vpsycastse">VPE_Nightstalker</li>
            </paths>
            <chance>0.54</chance>
          </li>
        </giftsWithoutMagic>
        <!-- In the industrial age the sorceresses keep their spears: their sorcery is their weapon. -->
        <ageArms>
          <li>
            <ages>2~2</ages>
            <weaponTags>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Spear</li>
            </weaponTags>
            <money>1500</money>
