<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Another mod's people, given more than their mod gives them as each is made (Source/ColonyCouncil/Peoples/Foreign/;
    DESIGN.md "The Stormriders: their gear, their looks and some magic"). The player, 17 November 2026, of the Stormriders
    in their save, the dark elves of Elves (Continued): "bring a little more variety to maybe their gear, how they look
    like, um, kind of potentially some maybe can do magic and just kind of spice up the Storm Riders".

    The Elves mod dresses each of its dark elf kinds in one fixed kit (its apparelRequired) and colours, so every Dreadspear
    looks the same. Here, by role (its pawn kinds): a few more pieces, each a chance, from the Elves mod and the player's
    other mods, worn only where they take the place of nothing the kind's own kit requires (unless the role names it: a
    civilian's cape or tunic) and nothing that protects more; the soldiers keep their whole kit and weapon, the elite and
    the casters their whole look. The unarmed (traders, civilians) may carry the Elves' dark elven dagger. A share of each
    role has a class of A RimWorld of Magic (only classes the mod has switched on and allows this faction in its settings),
    the sorceresses most; without that mod the sorceresses have a psylink instead. By look: four sets of colours for their
    cloth (the Elves' own midnight and purple, charcoal and wine, black-violet and ash, brown and midnight), with a share of
    long, braided or loose hair styles and of face and body tattoos. Their xenotype and race are not touched.

    Their age changes over the years as Rimfolk's own peoples' do (Peoples/PeopleAges.cs; DESIGN.md "The comms console by
    radio, and the foreign peoples' ages"; the player, 20 November 2026: "foreign peoples change [age] at their pace"): at
    the pace below, no further than the age below, and no further than every role that carries arms has a set of arms for
    (ageArms: weapon tags of any mod, a kit). A pawn of theirs made in another age than the medieval one their mod made
    them for carries its role's arms of that age and nothing of a later age.

    Every name of another mod is MayRequire'd on its mod (the base game's are plain): without the Elves mod nothing here
    matches, and a piece whose mod isn't loaded is never given. Checked against the player's mods (docs/player-mods,
    active rows) by Tools/Tests/ForeignPeoplesTests.cs and Tools/poolcheck.py.
  -->

  <ColonyCouncil.ForeignPeopleDef>
    <defName>Rimfolk_Foreign_DarkElves</defName>
    <label>dark elves</label>
    <factions>
      <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElvesFaction</li>
    </factions>
    <tag>folk:darkelves</tag>
    <!-- A coven, led by sorceresses, with witch elves in its warbands. -->
    <builtOnMagic>true</builtOnMagic>
    <!-- Their age over the years: eleven years an age at their own pace, as the Ashen Banner's, a medieval people that
         lives by war and takes up whatever arms win its raids; no further than the industrial age, since the coven is
         ruled by its sorceresses, who keep it from the spacer age's machines. Each role that carries arms has its arms of
         the industrial age below. -->
    <agePace>11</agePace>
    <ageLimit>2</ageLimit>
    <roles>

      <!-- The trader of a caravan: a merchant's hat or a masked hood, a vest, a pack, now and then a cloak in place of the cape. -->
      <li>
        <name>trader</name>
        <kinds>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Trader</li>
        </kinds>
        <pieces>
          <li>
            <chance>0.6</chance>
            <apparel>
              <li MayRequire="oskarpotocki.vfe.medieval2">VFEM2_Apparel_Chaperon</li>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodA</li>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodB</li>
              <li MayRequire="vanillaexpanded.viehar">VIEHAR_Apparel_WideHat</li>
              <li>Apparel_HatHood</li>
            </apparel>
          </li>
          <li>
            <chance>0.5</chance>
            <apparel>
              <li MayRequire="oskarpotocki.vanillafactionsexpanded.settlersmodule">Apparel_Vest</li>
              <li MayRequire="vanillaexpanded.varme">VAE_Apparel_QuiltedVest</li>
            </apparel>
          </li>
          <li>
            <chance>0.4</chance>
            <apparel>
              <li MayRequire="vanillaexpanded.vaeaccessories">VAEA_Apparel_Backpack</li>
            </apparel>
          </li>
          <li>
            <chance>0.25</chance>
            <apparel>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_HighElves_Cloak</li>
            </apparel>
          </li>
        </pieces>
        <replaceable>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Cape</li>
        </replaceable>
        <dyeMain>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_WoodElves_Tunic</li>
          <li>Apparel_Pants</li>
          <li MayRequire="oskarpotocki.vanillafactionsexpanded.settlersmodule">Apparel_Vest</li>
          <li MayRequire="vanillaexpanded.varme">VAE_Apparel_QuiltedVest</li>
          <li MayRequire="vanillaexpanded.vaeaccessories">VAEA_Apparel_Backpack</li>
        </dyeMain>
        <dyeAccent>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Cape</li>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_HighElves_Cloak</li>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodA</li>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodB</li>
          <li MayRequire="oskarpotocki.vfe.medieval2">VFEM2_Apparel_Chaperon</li>
          <li MayRequire="vanillaexpanded.viehar">VIEHAR_Apparel_WideHat</li>
          <li>Apparel_HatHood</li>
        </dyeAccent>
        <sidearms>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Dagger</li>
        </sidearms>
        <sidearmChance>0.5</sidearmChance>
        <gifts>
          <li><trait>Enchanter</trait><chance>0.04</chance></li>
        </gifts>
      </li>

      <!-- Their ordinary folk (the penitents, and any kind no other role names): a hood or headscarf, a gambeson, a pack,
           now and then a travelling robe in place of tunic and trousers. -->
      <li>
        <name>folk</name>
        <kinds>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Penitent</li>
        </kinds>
        <pieces>
          <li>
            <chance>0.5</chance>
            <apparel>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodA</li>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodB</li>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_WoodElves_Hood</li>
              <li>Apparel_HatHood</li>
              <li MayRequire="vanillaexpanded.viehar">VIEHAR_Apparel_Headscarf</li>
            </apparel>
          </li>
          <li>
            <chance>0.3</chance>
            <apparel>
              <li MayRequire="devdesigner.elves.continued">DevDesigner_Elves_Gambeson</li>
            </apparel>
          </li>
          <li>
            <chance>0.15</chance>
            <apparel>
              <li MayRequire="homebrew.fairycoreapparel2">FCA2_PurpleTravelRobe</li>
            </apparel>
          </li>
          <li>
            <chance>0.25</chance>
            <apparel>
              <li MayRequire="vanillaexpanded.vaeaccessories">VAEA_Apparel_Backpack</li>
            </apparel>
          </li>
        </pieces>
        <replaceable>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_WoodElves_Tunic</li>
          <li>Apparel_Pants</li>
        </replaceable>
        <dyeMain>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_WoodElves_Tunic</li>
          <li>Apparel_Pants</li>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_Elves_Gambeson</li>
          <li MayRequire="vanillaexpanded.vaeaccessories">VAEA_Apparel_Backpack</li>
        </dyeMain>
        <dyeAccent>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Cape</li>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodA</li>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_MaskedHoodB</li>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_WoodElves_Hood</li>
          <li>Apparel_HatHood</li>
          <li MayRequire="vanillaexpanded.viehar">VIEHAR_Apparel_Headscarf</li>
        </dyeAccent>
        <sidearms>
          <li MayRequire="devdesigner.elves.continued">DevDesigner_DarkElves_Dagger</li>
        </sidearms>
        <sidearmChance>0.3</sidearmChance>
        <gifts>
          <li><trait>StormBorn</trait><chance>0.03</chance></li>
          <li><trait>HeartOfFrost</trait><chance>0.03</chance></li>
        </gifts>
      </li>

      <!-- The Dreadspears, the spear line: their whole kit, the cape in the look's colour, now and then a banner. -->
      <li>
        <name>spear</name>
