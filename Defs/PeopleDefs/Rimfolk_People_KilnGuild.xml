        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Rimfolk_KilnGuild_Journeyman>16</Rimfolk_KilnGuild_Journeyman>
          <Rimfolk_KilnGuild_Apprentice>6</Rimfolk_KilnGuild_Apprentice>
          <Rimfolk_KilnGuild_Guard>3</Rimfolk_KilnGuild_Guard>
          <Villager_Child MayRequire="Ludeon.RimWorld.Biotech">2</Villager_Child>
        </options>
      </li>
      <li>
        <!-- The master-trader's wagons: fine work, stone, steel and glass -->
        <kindDef>Trader</kindDef>
        <traders>
          <Rimfolk_KilnGuild_MasterTrader>1</Rimfolk_KilnGuild_MasterTrader>
        </traders>
        <carriers>
          <Muffalo>3</Muffalo>
          <Donkey>3</Donkey>
          <Horse>2</Horse>
        </carriers>
        <guards>
          <Rimfolk_KilnGuild_Guard>7</Rimfolk_KilnGuild_Guard>
          <Rimfolk_KilnGuild_Journeyman>2</Rimfolk_KilnGuild_Journeyman>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Rimfolk_KilnGuild_Journeyman>10</Rimfolk_KilnGuild_Journeyman>
          <Rimfolk_KilnGuild_Guard>9</Rimfolk_KilnGuild_Guard>
          <Rimfolk_KilnGuild_Apprentice>4</Rimfolk_KilnGuild_Apprentice>
          <Rimfolk_KilnGuild_MasterTrader>2</Rimfolk_KilnGuild_MasterTrader>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleExtension">
        <calling>artisans</calling>
        <!-- Their age over the years (Peoples/PeopleAges.cs): the journeymen bring home every craft they see on their wander-years: soon for a medieval people, and on to the spacer age. -->
        <agePace>8</agePace>
        <ageLimit>3</ageLimit>
        <townWord>guildhall</townWord>
        <townWords>guildhalls</townWords>
        <head>kiln-warden</head>
        <heir>second warden</heir>
        <envoy>journeyman</envoy>
        <trader>master-trader</trader>
        <courier>guild runner</courier>
        <couriers>guild runners</couriers>
        <caravanWeight>1.2</caravanWeight>
        <camps>
          <li>Council_Camp_Smith</li>
          <li>Rimfolk_Camp_Stonecutters</li>
          <li>Council_Camp_Market</li>
        </camps>
        <plan>Rimfolk_Plan_Guildhall</plan>
        <honours>the mark cut true, a masterwork and a journeyman who comes back better</honours>
        <fears>work that lies, a cold kiln and a mark on a thing nobody wanted</fears>
        <sayings>
          <li>Anyone can stack stone.</li>
          <li>We build things people come to look at.</li>
          <li>Mark it, and answer for it.</li>
          <li>Bad work is a lie told in stone.</li>
          <li>Leave a little guild work behind.</li>
        </sayings>
        <townGoods>
          <BlocksGranite>60~140</BlocksGranite>
          <Steel>60~140</Steel>
          <WoodLog>60~140</WoodLog>
          <Cloth>30~60</Cloth>
          <Beer>8~16</Beer>
        </townGoods>
        <ariseAges>0~3</ariseAges>
      </li>
    </modExtensions>
  </FactionDef>

  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md, "Release E"): varied work clothes around the guild's ochre. Every guild
    hand wears the work shirt in ochre and, with Vanilla Apparel Expanded, the leather apron over it in ochre too (the
    guild mark is branded on a bracer beneath); everything else is their own: caps, skullcaps and headscarves (Medieval 2,
    Vanilla Ideology Expanded - Hats and Rags), parkas, packs (Accessories), padding for the kiln's heat (Vanilla Armour
    Expanded). Hammers, maces and tools (the game's and Vanilla Weapons Expanded's). The guild guards are its one kit: an
    ochre cape over padding and a helmet, and a fine blade carried as a display: the longsword in the medieval age, an
    ikwa among the tribes, Melee Weapons For All Post-Medieval Tech Levels' industrial longsword in the industrial age
    (by Rimfolk's own tag, Patches/Rimfolk_PeoplesE.xml), an ultratech blade in the spacer age (Royalty, Vanilla Weapons
    Expanded - Laser, Vanilla Factions Expanded - Empire). A few are A RimWorld of Magic's enchanters and geomancers, and in
    the industrial and spacer ages its technomancers. They carry steel, stone blocks or cloth for the work. Without any
    mod: the game's shirts, trousers, parkas, capes and helmets, maces, knives and longswords.
  -->
  <PawnKindDef Name="Rimfolk_KilnGuildKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_KilnGuild</defaultFactionDef>
    <chemicalAddictionChance>0.03</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <maxGenerationAge>72</maxGenerationAge>
    <specificApparelRequirements>
      <!-- The guild's ochre on the work shirt, the apron and the guards' cape. -->
      <li><apparelDef>Apparel_BasicShirt</apparelDef><color>(0.86, 0.66, 0.18)</color></li>
      <li><apparelDef>Apparel_Cape</apparelDef><color>(0.86, 0.66, 0.18)</color></li>
      <li MayRequire="VanillaExpanded.VAPPE"><apparelDef>VAE_Apparel_Apron</apparelDef><color>(0.86, 0.66, 0.18)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

  <PawnKindDef ParentName="Rimfolk_KilnGuildKindBase">
    <defName>Rimfolk_KilnGuild_Journeyman</defName>
    <label>journeyman</label>
    <combatPower>45</combatPower>
    <isFighter>false</isFighter>
    <itemQuality>Normal</itemQuality>
    <gearHealthRange>0.4~1.3</gearHealthRange>
    <apparelRequired>
      <li>Apparel_BasicShirt</li>
      <li>Apparel_Pants</li>
      <li MayRequire="VanillaExpanded.VAPPE">VAE_Apparel_Apron</li>
    </apparelRequired>
    <apparelTags>
      <li>Neolithic</li>
      <li MayRequire="OskarPotocki.VFE.Medieval2">VFEM2_Cap</li>
      <li>Rimfolk_Skullcap</li>
      <li>Rimfolk_Headscarf</li>
      <li MayRequire="VanillaExpanded.VAEAccessories">VAEA_Utility_Neolithic</li>
    </apparelTags>
    <apparelDisallowTags>
      <li>MedievalMilitary</li>
      <li MayRequire="VanillaExpanded.VAEAccessories">VAEA_Quiver</li>
    </apparelDisallowTags>
    <apparelAllowHeadgearChance>0.6</apparelAllowHeadgearChance>
    <apparelMoney>220~460</apparelMoney>
    <weaponTags>
      <li>MedievalMeleeDecent</li>
      <li>MedievalMeleeBasic</li>
      <li MayRequire="VanillaExpanded.VWE">ToolDecent</li>
    </weaponTags>
    <weaponMoney>60~180</weaponMoney>
    <!-- Steel, stone or cloth for the work in hand. -->
    <inventoryOptions>
      <skipChance>0.4</skipChance>
      <subOptionsChooseOne>
        <li><thingDef>Steel</thingDef><countRange>10~25</countRange><choiceChance>2</choiceChance></li>
        <li><thingDef>BlocksGranite</thingDef><countRange>10~20</countRange></li>
        <li><thingDef>Cloth</thingDef><countRange>10~20</countRange></li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <initialWillRange>2~4</initialWillRange>
    <initialResistanceRange>10~18</initialResistanceRange>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleKindExtension">
        <gifts>
          <li><trait>Enchanter</trait><chance>0.03</chance></li>
          <li><trait>Geomancer</trait><chance>0.03</chance></li>
          <li><trait>Technomancer</trait><chance>0.03</chance><ages>2~3</ages></li>
        </gifts>
      </li>
    </modExtensions>
  </PawnKindDef>

