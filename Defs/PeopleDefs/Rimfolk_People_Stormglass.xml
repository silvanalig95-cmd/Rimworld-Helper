          <Villager_Child MayRequire="Ludeon.RimWorld.Biotech">2</Villager_Child>
        </options>
      </li>
      <li>
        <!-- The vial-seller's string: forecasts, warm clothes, medicine for the cold, and glass -->
        <kindDef>Trader</kindDef>
        <traders>
          <Rimfolk_Stormglass_VialSeller>1</Rimfolk_Stormglass_VialSeller>
        </traders>
        <carriers>
          <Muffalo>3</Muffalo>
          <Yak>3</Yak>
          <Alpaca>2</Alpaca>
        </carriers>
        <guards>
          <Rimfolk_Stormglass_Walker>8</Rimfolk_Stormglass_Walker>
          <Rimfolk_Stormglass_Reader>2</Rimfolk_Stormglass_Reader>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Rimfolk_Stormglass_Reader>10</Rimfolk_Stormglass_Reader>
          <Rimfolk_Stormglass_Walker>10</Rimfolk_Stormglass_Walker>
          <Rimfolk_Stormglass_Apprentice>4</Rimfolk_Stormglass_Apprentice>
          <Rimfolk_Stormglass_VialSeller>2</Rimfolk_Stormglass_VialSeller>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleExtension">
        <calling>seers</calling>
        <!-- Their age over the years (Peoples/PeopleAges.cs): three hundred years of storms written down, and every new instrument set beside the glass: soon, to the spacer age. -->
        <agePace>7</agePace>
        <ageLimit>3</ageLimit>
        <townWord>tower</townWord>
        <townWords>towers</townWords>
        <head>keeper of the glass</head>
        <heir>second keeper</heir>
        <envoy>storm-walker</envoy>
        <trader>vial-seller</trader>
        <courier>vial-runner</courier>
        <couriers>vial-runners</couriers>
        <caravanWeight>0.7</caravanWeight>
        <camps>
          <li>Rimfolk_Camp_Watchers</li>
          <li>Council_Camp_Surveyors</li>
          <li>Council_Camp_Hermit</li>
        </camps>
        <plan>Rimfolk_Plan_GlassTower</plan>
        <honours>the vial kept, the storm written down and a forecast that comes true</honours>
        <fears>the hail nobody saw coming, a broken glass and a reader who is sure</fears>
        <sayings>
          <li>The sky is the world thinking aloud.</li>
          <li>Every storm is written down.</li>
          <li>Never wrong, never sure.</li>
          <li>The glass speaks to those who wait.</li>
          <li>What the sky has done, it will do again.</li>
        </sayings>
        <townGoods>
          <ComponentIndustrial>4~8</ComponentIndustrial>
          <Steel>50~120</Steel>
          <MedicineHerbal>6~12</MedicineHerbal>
          <Cloth>40~90</Cloth>
