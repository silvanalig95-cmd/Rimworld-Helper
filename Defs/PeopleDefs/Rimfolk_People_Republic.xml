        <kindDef>Trader</kindDef>
        <traders>
          <Rimfolk_Republic_Quartermaster>1</Rimfolk_Republic_Quartermaster>
        </traders>
        <carriers>
          <Muffalo>3</Muffalo>
          <Horse>3</Horse>
          <Donkey>2</Donkey>
        </carriers>
        <guards>
          <Rimfolk_Republic_Guard>9</Rimfolk_Republic_Guard>
          <Rimfolk_Republic_Clerk>1</Rimfolk_Republic_Clerk>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Rimfolk_Republic_Guard>12</Rimfolk_Republic_Guard>
          <Rimfolk_Republic_Citizen>8</Rimfolk_Republic_Citizen>
          <Rimfolk_Republic_Clerk>3</Rimfolk_Republic_Clerk>
          <Rimfolk_Republic_Quartermaster>2</Rimfolk_Republic_Quartermaster>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleExtension">
        <calling>citizens</calling>
