    <race>Human</race>
    <defaultFactionDef>Rimfolk_Choir</defaultFactionDef>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <invNutrition>2.0</invNutrition>
    <specificApparelRequirements>
      <!-- The Choir's pale lilac: the robe, and the eltex robe a cantor may wear instead. -->
      <li><apparelDef>Apparel_Robe</apparelDef><color>(0.88, 0.86, 0.95)</color></li>
      <li MayRequire="Ludeon.RimWorld.Royalty"><apparelDef>Apparel_PsyfocusRobe</apparelDef><color>(0.88, 0.86, 0.95)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

