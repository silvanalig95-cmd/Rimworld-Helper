          <Rimfolk_Choir_QuietWarden>10</Rimfolk_Choir_QuietWarden>
          <Rimfolk_Choir_Listener>8</Rimfolk_Choir_Listener>
          <Rimfolk_Choir_Cantor>4</Rimfolk_Choir_Cantor>
