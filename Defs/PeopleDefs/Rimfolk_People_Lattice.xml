    <settlementTexturePath>ColonyCouncil/Peoples/LatticeTown</settlementTexturePath>
    <colorSpectrum>
      <li>(0.20, 0.17, 0.32)</li>
      <li>(0.38, 0.33, 0.56)</li>
    </colorSpectrum>
