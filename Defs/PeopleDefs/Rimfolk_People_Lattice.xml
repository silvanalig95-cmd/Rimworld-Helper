  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md, "Release G"): the robe in lattice indigo is every linker's, its hood worked
    with the lattice pattern, over plain trousers; under and on it whatever the yards' lockers hold. The mech-tenders wear
    Biotech's airwire headset over their mechlink, the node the array headset; the link-wardens a flak vest under the robe
    and an advanced helmet; the engineers tool belts. In another age the wardens take the age's issue (ageArms): spears and
    plate in the medieval age, rifles in the industrial age. Without any mod: the game's robes, trousers, vests, helmets,
    charge rifles and pistols, and the robe's indigo.
  -->
  <PawnKindDef Name="Rimfolk_LatticeKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_Lattice</defaultFactionDef>
    <chemicalAddictionChance>0.02</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <specificApparelRequirements>
      <!-- The Lattice's indigo: the robe with the lattice on its hood. -->
      <li><apparelDef>Apparel_Robe</apparelDef><color>(0.28, 0.24, 0.44)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

