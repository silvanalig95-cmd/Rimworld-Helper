    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <Waster MayRequire="Ludeon.RimWorld.Biotech">0.04</Waster>
        <Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0.03</Dirtmole>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.03</Genie>
