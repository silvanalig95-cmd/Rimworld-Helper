  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md, "Release D"): every piece mended differently. A Wheel hand's coat is of
    any cut (the game's dusters, jackets and parkas; Vanilla Apparel Expanded's builder's and military jackets), patched
    and weathered to the colour of old brass, the cog on its shoulder; under it whatever the scrap gave (the game's and
    Vanilla Apparel Expanded's work clothes, hard hats, gloves), and tool belts and packs (Vanilla Apparel Expanded -
    Accessories). The yard guards share one kit: the brass jacket and a flak vest, with scrap-built guns (Vanilla Weapons
    Expanded - Makeshift) or the game's own; in the tribal and medieval ages hammers and maces, in the spacer age salvaged
    lasers (Vanilla Weapons Expanded - Laser). A mechanitor or two (Biotech) wear the airwire headset over a mechlink.
    Wrenches and pistols for the hands (Vanilla Weapons Expanded's tools). A few are A RimWorld of Magic's
    technomancers, the wheelwright most of all. They carry components, steel or chemfuel. Without any mod: the game's
    coats and work clothes, revolvers, autopistols, rifles and knives.
  -->
  <PawnKindDef Name="Rimfolk_WheelKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_Wheel</defaultFactionDef>
    <chemicalAddictionChance>0.05</chemicalAddictionChance>
    <backstoryCryptosleepCommonality>0.02</backstoryCryptosleepCommonality>
    <invNutrition>2.55</invNutrition>
    <specificApparelRequirements>
      <!-- Old brass on the jacket and the duster, whoever wears one. -->
      <li><apparelDef>Apparel_Jacket</apparelDef><color>(0.62, 0.52, 0.24)</color></li>
      <li><apparelDef>Apparel_Duster</apparelDef><color>(0.62, 0.52, 0.24)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

