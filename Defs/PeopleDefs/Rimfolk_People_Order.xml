<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The hospitaller order (docs/design/peoples.md; DESIGN.md "Rimfolk's peoples"; Source/ColonyCouncil/Peoples/): an order
    of healers who keep sickhouses where the roads are worst and take in whoever comes. Medieval, on the game's tribal
    parent: plain robes and hoods dyed the order's ivory, sworn guards in plate, lay archers with bows. Their towns are
    sickhouses round an herb garden (TownPlanDef Rimfolk_Plan_Sickhouse). In a plague year they ask the colony for medicine
    (Rimfolk_Mission_OrderMedicine), they lend a healer to a colony with its sick (Rimfolk_Evt_OrderHealer), and their
    sickhouse sees to the colony's travellers who lodge there. They defend their sickhouses and raid only when the colony
    has turned them hostile (raidCommonalityFromPointsCurve 0.25). Listed once among the world's peoples when a world is
    made, never required. Faith (Ideology): a fixed creed of penance and of the body kept whole (VE Memes' healthcare
    where loaded), the Christian style's gothic halls. Kind of people (Biotech): humans, a few genies.
  -->

  <FactionDef ParentName="TribeBase">
    <defName>Rimfolk_Order</defName>
    <label>hospitaller order</label>
    <description>An order of healers who keep sickhouses where the roads are worst and take in whoever comes to their door, friend or stranger. They live plainly, work the herb gardens and the wards, and send their almoners out with medicine and their postulants with letters.\n\nThey keep sworn guards in plate and lay archers on their walls, for the sick are not safe in a hard land, but they are slow to anger. Each sickhouse is kept by a prior or prioress.</description>
    <pawnSingular>hospitaller</pawnSingular>
    <pawnsPlural>hospitallers</pawnsPlural>
    <leaderTitle>prior</leaderTitle>
    <leaderTitleFemale>prioress</leaderTitleFemale>
    <techLevel>Medieval</techLevel>
    <basicMemberKind>Rimfolk_Order_Lay</basicMemberKind>
    <factionNameMaker>Rimfolk_Namer_Order</factionNameMaker>
    <settlementNameMaker>Rimfolk_Namer_OrderTown</settlementNameMaker>
    <factionIconPath>ColonyCouncil/Peoples/Order</factionIconPath>
    <settlementTexturePath>ColonyCouncil/Peoples/OrderTown</settlementTexturePath>
    <colorSpectrum>
      <li>(0.84, 0.82, 0.74)</li>
      <li>(0.97, 0.95, 0.88)</li>
    </colorSpectrum>
    <hidden>false</hidden>
    <naturalEnemy>false</naturalEnemy>
    <permanentEnemy>false</permanentEnemy>
    <canSiege>false</canSiege>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>35</configurationListOrderPriority>
    <settlementGenerationWeight>0.8</settlementGenerationWeight>
    <allowedCultures Inherit="False">
      <li>Rustican</li>
    </allowedCultures>
    <backstoryFilters Inherit="False">
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
        <commonality>0.7</commonality>
      </li>
      <li>
        <categories>
          <li>Tribal</li>
        </categories>
        <commonality>0.3</commonality>
      </li>
    </backstoryFilters>
    <raidCommonalityFromPointsCurve Inherit="False">
      <points>
        <li>(0, 0.25)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <xenotypeSet>
      <xenotypeChances>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.03</Genie>
      </xenotypeChances>
    </xenotypeSet>
    <fixedIdeo>true</fixedIdeo>
    <ideoName>The Open Hand</ideoName>
    <ideoDescription>We were spared, and so we owe. The sick at the door are tended before the question of who they are, the body is kept whole and clean, and what the order has is held for whoever needs it next. A hospitaller's hand is open: it gives, and it is not raised first.</ideoDescription>
    <forcedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Guilty</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_Healthcare</li>
    </forcedMemes>
    <structureMemeWeights Inherit="False">
      <Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">3</Structure_TheistAbstract>
      <Structure_OriginChristian MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginChristian>
    </structureMemeWeights>
    <styles>
      <li MayRequire="Ludeon.RimWorld.Ideology">Christian</li>
    </styles>
    <caravanTraderKinds Inherit="False">
      <li>Rimfolk_Caravan_Order</li>
    </caravanTraderKinds>
    <visitorTraderKinds Inherit="False">
      <li>Rimfolk_Visitor_Order</li>
    </visitorTraderKinds>
    <baseTraderKinds Inherit="False">
      <li>Rimfolk_Base_Order</li>
    </baseTraderKinds>
    <pawnGroupMakers Inherit="False">
      <li>
        <!-- A fight: sworn guards in plate and lay archers -->
        <kindDef>Combat</kindDef>
        <options>
          <Rimfolk_Order_Brother>8</Rimfolk_Order_Brother>
          <Rimfolk_Order_Bowman>10</Rimfolk_Order_Bowman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Rimfolk_Order_Lay>16</Rimfolk_Order_Lay>
          <Rimfolk_Order_Healer>10</Rimfolk_Order_Healer>
          <Villager_Child MayRequire="Ludeon.RimWorld.Biotech">4</Villager_Child>
          <Rimfolk_Order_Bowman>5</Rimfolk_Order_Bowman>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Rimfolk_Order_Cellarer>1</Rimfolk_Order_Cellarer>
        </traders>
        <carriers>
          <Muffalo>5</Muffalo>
          <Horse>4</Horse>
          <Dromedary>3</Dromedary>
          <Alpaca>2</Alpaca>
        </carriers>
        <guards>
          <Rimfolk_Order_Brother>6</Rimfolk_Order_Brother>
          <Rimfolk_Order_Bowman>10</Rimfolk_Order_Bowman>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Rimfolk_Order_Brother>8</Rimfolk_Order_Brother>
          <Rimfolk_Order_Bowman>10</Rimfolk_Order_Bowman>
          <Rimfolk_Order_Healer>6</Rimfolk_Order_Healer>
          <Rimfolk_Order_Lay>6</Rimfolk_Order_Lay>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="ColonyCouncil.PeopleExtension">
        <calling>healers</calling>
        <townWord>sickhouse</townWord>
        <townWords>sickhouses</townWords>
        <head>prior</head>
        <headFemale>prioress</headFemale>
        <heir>subprior</heir>
        <heirFemale>subprioress</heirFemale>
        <envoy>almoner</envoy>
        <trader>cellarer</trader>
        <courier>postulant</courier>
        <couriers>postulants</couriers>
        <caravanWeight>1</caravanWeight>
        <camps>
          <li>Council_Camp_Healers</li>
          <li>Council_Camp_LoneHealer</li>
          <li>Rimfolk_Camp_HerbGatherers</li>
          <li>Council_Camp_Pilgrims</li>
          <li>Council_Camp_Penitents</li>
        </camps>
        <plan>Rimfolk_Plan_Sickhouse</plan>
        <townGoods>
          <MedicineHerbal>20~40</MedicineHerbal>
          <MedicineIndustrial>4~10</MedicineIndustrial>
          <Cloth>60~120</Cloth>
          <Pemmican>40~80</Pemmican>
          <WoodLog>60~120</WoodLog>
        </townGoods>
      </li>
    </modExtensions>
  </FactionDef>

