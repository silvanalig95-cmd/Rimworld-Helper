      <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_Healthcare</li>
      <!-- The lamp over every sickhouse door: Vanilla Ideology Expanded's light. -->
      <li MayRequire="VanillaExpanded.VMemesE">VME_Light</li>
    </forcedMemes>
    <structureMemeWeights Inherit="False">
