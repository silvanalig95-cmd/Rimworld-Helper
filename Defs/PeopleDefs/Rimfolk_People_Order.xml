        <agePace>12</agePace>
        <ageLimit>2</ageLimit>
        <townWord>sickhouse</townWord>
        <townWords>sickhouses</townWords>
        <head>prior</head>
        <headFemale>prioress</headFemale>
        <heir>subprior</heir>
        <heirFemale>subprioress</heirFemale>
