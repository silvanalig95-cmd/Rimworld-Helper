          <Rimfolk_RiverFolk_Ferryman>8</Rimfolk_RiverFolk_Ferryman>
          <Tribal_Child MayRequire="Ludeon.RimWorld.Biotech">6</Tribal_Child>
          <Rimfolk_RiverFolk_Warden>5</Rimfolk_RiverFolk_Warden>
        </options>
      </li>
      <li>
