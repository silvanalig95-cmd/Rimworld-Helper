    </apparelRequired>
    <weaponTags>
      <li>MedievalMeleeBasic</li>
      <li>NeolithicRangedBasic</li>
      <li MayRequire="OskarPotocki.VFE.Classical">ClassicalRangedJavelin</li>
    </weaponTags>
    <weaponMoney>40~100</weaponMoney>
    <apparelMoney>120~280</apparelMoney>
    <!-- Net cloth, or a few herbs; with Odyssey the day's catch, with Alpha Crafts a jar of fish sauce. -->
