    </baseTraderKinds>
    <pawnGroupMakers Inherit="False">
      <li>
        <!-- A fight: the river wardens, with fishing spears and bows -->
        <kindDef>Combat</kindDef>
        <options>
          <Rimfolk_RiverFolk_Warden>10</Rimfolk_RiverFolk_Warden>
          <Rimfolk_RiverFolk_Bowman>8</Rimfolk_RiverFolk_Bowman>
