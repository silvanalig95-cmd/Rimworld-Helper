      <skipChance>0.5</skipChance>
      <subOptionsChooseOne>
        <li><thingDef>Cloth</thingDef><countRange>4~10</countRange><choiceChance>2</choiceChance></li>
        <li><thingDef>MedicineHerbal</thingDef><countRange>1~1</countRange></li>
