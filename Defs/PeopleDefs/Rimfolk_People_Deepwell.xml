  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md, "Release F"): no uniform, only the union's red. Every union miner wears a
    red work shirt of any cut (the game's and Vanilla Apparel Expanded's), with Biotech the red sash tied as the union's
    armband over it; miners and shot-firers a hard hat (Vanilla Apparel Expanded); the rest varied by trade, the game's
    work clothes, gloves and packs (Vanilla Apparel Expanded - Accessories), the shift-captains in jackets, the union boss
    in a long coat. Miners carry shovels (Vanilla Weapons Expanded's tools), knives and shotguns, the shot-firers their
    charges (the game's grenades, Settlers' dynamite) and a pistol; in another age their tools take the age's form
    (ageArms: clubs and spears among the tribes, maces and great bows in the medieval age, charge rifles in the spacer
    age). Tough and strong; a few with mining genes put in (Biotech, Alpha Genes), a few A RimWorld of Magic's geomancers.
    They carry steel or a component. Without any mod: the game's shirts, trousers, jackets, dusters, helmets, shotguns,
    knives, pistols and grenades.
  -->
  <PawnKindDef Name="Rimfolk_DeepwellKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_Deepwell</defaultFactionDef>
    <chemicalAddictionChance>0.08</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <specificApparelRequirements>
      <!-- The union's red: a work shirt of any cut, and with Biotech the sash tied as its armband. -->
      <li>
        <apparelLayer>OnSkin</apparelLayer>
        <bodyPartGroup>Torso</bodyPartGroup>
        <color>(0.60, 0.10, 0.10)</color>
        <alternateTagChoices>
          <li><tag>IndustrialBasic</tag><chance>1</chance></li>
        </alternateTagChoices>
      </li>
      <li MayRequire="Ludeon.RimWorld.Biotech"><apparelDef>Apparel_Sash</apparelDef><color>(0.60, 0.10, 0.10)</color></li>
    </specificApparelRequirements>
