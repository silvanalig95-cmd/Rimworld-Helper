      <li><apparelDef>Apparel_Pants</apparelDef><color>(0.22, 0.24, 0.27)</color></li>
      <li><apparelDef>Apparel_Jacket</apparelDef><color>(0.22, 0.24, 0.27)</color></li>
      <li><apparelDef>Apparel_Duster</apparelDef><color>(0.22, 0.24, 0.27)</color></li>
      <li><apparelDef>Apparel_ArmorRecon</apparelDef><color>(0.22, 0.24, 0.27)</color></li>
      <li><apparelDef>Apparel_ArmorHelmetRecon</apparelDef><color>(0.22, 0.24, 0.27)</color></li>
      <li><apparelDef>Apparel_FlakVest</apparelDef><color>(0.22, 0.24, 0.27)</color></li>
      <li><apparelDef>Apparel_PlateArmor</apparelDef><color>(0.22, 0.24, 0.27)</color></li>
      <li MayRequire="OskarPotocki.VFE.Tribals"><apparelDef>VFET_Apparel_TribalWar</apparelDef><color>(0.22, 0.24, 0.27)</color></li>
    </specificApparelRequirements>
