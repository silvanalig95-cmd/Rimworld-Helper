  <!-- ===================== Their people ===================== -->

  <!--
    How alike they look (docs/design/peoples.md, "Release E"): the clearest uniform of any people. Every soldier of the
    Banner wears the company's issued kit, dyed ash grey: the game's plate and helmet in the medieval age, under the ash
    tabard where Vanilla Factions Expanded - Medieval 2 is loaded; only what is under it, gloves and boots and a banner,
    differ (the game's medieval military pieces, Vanilla Armour Expanded's), and wear and quality. The line carry the
    company's polearms (the game's spears, Medieval 2's pikes), the shot its crossbows (Vanilla Weapons Expanded,
    Medieval 2's arbalest), the sergeants swords. In another age the issue changes with it (PeopleKindExtension.ageArms:
    the kit's armour and weapons both): war tribalwear and spears among the tribes (Vanilla Factions Expanded -
    Tribals), flak, helmets and the company's rifles in the industrial age, recon armour and charge rifles in the spacer
    age, the new pieces dyed the same ash. Officers wear a cape in place of the plate and a black sash (Biotech). A few
    are A RimWorld of Magic's commanders, gladiators, paladins and rangers; in the industrial and spacer ages a super
    soldier now and then. They carry pemmican or herbs. Without any mod: the game's plate, helmets, capes, spears, bows
    and swords.
  -->
  <PawnKindDef Name="Rimfolk_AshenBannerKindBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Rimfolk_AshenBanner</defaultFactionDef>
    <chemicalAddictionChance>0.06</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <invFoodDef>Pemmican</invFoodDef>
    <maxGenerationAge>60</maxGenerationAge>
    <specificApparelRequirements>
      <!-- Ash grey on the issued kit of every age, whichever piece is worn; black on the officers' sash. -->
      <li><apparelDef>Apparel_PlateArmor</apparelDef><color>(0.62, 0.60, 0.57)</color></li>
      <li><apparelDef>Apparel_Cape</apparelDef><color>(0.62, 0.60, 0.57)</color></li>
      <li><apparelDef>Apparel_FlakVest</apparelDef><color>(0.62, 0.60, 0.57)</color></li>
      <li><apparelDef>Apparel_ArmorRecon</apparelDef><color>(0.62, 0.60, 0.57)</color></li>
      <li MayRequire="OskarPotocki.VFE.Medieval2"><apparelDef>VFEM2_Apparel_Tabard</apparelDef><color>(0.62, 0.60, 0.57)</color></li>
      <li MayRequire="OskarPotocki.VFE.Tribals"><apparelDef>VFET_Apparel_TribalWar</apparelDef><color>(0.62, 0.60, 0.57)</color></li>
      <li MayRequire="Ludeon.RimWorld.Biotech"><apparelDef>Apparel_Sash</apparelDef><color>(0.12, 0.12, 0.12)</color></li>
    </specificApparelRequirements>
  </PawnKindDef>

