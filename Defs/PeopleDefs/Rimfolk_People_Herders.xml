    <isFighter>false</isFighter>
    <itemQuality>Poor</itemQuality>
    <gearHealthRange>0.5~1.6</gearHealthRange>
    <apparelRequired>
      <li MayRequire="Ludeon.RimWorld.Ideology">Apparel_Tailcap</li>
    </apparelRequired>
    <apparelTags>
      <li MayRequire="co.uk.epicguru.meleeanimation">Lasso</li>
    </apparelTags>
    <apparelMoney>150~320</apparelMoney>
    <weaponTags>
      <li>NeolithicMeleeBasic</li>
      <li>NeolithicRangedBasic</li>
    </weaponTags>
    <weaponMoney>40~110</weaponMoney>
    <skills>
      <li>
        <skill>Animals</skill>
        <range>6~14</range>
      </li>
    </skills>
    <!-- Hay for the beasts, a few hides; with Odyssey a bundle of muskox wool, with Alpha Crafts a crock of butter. -->
