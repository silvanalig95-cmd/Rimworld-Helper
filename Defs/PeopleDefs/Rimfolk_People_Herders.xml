          <li>Yak</li>
          <li>Sheep</li>
          <li>Goat</li>
          <li>Cow</li>
          <li>Alpaca</li>
          <li>Dromedary</li>
          <li>Horse</li>
        </herd>
        <herdCount>8~14</herdCount>
      </li>
    </modExtensions>
  </FactionDef>

