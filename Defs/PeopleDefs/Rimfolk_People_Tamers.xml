        <agePace>12</agePace>
        <ageLimit>3</ageLimit>
        <townWord>ring</townWord>
        <townWords>rings</townWords>
        <head>ring-keeper</head>
        <heir>second of the ring</heir>
        <envoy>roaming tamer</envoy>
        <trader>egg-trader</trader>
        <courier>beast-rider</courier>
        <couriers>beast-riders</couriers>
        <caravanWeight>1</caravanWeight>
        <camps>
