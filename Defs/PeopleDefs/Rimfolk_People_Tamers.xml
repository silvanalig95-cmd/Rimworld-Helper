        <options>
          <Rimfolk_Tamers_Tamer>8</Rimfolk_Tamers_Tamer>
          <Rimfolk_Tamers_Ringwarden>10</Rimfolk_Tamers_Ringwarden>
          <Rimfolk_Tamers_Ranger>6</Rimfolk_Tamers_Ranger>
          <Rimfolk_Tamers_EggTrader>2</Rimfolk_Tamers_EggTrader>
