        <kindDef>Trader</kindDef>
        <traders>
          <Rimfolk_Tamers_EggTrader>1</Rimfolk_Tamers_EggTrader>
        </traders>
        <carriers>
          <Muffalo>4</Muffalo>
          <Horse>3</Horse>
          <Dromedary>2</Dromedary>
          <Alpaca>2</Alpaca>
        </carriers>
        <guards>
          <Rimfolk_Tamers_Ringwarden>6</Rimfolk_Tamers_Ringwarden>
          <Rimfolk_Tamers_Ranger>5</Rimfolk_Tamers_Ranger>
        </guards>
      </li>
      <li>
