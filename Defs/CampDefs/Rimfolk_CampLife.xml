<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- A camp that looks lived-in (Source/ColonyCouncil/Camps/CampLook.cs): the duty of the animals a camp brings, and
       the jobs of a camp's last walk and of a smith mending one of the colony's buildings. What each kind brings, puts
       out and leaves behind is in its CampKindDef (animals, campGoods, leaveBehind, farewellWalk, momentLines). -->

  <!-- Their animals: pack beasts tethered by the stash, a herd grazing beyond the camp, a dog at a drover's heels.
       JobGiver_CampBeasts gives them sleep, grazing (wild grass only, never the colony's zones or home ground) and a slow
       wander near their place; the camp feeds them from its own stores. -->
  <DutyDef>
    <defName>Council_CampBeasts</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ColonyCouncil.JobGiver_CampBeasts" />
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>6</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- The farewell round: a healer at a colonist's side for a moment (wounds seen to if they need it). Over if the
       colonist walks off. -->
  <JobDef ParentName="Council_CampJobBase">
    <defName>Council_CampFarewell</defName>
    <reportString>looking in on TargetA before leaving.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>400</ticks><social>true</social><stayNear>5</stayNear></li>
    </modExtensions>
  </JobDef>

  <!-- A gift laid at the colony's gate on the way out: a sprig planted, a carving left in its crate. -->
  <JobDef ParentName="Council_CampJobBase">
    <defName>Council_CampLayGift</defName>
    <reportString>leaving something by the colony's gate.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>300</ticks></li>
    </modExtensions>
  </JobDef>

  <!-- Something brought over for the colony by hand (Source/ColonyCouncil/Camps/CampCarry.cs): their healer out
       gathering at dawn (wild healroot harvested where it grows, else herbs picked among the grass on a walk beyond the
       camp), a drover milking or shearing a beast of their herd (it stands for it), and the walk over with what they
       have, set down at the camp's edge nearest the colony, or the colony's gate for goods it bought. -->
  <JobDef ParentName="Council_CampJobBase">
    <defName>Council_CampGather</defName>
    <reportString>gathering herbs.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>500</ticks><effecter>Harvest_Plant</effecter></li>
    </modExtensions>
  </JobDef>

  <JobDef ParentName="Council_CampJobBase">
    <defName>Council_CampMilk</defName>
    <reportString>milking TargetA.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>400</ticks><holdTarget>true</holdTarget></li>
    </modExtensions>
  </JobDef>

  <JobDef ParentName="Council_CampJobBase">
    <defName>Council_CampShear</defName>
    <reportString>shearing TargetA.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>500</ticks><holdTarget>true</holdTarget></li>
    </modExtensions>
  </JobDef>

  <JobDef>
    <defName>Council_CampBring</defName>
    <driverClass>ColonyCouncil.JobDriver_CampBring</driverClass>
    <reportString>bringing something over for the colony.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <!-- Their own dead taken up and carried off the map when they go in peace (a war party's fallen): the game's own
       taking and leaving with something. -->
  <JobDef>
    <defName>Council_CampCarryHome</defName>
    <driverClass>JobDriver_TakeAndExitMap</driverClass>
    <reportString>carrying TargetA home.</reportString>
  </JobDef>

  <!-- A smith mending one of the colony's damaged buildings, as a gift. -->
  <JobDef ParentName="Council_CampJobBase">
    <defName>Council_CampRepair</defName>
    <reportString>mending TargetA.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>1800</ticks><repairEffect>true</repairEffect></li>
    </modExtensions>
  </JobDef>

</Defs>
