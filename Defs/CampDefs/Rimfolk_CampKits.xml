  <!-- The camp's newer work (Camps/CampDay.cs, CampPack.cs): something simple made at their crafting spot, their own
       building mended, and packing up in their last hours (a bedroll, a tent, a stool uninstalled and carried; or, for a
       kind that leaves no trace, a wall taken down). -->
  <JobDef ParentName="Council_CampJobBase">
    <defName>Rimfolk_CampCraft</defName>
    <reportString>making something at the crafting spot.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>2400</ticks><progress>true</progress></li>
    </modExtensions>
  </JobDef>

  <JobDef ParentName="Council_CampJobBase">
    <defName>Rimfolk_CampMend</defName>
    <reportString>mending TargetA.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>900</ticks><repairEffect>true</repairEffect><progress>true</progress></li>
    </modExtensions>
  </JobDef>

  <!-- Cleaning the mess on their own ground (Camps/CampClean.cs): the game's own cleaning, on their camp's ground. -->
  <JobDef>
    <defName>Rimfolk_CampClean</defName>
    <driverClass>ColonyCouncil.JobDriver_CampClean</driverClass>
    <reportString>cleaning.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <JobDef ParentName="Council_CampJobBase">
    <defName>Rimfolk_CampPack</defName>
    <reportString>packing up TargetA.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>500</ticks><repairEffect>true</repairEffect><progress>true</progress></li>
    </modExtensions>
  </JobDef>

  <!-- What they brought to build with and didn't use, back in a pack once their camp stands (Camps/CampStore.cs). -->
  <JobDef ParentName="Council_CampJobBase">
    <defName>Rimfolk_CampRepack</defName>
    <reportString>putting TargetA back in a pack.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>120</ticks></li>
    </modExtensions>
  </JobDef>

  <!-- Building their camp and what they add to it (Camps/CampGather.cs): a frame of theirs finished by their own
       construction job (the game's own work, pace, effect and finishing), and a chunk of the rock they mined dressed into
       stone blocks at their stonecutter's table or, for a tribal or medieval people, by hand at their crafting spot. -->
  <JobDef>
    <defName>Rimfolk_CampBuild</defName>
    <driverClass>ColonyCouncil.JobDriver_CampBuild</driverClass>
    <reportString>constructing TargetA.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <JobDef ParentName="Council_CampJobBase">
    <defName>Rimfolk_CampCutStone</defName>
    <reportString>cutting stone blocks from a chunk.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>1600</ticks><effecter>CutStone</effecter><progress>true</progress></li>
    </modExtensions>
  </JobDef>
</Defs>
