      <li><role>tent</role><defs><li MayRequire="oskarpotocki.vfe.classical">VFEC_Tent</li><li>Bedroll</li></defs><stuff><li>Cloth</li><li>Leather_Plain</li></stuff></li>
      <li><role>hut</role><defs><li MayRequire="vanillaexpanded.vfearchitect">VFEArch_LogWall</li><li>Wall</li></defs><stuff><li>WoodLog</li></stuff></li>
      <li><role>tentwall</role><defs><li MayRequire="oskarpotocki.vfe.medieval2">VFEM2_ClothWall</li><li>Wall</li></defs><stuff><li>Cloth</li><li>Leather_Plain</li><li>WoodLog</li></stuff></li>
      <li><role>door</role><defs><li>Door</li></defs><stuff><li>WoodLog</li></stuff></li>
      <li><role>tentdoor</role><defs><li MayRequire="jecrell.doorsexpanded">HeronCurtainTribal</li><li MayRequire="local.moredoorvariants">MDV_DoorCurtain</li><li>Door</li></defs><stuff><li>Cloth</li><li>Leather_Plain</li><li>WoodLog</li></stuff></li>
      <li><role>wall</role><defs><li MayRequire="oskarpotocki.vfe.medieval2">VFEM2_Palisade</li><li>Wall</li></defs><stuff><li>WoodLog</li></stuff></li>
      <li><role>table</role><defs><li>Table1x2c</li></defs><stuff><li>WoodLog</li></stuff></li>
      <li><role>seat</role><defs><li>Stool</li></defs><stuff><li>WoodLog</li></stuff></li>
      <li><role>light</role><defs><li>TorchLamp</li></defs></li>
      <li><role>butcher</role><defs><li>ButcherSpot</li></defs></li>
      <li><role>craft</role><defs><li>CraftingSpot</li></defs></li>
      <li><role>stall</role><defs><li>Table1x2c</li></defs><stuff><li>WoodLog</li></stuff></li>
      <li><role>picket</role><defs><li>CaravanPackingSpot</li></defs></li>
      <li><role>stash</role><defs><li>Shelf</li></defs><stuff><li>WoodLog</li></stuff></li>
    </parts>
  </ColonyCouncil.CampKitDef>

