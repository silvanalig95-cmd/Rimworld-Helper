  <!-- The camp's newer work (Camps/CampDay.cs, CampPack.cs): something simple made at their crafting spot, their own
       building mended, and packing up in their last hours (a bedroll, a tent, a stool uninstalled and carried; or, for a
       kind that leaves no trace, a wall taken down). -->
  <JobDef ParentName="Council_CampJobBase">
    <defName>Rimfolk_CampCraft</defName>
    <reportString>making something at the crafting spot.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>2400</ticks><progress>true</progress></li>
    </modExtensions>
  </JobDef>

  <JobDef ParentName="Council_CampJobBase">
    <defName>Rimfolk_CampMend</defName>
    <reportString>mending TargetA.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>900</ticks><repairEffect>true</repairEffect><progress>true</progress></li>
    </modExtensions>
  </JobDef>

  <JobDef ParentName="Council_CampJobBase">
    <defName>Rimfolk_CampPack</defName>
    <reportString>packing up TargetA.</reportString>
    <modExtensions>
      <li Class="ColonyCouncil.CampJobExtension"><ticks>500</ticks><repairEffect>true</repairEffect><progress>true</progress></li>
    </modExtensions>
  </JobDef>
</Defs>
