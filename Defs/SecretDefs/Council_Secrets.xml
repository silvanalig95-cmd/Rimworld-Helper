<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Secrets. Each adult colonist is looked at once, a couple of days after arriving: with a fitting backstory a secret
    is likely, otherwise about one in three gets one.
    who: dilemma-role requirements. backstory: words in their backstory titles that make it likely (backstoryOnly: required).
    truth: told when it comes out ({PAWN_...}). good: people are glad to learn it. major: a letter instead of a message.
    revealEffects: dilemma effects; A is the owner, B whoever let it slip. Others = everyone else.
    ownerThought: the owner's memory when it's out (default: exposed, -7; or confessed, -2).
    Dilemmas with workerClass ColonyCouncil.DilemmaWorker_Secret and <secrets><li>defName</li></secrets> come up after it's out.
  -->

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_RaiderPast</defName>
    <label>a raider's past</label>
    <backstory><li>raider</li><li>pirate</li><li>bandit</li><li>outlaw</li><li>gang</li><li>thug</li><li>marauder</li><li>reaver</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <major>true</major>
    <truth>{PAWN_nameDef} rode with raiders for years before coming here: burned farms, took what wasn't {PAWN_possessive}, and did worse things {PAWN_pronoun} still won't talk about.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Distrust</thought><exceptTrait><li>Kind</li><li>Psychopath</li><li>Bloodlust</li></exceptTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Forgave</thought><onlyTrait><li>Kind</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Respect</thought><onlyTrait><li>Bloodlust</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_NobleBlood</defName>
    <label>noble blood</label>
    <backstory><li>noble</li><li>aristocrat</li><li>heir</li><li>prince</li><li>princess</li><li>baron</li><li>royal</li><li>courtier</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <good>true</good>
    <truth>{PAWN_nameDef} was born to a great house on another world, and walked away from a fortune and a title to end up here, in the mud, with the rest of us.</truth>
    <ownerThought>Council_Secret_Embarrassed</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Contempt</thought><onlyTrait><li>Greedy</li><li>Jealous</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Respect</thought><onlyTrait><li>Ascetic</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Amused</thought><exceptTrait><li>Greedy</li><li>Jealous</li><li>Ascetic</li></exceptTrait><chance>0.5</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_Deserter</defName>
    <label>a deserter</label>
    <backstory><li>soldier</li><li>marine</li><li>trooper</li><li>guard</li><li>officer</li><li>conscript</li><li>militia</li><li>legion</li><li>warrior</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <truth>{PAWN_nameDef} deserted. In the middle of a battle, {PAWN_pronoun} dropped {PAWN_possessive} weapon and ran, and left {PAWN_possessive} unit to die.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Contempt</thought><onlyTrait><li>Tough</li><li>Bloodlust</li><li>Brawler</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li><li>Wimp</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><exceptTrait><li>Tough</li><li>Bloodlust</li><li>Brawler</li><li>Kind</li><li>Wimp</li></exceptTrait><chance>0.5</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_LostPatient</defName>
    <label>a doctor's mistake</label>
    <backstory><li>doctor</li><li>medic</li><li>surgeon</li><li>nurse</li><li>physician</li><li>healer</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <truth>{PAWN_nameDef} once killed a patient through a careless mistake, then fled before anyone could ask questions, and has never stopped asking them since.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><exceptTrait><li>Kind</li></exceptTrait><chance>0.4</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_ChildLeft</defName>
    <label>a child left behind</label>
    <minAge>25</minAge>
    <truth>{PAWN_nameDef} has a child, somewhere out among the stars, left behind when everything fell apart, and has no idea if the child is still alive.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><exceptTrait><li>Psychopath</li></exceptTrait><chance>0.7</chance></li>
    </revealEffects>
    <ownerThought>Council_Secret_Confessed</ownerThought>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_Wanted</defName>
    <label>a price on their head</label>
    <backstory><li>fugitive</li><li>convict</li><li>prisoner</li><li>escapee</li><li>exile</li><li>assassin</li><li>murderer</li><li>criminal</li></backstory>
    <major>true</major>
    <truth>{PAWN_nameDef} is wanted for murder on {PAWN_possessive} homeworld. There's a bounty, and {PAWN_pronoun} has been running from it ever since.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Distrust</thought><exceptTrait><li>Psychopath</li><li>Bloodlust</li><li>Kind</li></exceptTrait><chance>0.7</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Forgave</thought><onlyTrait><li>Kind</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_Cultist</defName>
    <label>a cult</label>
    <backstory><li>cult</li><li>acolyte</li><li>zealot</li><li>priest</li><li>monk</li><li>prophet</li><li>mystic</li><li>preacher</li></backstory>
    <truth>{PAWN_nameDef} once belonged to a cult that prayed to something in the dark between the stars. {PAWN_nameDef} says it's over. Some nights the prayers still come, whispered.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><exceptTrait><li>Psychopath</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Amused</thought><onlyTrait><li>Psychopath</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_Debt</defName>
    <label>a pirate's debt</label>
    <backstory><li>gambler</li><li>smuggler</li><li>trader</li><li>merchant</li><li>dealer</li><li>con</li><li>swindler</li></backstory>
    <truth>{PAWN_nameDef} owes a small fortune to a pirate lord, a gambling debt from another life, and the pirates have long memories.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Contempt</thought><onlyTrait><li>Greedy</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><exceptTrait><li>Greedy</li><li>Kind</li></exceptTrait><chance>0.4</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_StolenName</defName>
    <label>a borrowed name</label>
    <backstory><li>spy</li><li>agent</li><li>actor</li><li>imposter</li><li>infiltrator</li><li>con</li></backstory>
    <truth>"{PAWN_nameDef}" isn't {PAWN_possessive} real name. It belonged to a dead traveller on the road here, papers and all.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><exceptTrait><li>Psychopath</li></exceptTrait><chance>0.6</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_StoresThief</defName>
    <label>the food that went missing</label>
    <weight>0.6</weight>
    <who><notTrait><li>Kind</li><li>Ascetic</li></notTrait></who>
    <truth>{PAWN_nameDef} has been quietly taking food from the stores at night, a little at a time, for months. That's where it all went.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Distrust</thought><exceptTrait><li>Kind</li></exceptTrait><chance>0.8</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_CantRead</defName>
    <label>can't read</label>
    <weight>0.5</weight>
    <who><notTrait><li>TooSmart</li></notTrait></who>
    <truth>{PAWN_nameDef} can't read. All those times {PAWN_pronoun} nodded at a book or a sign, {PAWN_pronoun} was guessing.</truth>
    <ownerThought>Council_Secret_Embarrassed</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Mocking</thought><onlyTrait><li>Abrasive</li><li>TooSmart</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Amused</thought><onlyTrait><li>Kind</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_AfraidOfDark</defName>
    <label>afraid of the dark</label>
    <weight>0.5</weight>
    <who><notTrait><li>Tough</li><li>Psychopath</li></notTrait></who>
    <truth>{PAWN_nameDef} is terrified of the dark, and has slept with a light hidden under the blanket every night since arriving.</truth>
    <ownerThought>Council_Secret_Embarrassed</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Mocking</thought><onlyTrait><li>Abrasive</li><li>Bloodlust</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Amused</thought><exceptTrait><li>Abrasive</li><li>Bloodlust</li></exceptTrait><chance>0.4</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_Benefactor</defName>
    <label>a hidden kindness</label>
    <who><anyTrait><li>Kind</li></anyTrait></who>
    <weight>2</weight>
    <good>true</good>
    <major>true</major>
    <truth>It was {PAWN_nameDef} all along: the mended boots left by beds, the extra blanket in winter, the flowers on the graves. And never wanted anyone to know.</truth>
    <ownerThought>Council_Secret_Seen</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Grateful</thought><exceptTrait><li>Psychopath</li></exceptTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret_Poet</defName>
    <label>secret poems</label>
    <who><passion>Artistic</passion></who>
    <good>true</good>
    <truth>{PAWN_nameDef} has been writing poems about everyone in the colony. Dozens of them. Some are beautiful. Some are very honest.</truth>
    <ownerThought>Council_Secret_Embarrassed</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Amused</thought><exceptTrait><li>Abrasive</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Mocking</thought><onlyTrait><li>Abrasive</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

</Defs>
