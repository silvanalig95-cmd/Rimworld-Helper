<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    More secrets: the same fields as Council_Secrets.xml (see the header there).
    New reaction and owner thoughts are in Council_Thoughts_Secrets2.xml; dilemmas that follow some of these
    secrets are in Council_Dilemmas_Secrets.xml.
  -->

  <!-- ===================== Dark pasts ===================== -->

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_Slaver</defName>
    <label>a slaver's ledger</label>
    <backstory><li>slaver</li><li>slave trader</li><li>slave driver</li><li>slave master</li><li>trafficker</li><li>kidnapper</li><li>flesh trader</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <major>true</major>
    <truth>{PAWN_nameDef} sold people for a living: bought them cheap on the rimworlds and sold them dear in the cities, and kept a careful ledger of every profit and not one of the names.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Disgust</thought><exceptTrait><li>Psychopath</li><li>Greedy</li></exceptTrait><chance>0.8</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><onlyTrait><li>Greedy</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Fascinated</thought><onlyTrait><li>Psychopath</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_Mercenary</defName>
    <label>a mercenary's contract</label>
    <backstory><li>mercenary</li><li>sellsword</li><li>hired gun</li><li>soldier of fortune</li><li>gun for hire</li><li>bounty hunter</li><li>military contractor</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <truth>{PAWN_nameDef} once took a contract to clear a settlement off land a mining company wanted, a colony a lot like this one, and still remembers the color of its doors.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Distrust</thought><exceptTrait><li>Kind</li><li>Bloodlust</li><li>Tough</li><li>Psychopath</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Respect</thought><onlyTrait><li>Bloodlust</li><li>Tough</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li></onlyTrait><chance>0.6</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_OrganTrader</defName>
    <label>a back-room clinic</label>
    <backstory><li>organ trader</li><li>organ harvester</li><li>organ dealer</li><li>black market</li><li>back-alley</li><li>bodyshop</li><li>surgeon</li><li>smuggler</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <major>true</major>
    <truth>{PAWN_nameDef} ran a back-room clinic that bought organs from the desperate and sold them to the rich, and did not always wait for the desperate to agree.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Disgust</thought><exceptTrait><li>Psychopath</li><li>Greedy</li><li>Wimp</li></exceptTrait><chance>0.7</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Afraid</thought><onlyTrait><li>Wimp</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><onlyTrait><li>Greedy</li></onlyTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Fascinated</thought><onlyTrait><li>Psychopath</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_Mutineer</defName>
    <label>a mutiny</label>
    <backstory><li>mutineer</li><li>starship</li><li>ship's</li><li>freighter</li><li>deckhand</li><li>sailor</li><li>navy</li><li>spacer</li><li>crewman</li><li>crewmember</li><li>pilot</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <major>true</major>
    <truth>{PAWN_nameDef} led a mutiny against a cruel captain aboard a long-haul freighter, and when it was over the captain and two officers went out the airlock. The shipping company has never stopped looking for the crew.</truth>
    <ownerThought>Council_Secret2_Hunted</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><exceptTrait><li>Kind</li><li>Bloodlust</li><li>Abrasive</li></exceptTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Respect</thought><onlyTrait><li>Bloodlust</li><li>Abrasive</li></onlyTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li></onlyTrait><chance>0.5</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_PlagueCarrier</defName>
    <label>the last shuttle out</label>
    <weight>0.6</weight>
    <backstory><li>plague</li><li>quarantine</li><li>refugee</li><li>evacuee</li><li>outbreak</li></backstory>
    <major>true</major>
    <truth>{PAWN_nameDef} survived a plague that emptied a whole city, and already knew the fever had started when {PAWN_pronoun} pushed onto the last shuttle out. Half the passengers never walked off it.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Endangered</thought><exceptTrait><li>Kind</li><li>Psychopath</li><li>Wimp</li></exceptTrait><chance>0.7</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Afraid</thought><onlyTrait><li>Wimp</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_Interrogator</defName>
    <label>an interrogator's past</label>
    <backstory><li>interrogator</li><li>torturer</li><li>inquisitor</li><li>jailer</li><li>jailor</li><li>prison guard</li><li>prison warden</li><li>secret police</li><li>enforcer</li><li>executioner</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <major>true</major>
    <truth>{PAWN_nameDef} was an interrogator for a planetary regime, the one they sent for when nobody else could make a prisoner talk. It never took {PAWN_objective} more than a day.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Afraid</thought><exceptTrait><li>Psychopath</li><li>Bloodlust</li><li>Tough</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Fascinated</thought><onlyTrait><li>Psychopath</li><li>Bloodlust</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Contempt</thought><onlyTrait><li>Tough</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_Assassin</defName>
    <label>a guild of assassins</label>
    <who><notTrait><li>Wimp</li></notTrait></who>
    <backstory><li>assassin</li><li>hitman</li><li>hit man</li><li>killer</li><li>cutthroat</li><li>infiltrator</li><li>shadow</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <major>true</major>
    <truth>{PAWN_nameDef} was raised from childhood by a guild of assassins, and walked out on it owing one last contract. The guild does not consider the matter closed.</truth>
    <ownerThought>Council_Secret2_Hunted</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Afraid</thought><exceptTrait><li>Psychopath</li><li>Bloodlust</li><li>Tough</li><li>Kind</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Respect</thought><onlyTrait><li>Bloodlust</li><li>Tough</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Fascinated</thought><onlyTrait><li>Psychopath</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li></onlyTrait><chance>0.5</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_PitFighter</defName>
    <label>the death pits</label>
    <who><canFight>true</canFight></who>
    <backstory><li>gladiator</li><li>pit fighter</li><li>pitfighter</li><li>arena</li><li>prizefighter</li><li>cage fighter</li><li>boxer</li><li>brawler</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <truth>{PAWN_nameDef} fought in the death pits of an urbworld for years, champion of forty bouts, and every one of those bouts ended with somebody not getting up.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Respect</thought><onlyTrait><li>Bloodlust</li><li>Brawler</li><li>Tough</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li></onlyTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><exceptTrait><li>Bloodlust</li><li>Brawler</li><li>Tough</li><li>Kind</li></exceptTrait><chance>0.4</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Fight"><chance>0.2</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_Relapsed</defName>
    <label>a relapse</label>
    <who><notTrait><li>Ascetic</li></notTrait></who>
    <backstory><li>junkie</li><li>addict</li><li>drug</li><li>chemist</li><li>party</li><li>club</li></backstory>
    <truth>{PAWN_nameDef} swore off drugs years ago and has told everyone here so, but has been using again since the second month, a little at a time, in the dark behind the storeroom.</truth>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><exceptTrait><li>Kind</li><li>Ascetic</li><li>Psychopath</li></exceptTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Contempt</thought><onlyTrait><li>Ascetic</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <!-- ===================== Sad and sympathetic ===================== -->

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_KilledFriend</defName>
    <label>a friend's knife</label>
    <weight>0.8</weight>
    <truth>During a famine years ago, {PAWN_nameDef}'s best friend came at {PAWN_objective} with a knife over a ration pack, and only one of them walked away. {PAWN_nameDef} still isn't sure the knife was ever meant to be used.</truth>
    <ownerThought>Council_Secret2_OldWound</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><exceptTrait><li>Psychopath</li><li>Abrasive</li><li>Wimp</li></exceptTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Afraid</thought><onlyTrait><li>Wimp</li></onlyTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Distrust</thought><onlyTrait><li>Abrasive</li></onlyTrait><chance>0.5</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_DeadTwin</defName>
    <label>a lost twin</label>
    <weight>0.7</weight>
    <truth>{PAWN_nameDef} had a twin who drowned the summer they turned twelve, and still sets out a second cup some mornings without thinking, then puts it away before anyone sees.</truth>
    <ownerThought>Council_Secret2_OldWound</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><exceptTrait><li>Psychopath</li><li>Abrasive</li></exceptTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_MentalState"><target>A</target><mentalState>Wander_Sad</mentalState><chance>0.2</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_HiddenIllness</defName>
    <label>a hidden sickness</label>
    <weight>0.7</weight>
    <minAge>25</minAge>
    <who><notTrait><li>Wimp</li></notTrait></who>
    <truth>{PAWN_nameDef} has a slow sickness that no doctor out here could cure, and has been hiding the bad days behind long shifts and a steady smile.</truth>
    <ownerThought>Council_Secret2_NoMorePretending</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><exceptTrait><li>Psychopath</li><li>Wimp</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><onlyTrait><li>Wimp</li></onlyTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Respect</thought><onlyTrait><li>Tough</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_LastSurvivor</defName>
    <label>the only survivor</label>
    <backstory><li>settler</li><li>homesteader</li><li>refugee</li><li>survivor</li><li>orphan</li></backstory>
    <truth>{PAWN_nameDef} came from a colony a lot like this one, and was the only one left alive when the raiders were done with it. {PAWN_nameDef} still knows every name, and says them some nights, in order.</truth>
    <ownerThought>Council_Secret2_OldWound</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><exceptTrait><li>Psychopath</li><li>Tough</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Respect</thought><onlyTrait><li>Tough</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_DogLeftBehind</defName>
    <label>a dog left behind</label>
    <who><passion>Animals</passion></who>
    <truth>{PAWN_nameDef} once left a dog tied to a post on a burning world, because there was no room left on the shuttle. {PAWN_nameDef} can still hear it barking.</truth>
    <ownerThought>Council_Secret2_OldWound</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><onlyTrait><li>Kind</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><exceptTrait><li>Kind</li><li>Psychopath</li><li>Abrasive</li></exceptTrait><chance>0.3</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Contempt</thought><onlyTrait><li>Abrasive</li></onlyTrait><chance>0.5</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_LettersToTheDead</defName>
    <label>letters to the dead</label>
    <minAge>28</minAge>
    <truth>{PAWN_nameDef} still writes to a spouse who died years ago, one letter every week, about the weather and the crops and everyone here. There is a box of them under the bed, and it is nearly full.</truth>
    <ownerThought>Council_Secret2_OldWound</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Sympathy</thought><exceptTrait><li>Psychopath</li><li>Abrasive</li><li>Kind</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Touched</thought><onlyTrait><li>Kind</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Mocking</thought><onlyTrait><li>Abrasive</li></onlyTrait><chance>0.5</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <!-- ===================== Light, odd and good ===================== -->

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_FeedsStrays</defName>
    <label>the strays at the fence</label>
    <who><passion>Animals</passion><notTrait><li>Greedy</li></notTrait></who>
    <good>true</good>
    <truth>{PAWN_nameDef} has been slipping scraps to the wild animals at the edge of the colony every night for weeks. Several of them now come running at a particular whistle.</truth>
    <ownerThought>Council_Secret_Embarrassed</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Amused</thought><exceptTrait><li>Greedy</li><li>Kind</li><li>Psychopath</li></exceptTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Touched</thought><onlyTrait><li>Kind</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Wasteful</thought><onlyTrait><li>Greedy</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_HiddenGarden</defName>
    <label>a hidden garden</label>
    <weight>0.8</weight>
    <who><notTrait><li>Psychopath</li></notTrait></who>
    <good>true</good>
    <truth>{PAWN_nameDef} has been growing flowers in a forgotten corner behind the walls, from a pouch of seeds carried all the way from home, and visits them every morning before anyone else is up.</truth>
    <ownerThought>Council_Secret_Seen</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Touched</thought><exceptTrait><li>Abrasive</li><li>Psychopath</li><li>Greedy</li></exceptTrait><chance>0.4</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Mocking</thought><onlyTrait><li>Abrasive</li></onlyTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Wasteful</thought><onlyTrait><li>Greedy</li></onlyTrait><chance>0.6</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_FamousSong</defName>
    <label>a famous song</label>
    <backstory><li>musician</li><li>singer</li><li>performer</li><li>entertainer</li><li>pop star</li><li>rock star</li><li>popstar</li><li>rockstar</li><li>idol</li><li>celebrity</li><li>composer</li><li>minstrel</li></backstory>
    <backstoryOnly>true</backstoryOnly>
    <good>true</good>
    <truth>{PAWN_nameDef} was a famous musician on a glitterworld, with a song that still plays on the long-range bands, and walked off the stage at the height of it without ever telling anyone why.</truth>
    <ownerThought>Council_Secret_Embarrassed</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Starstruck</thought><exceptTrait><li>Jealous</li><li>Abrasive</li><li>Psychopath</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Contempt</thought><onlyTrait><li>Jealous</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Mocking</thought><onlyTrait><li>Abrasive</li></onlyTrait></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_SingsToCrops</defName>
    <label>songs for the crops</label>
    <who><passion>Plants</passion></who>
    <good>true</good>
    <truth>{PAWN_nameDef} sings to the crops. Every morning, row by row, very quietly and very badly, the same three songs.</truth>
    <ownerThought>Council_Secret_Embarrassed</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Amused</thought><exceptTrait><li>Abrasive</li><li>TooSmart</li><li>Kind</li></exceptTrait><chance>0.5</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret2_Touched</thought><onlyTrait><li>Kind</li></onlyTrait></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Mocking</thought><onlyTrait><li>Abrasive</li><li>TooSmart</li></onlyTrait><chance>0.7</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_BirthdayBook</defName>
    <label>a book of birthdays</label>
    <who><passion>Social</passion></who>
    <good>true</good>
    <truth>{PAWN_nameDef} keeps a little book of everyone's birthdays, favorite foods and the names of the people they lost, and has quietly made sure that no one's day has gone unmarked since arriving.</truth>
    <ownerThought>Council_Secret_Seen</ownerThought>
    <revealEffects>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Grateful</thought><exceptTrait><li>Psychopath</li><li>TooSmart</li></exceptTrait><chance>0.6</chance></li>
      <li Class="ColonyCouncil.DilemmaEffect_Thought"><target>Others</target><thought>Council_Secret_Wary</thought><onlyTrait><li>TooSmart</li></onlyTrait><chance>0.5</chance></li>
    </revealEffects>
  </ColonyCouncil.SecretDef>

  <ColonyCouncil.SecretDef>
    <defName>Council_Secret2_BorrowedCooking</defName>
