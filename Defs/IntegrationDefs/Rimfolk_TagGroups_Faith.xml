<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Faith, as a tag (Ideology): "devout" for people whose ideoligion worships something, a god or gods, one of the old
    faiths, or the spirits of the world (theist, origin and animist structures). Decrees, customs, offices and lines ask
    for [devout] instead of a list of memes. Without Ideology nobody has memes, so nobody is devout and nothing breaks.
  -->

  <ColonyCouncil.TagGroupDef>
    <defName>Rimfolk_Tags_Devout</defName>
    <label>the devout</label>
    <description>People whose faith worships something: a god or gods, one of the old faiths, or the spirits of the world.</description>
    <tag>devout</tag>
    <memes>
      <li>Structure_TheistEmbodied</li>
      <li>Structure_TheistAbstract</li>
      <li>Structure_OriginChristian</li>
      <li>Structure_OriginIslamic</li>
      <li>Structure_OriginHindu</li>
      <li>Structure_OriginBuddhist</li>
      <li>Structure_Animist</li>
    </memes>
  </ColonyCouncil.TagGroupDef>

</Defs>
