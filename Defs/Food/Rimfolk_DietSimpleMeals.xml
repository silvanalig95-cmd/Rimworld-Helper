<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Vegetarian and carnivore simple meals (the player, 11 November 2026: "can i please have dedicated recipes for
    vegetarian & meat simple meals? so i actually have a dedicated slot for it and can better manage different diets").
    The game has vegetarian and carnivore fine and lavish meals but one simple meal. These are simple meals in every way
    (nutrition, worth, how long they keep, their place among the meals), made from plant food only or from meat only,
    each on its own bill (one meal, or four at once), so food policies, shelves and stockpiles can tell them apart.
    Source/ColonyCouncil/Integrations/DietMeals.cs finishes them at startup: the ingredients exactly as the game's own
    vegetarian and carnivore fine meal bills take them (other mods' foods too), the simple meal's look tinted green or
    red, and every stove or fire that cooks simple meals (or four at once) gets the bills. The graphic and filters below
    only stand in until then.
  -->

  <ThingDef ParentName="MealCooked">
    <defName>Rimfolk_MealSimple_Veg</defName>
    <label>vegetarian simple meal</label>
    <description>A simple meal cooked from plant food only: vegetables, grains, fruit or fungus. No meat goes into it, so a vegetarian can eat it with a clear conscience. It takes the same foods as the game's vegetarian meals.</description>
    <graphicData>
      <texPath>ColonyCouncil/Icons/Table</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>15</MarketValue>
      <WorkToMake>300</WorkToMake>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="MealCooked">
    <defName>Rimfolk_MealSimple_Meat</defName>
    <label>carnivore simple meal</label>
    <description>A simple meal cooked from meat, with no plant food in it, so it suits those whose diet or faith asks for meat. It takes the same foods as the game's carnivore meals.</description>
    <graphicData>
      <texPath>ColonyCouncil/Icons/Table</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>15</MarketValue>
      <WorkToMake>300</WorkToMake>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
  </ThingDef>

  <RecipeDef ParentName="CookMealBase">
    <defName>Rimfolk_CookMealSimple_Veg</defName>
    <label>cook vegetarian simple meal</label>
    <description>Cook a simple meal from plant food only.</description>
    <jobString>Cooking vegetarian simple meal.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <recipeUsers>
      <li>ElectricStove</li>
      <li>FueledStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>0.5</count>
      </li>
    </ingredients>
    <products>
      <Rimfolk_MealSimple_Veg>1</Rimfolk_MealSimple_Veg>
    </products>
    <fixedIngredientFilter>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
    </fixedIngredientFilter>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

  <RecipeDef ParentName="CookMealBase">
    <defName>Rimfolk_CookMealSimpleBulk_Veg</defName>
    <label>cook 4 vegetarian simple meals</label>
    <description>Cook four simple meals from plant food only at once.</description>
    <jobString>Cooking 4 vegetarian simple meals.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
