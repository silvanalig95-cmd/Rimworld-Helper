    <recipeUsers>
      <li>ElectricStove</li>
      <li>FueledStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>2.0</count>
      </li>
    </ingredients>
    <products>
      <Rimfolk_MealSimple_Veg>4</Rimfolk_MealSimple_Veg>
    </products>
    <fixedIngredientFilter>
      <categories>
        <li>PlantFoodRaw</li>
