    <label>harvest</label>
    <domain>Harvest</domain>
    <ofWords>the harvest</ofWords>
    <colour>(0.88, 0.72, 0.32)</colour>
    <colour2>(0.56, 0.64, 0.30)</colour2>
    <sacredAnimals>
      <li>Hare</li>
      <li>Snowhare</li>
      <li>Bluebird</li>
    </sacredAnimals>
    <sacredPlants>
      <li>Plant_Rice</li>
      <li>Plant_Corn</li>
      <li>Plant_Potato</li>
    </sacredPlants>
    <sacredPlace>a field at sowing</sacredPlace>
    <sacredDeed>a big harvest brought in</sacredDeed>
  </ColonyCouncil.GodDomainDef>

