<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    A god's ways in the world (Source/ColonyCouncil/Gods/World/GodWays.cs, GodWaysDef): what it gives, how its anger shows,
    the price it asks, the holy place its people seek, its feast, its side in a quarrel of the sky, and the tags its myths
    and the words about it are told by. Keyed on the god (gods: its patron's defName, or its name in lower case; the
    hand-made gods to come name their own defName here), else on a domain; whatever a def leaves out falls back to the
    domain's generic ways (GodWorldMath). The defs below give Rimfolk's peoples' patrons ways of their own; every other god
    takes its domain's.
    Names in the lists are the classes' trait defNames of A RimWorld of Magic (torann.arimworldofmagic), its spell scrolls,
    Vanilla Psycasts Expanded's paths (vanillaexpanded.vpsycastse), and the game's animals; each is looked up softly, so a
    mod that isn't loaded simply isn't offered.
  -->

  <ColonyCouncil.GodWaysDef>
    <defName>Rimfolk_GodWays_StormFather</defName>
    <gods><li>Rimfolk_Patron_StormFather</li></gods>
    <classes><li>StormBorn</li></classes>
    <paths><li>VPE_Staticlord</li></paths>
    <wrath>Lightning</wrath>
    <prices><li>Blood</li><li>Mark</li><li>Offering</li></prices>
    <site>wreck</site>
    <feast>the Night of the First Thunder</feast>
    <weather>storm</weather>
    <mythTags><li>godkey:stormfather</li></mythTags>
  </ColonyCouncil.GodWaysDef>

