    <lineTag>pip</lineTag>
  </ColonyCouncil.GodShapeDef>

  <!-- Cirrus, Who Drifts Above: the upper sky. A shadow too large at noon, a star that moves the wrong way; the aurora is it turning, an eclipse it closing an eye. -->
  <ColonyCouncil.GodShapeDef>
    <defName>Rimfolk_GodShape_Cirrus</defName>
    <gods><li>Cirrus</li><li>Rimfolk_God_Cirrus</li></gods>
    <stranger>false</stranger>
    <beast>false</beast>
    <bodiless>true</bodiless>
