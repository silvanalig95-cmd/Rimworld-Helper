  <ColonyCouncil.GodShapeDef>
    <defName>Rimfolk_GodShape_Hush</defName>
    <gods><li>Hush</li><li>Rimfolk_God_Hush</li></gods>
    <stranger>false</stranger>
    <beast>false</beast>
    <bodiless>true</bodiless>
    <voices><li>Snow</li><li>Cold</li></voices>
    <omens><li>FrostWriting</li><li>Silence</li><li>WhiteFigure</li></omens>
    <lineTag>hush</lineTag>
  </ColonyCouncil.GodShapeDef>

  <!-- Undertow, the Hunger: the void beneath. It never comes itself: a dark a light doesn't reach, a sweet voice to the desperate, Anomaly's signs. -->
  <ColonyCouncil.GodShapeDef>
    <defName>Rimfolk_GodShape_Undertow</defName>
    <gods><li>Undertow</li><li>Rimfolk_God_Undertow</li></gods>
    <stranger>false</stranger>
    <beast>false</beast>
    <bodiless>true</bodiless>
