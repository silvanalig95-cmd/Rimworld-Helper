  <!-- ===================== The ones added after the nine ===================== -->

  <!--
    Helios and Selene, the Gift and the Return: the sun and the moon. Neither takes a form. Helios gives blindly: the sun
    standing still with shadows that don't move, a heat haze, long clear days, and too much giving (a heat wave). Selene
    has no light of her own: at night she returns what was done by day, as much as her face shows (GodReturn; the moon's
    face through the season, GodsOnMapMath.Face): a huge moon all night, dreams, a night of nightmares, and the eclipse when
    she steps between (everyone stops to watch). She notices those who keep the night (GodOmens.NightWatch).
  -->
  <ColonyCouncil.GodShapeDef>
    <defName>Rimfolk_GodShape_Helios</defName>
    <gods><li>Helios</li><li>Rimfolk_God_Helios</li></gods>
    <stranger>false</stranger>
    <beast>false</beast>
    <bodiless>true</bodiless>
    <voices><li>Clear</li><li>Heat</li></voices>
    <omens><li>StillSun</li><li>HeatHaze</li><li>Calm</li></omens>
    <lineTag>helios</lineTag>
    <nearWhen><li>Heat</li></nearWhen>
  </ColonyCouncil.GodShapeDef>

  <ColonyCouncil.GodShapeDef>
    <defName>Rimfolk_GodShape_Selene</defName>
    <gods><li>Selene</li><li>Rimfolk_God_Selene</li></gods>
    <stranger>false</stranger>
    <beast>false</beast>
    <bodiless>true</bodiless>
    <voices><li>Eclipse</li><li>Sleepless</li><li>Aurora</li></voices>
    <omens><li>BigMoon</li><li>Dream</li><li>Calm</li></omens>
    <returns>true</returns>
    <lineTag>selene</lineTag>
    <nearWhen><li>FullMoon</li></nearWhen>
  </ColonyCouncil.GodShapeDef>

  <!--
    Tamiu, the Keeper of the Threshold (defName and key Mog): plainly on the map, a great cat the color of desert sand,
    larger than any lion, with gold eyes and all a god's presence (Vanilla Animals Expanded's lion first, Alpha Animals' sand
    lion, else the game's cougar or lynx, whichever is at ease in the season). The colony's cats follow her and sit with
    her. She walks to the graves and keeps among them (MogsWays); once a stay she may lie across the way in and ask a riddle;
    she takes food she didn't ask for, can't be tamed or kept (marked to be tamed, she goes), and leaves if she or a cat is
    harmed. Her own signs: the cats all sitting facing the graves, two gold eyes in the dark by the graves, fine sand on a
    grave where no wind blows. A death on the land and the colony's cats draw her near.
  -->
  <ColonyCouncil.GodShapeDef>
    <defName>Rimfolk_GodShape_Mog</defName>
    <gods><li>Mog</li><li>Rimfolk_God_Mog</li></gods>
    <stranger>false</stranger>
    <beasts>
      <li>AEXP_Lion</li>
      <li>AA_SandLion</li>
      <li>Cougar</li>
      <li>Lynx</li>
    </beasts>
    <look>Rimfolk_GodLook_Mog</look>
    <kin>Cat</kin>
    <kinCount>1~3</kinCount>
    <leads>false</leads>
    <feeds>true</feeds>
    <stayDays>10~15</stayDays>
    <weather>false</weather>
    <omens><li>CatsFacing</li><li>GoldEyes</li><li>Sand</li></omens>
    <lineTag>mog</lineTag>
    <nearWhen><li>Cats</li><li>Death</li></nearWhen>
  </ColonyCouncil.GodShapeDef>

