<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    A god's presence on the map (docs/design/gods.md, "Presence"; Source/ColonyCouncil/Gods/Presence/): the hediff that
    makes a person or an animal a god's (hidden in disguise, the stately walk when shown), the light that follows a god,
    the short jobs of those who turn to one, the presence on the sky, the god's card in the letter stack, and Rimfolk's own
    motes (Tools/make_god_auras.py drew them). The looks themselves are Rimfolk_GodLooks.xml.
  -->

  <HediffDef>
    <defName>Rimfolk_GodAvatar</defName>
    <label>a god within</label>
    <description>A god walks in this body. It is larger than it should be, it shines in its god's colors, and the ground answers where it steps.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.82, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="ColonyCouncil.HediffCompProperties_GodAvatar" />
    </comps>
    <stages>
      <!-- In disguise: nothing shows, not even on its health page. -->
      <li>
        <minSeverity>0</minSeverity>
        <becomeVisible>false</becomeVisible>
      </li>
      <!-- Shown: a stately walk, never hurried (GodPresenceMath.StatelyWalk). -->
      <li>
        <minSeverity>0.75</minSeverity>
        <statFactors>
          <MoveSpeed>0.8</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- The light that moves with a shown god: the game's glower on a thing nobody sees or saves (GodLight). -->
  <ThingDef>
    <defName>Rimfolk_GodLight</defName>
    <label>a god's light</label>
    <description>The light that moves with a god.</description>
    <thingClass>ColonyCouncil.GodLight</thingClass>
    <category>Ethereal</category>
    <tickerType>Rare</tickerType>
    <drawerType>None</drawerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <isSaveable>false</isSaveable>
    <rotatable>false</rotatable>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(255,235,190,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <!-- Those who turn to a god: standing in awe, praying, or (an animal) lying down facing it (JobDriver_BeholdGod). -->
  <JobDef>
    <defName>Rimfolk_BeholdGod</defName>
    <driverClass>ColonyCouncil.JobDriver_BeholdGod</driverClass>
    <reportString>looking up.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <suspendable>false</suspendable>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_PrayToGod</defName>
    <driverClass>ColonyCouncil.JobDriver_BeholdGod</driverClass>
    <reportString>praying.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <suspendable>false</suspendable>
  </JobDef>

  <JobDef>
    <defName>Rimfolk_LieBeforeGod</defName>
    <driverClass>ColonyCouncil.JobDriver_BeholdGod</driverClass>
    <reportString>lying down.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <suspendable>false</suspendable>
  </JobDef>

  <!-- A god's presence on the sky: its colour, and the wind dying (GameCondition_GodPresence names it plainly or veiled). -->
  <GameConditionDef>
    <defName>Rimfolk_GodPresence</defName>
    <conditionClass>ColonyCouncil.GameCondition_GodPresence</conditionClass>
    <label>a god's presence</label>
    <description>The sky has taken a god's color, and the wind has died.</description>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>

  <!-- A god's card: gold in the letter stack, no good or bad tag, a small bell (the sting has already sounded). -->
  <LetterDef>
    <defName>Rimfolk_GodCard</defName>
    <letterClass>ColonyCouncil.GodLetter</letterClass>
    <color>(0.86, 0.70, 0.36)</color>
    <flashColor>(1, 0.88, 0.55)</flashColor>
    <flashInterval>45</flashInterval>
    <bounce>true</bounce>
    <arriveSound>TinyBell</arriveSound>
    <pauseMode>AnyLetter</pauseMode>
    <forcedSlowdown>true</forcedSlowdown>
  </LetterDef>

  <!-- Rimfolk's own motes: a soft light rising off a god, a twinkle, and the burst of rays at its coming. -->
  <FleckDef>
    <defName>Rimfolk_GodMote</defName>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.35</fadeInTime>
    <solidTime>1</solidTime>
    <fadeOutTime>1.3</fadeOutTime>
    <growthRate>-0.08</growthRate>
    <graphicData>
      <texPath>ColonyCouncil/Gods/Aura/Mote</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
  </FleckDef>

  <FleckDef>
    <defName>Rimfolk_GodSpark</defName>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.2</fadeInTime>
    <solidTime>0.4</solidTime>
    <fadeOutTime>0.7</fadeOutTime>
    <graphicData>
      <texPath>ColonyCouncil/Gods/Aura/Spark</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
  </FleckDef>

  <FleckDef>
    <defName>Rimfolk_GodRays</defName>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.12</fadeInTime>
    <solidTime>0.5</solidTime>
    <fadeOutTime>1.6</fadeOutTime>
    <growthRate>2.2</growthRate>
    <graphicData>
      <texPath>ColonyCouncil/Gods/Aura/Rays</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
  </FleckDef>

</Defs>
