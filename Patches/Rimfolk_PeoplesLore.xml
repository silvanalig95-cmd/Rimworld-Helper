<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    The seven peoples in more of Rimfolk's existing callers (Source/ColonyCouncil/Peoples/; docs/design/peoples.md, "Their
    stories, sayings and touchpoints"), as release A's and C's are in Patches/Rimfolk_Peoples.xml and _PeoplesC.xml. Each
    patches one of Rimfolk's own defs and is conditional, so it never fails: with the def gone, nothing happens. A
    preference never shuts another people out: without a people of the calling, everything comes as before.
    - Callers that prefer a calling (HappeningSetting.prefers: five times as likely as another people): a herb-gatherer the
      hospitaller order's (its herb gardens), a neighbour's patrol the road league's (it remembers who robbed it), a
      traveller on the wrong road the pilgrim fellowship's, a travelling teacher the learned society's, a tourist the
      spacer enclave's.
    - And a text of each in that people's own voice ([their:CALLING]), said only when they are the ones who came.
  -->

  <!-- ===================== The hospitaller order's herb-gatherer ===================== -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_HerbGatherer"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_HerbGatherer"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
      <value>
        <prefers>healers</prefers>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_HerbGatherer"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_HerbGatherer"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
      <value>
        <li>[their:healers] {X_nameDef}, who keeps the herb garden at {FACTION}'s sickhouse at {PLACE}, asks leave to gather along the colony's treeline for the order's ward. {X_pronoun} has a bundle of dried herbs with {X_objective} already, and would part with it for {COUNT} silver, every coin of it for the sick.</li>
      </value>
    </match>
  </Operation>

  <!-- ===================== The road league's wardens ===================== -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_WatchPatrol"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_WatchPatrol"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
      <value>
        <prefers>traders</prefers>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_WatchPatrol"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_WatchPatrol"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
      <value>
        <li>[their:traders] {X_nameDef}, a road warden of {FACTION}, and two others are riding down a band that robbed a league caravan on the road to {PLACE}: the league writes its robbers in red, and goes after them. They ask the colony for a meal and medicine to buy, and {X_nameDef} offers the colony's best shot an hour of drill in exchange.</li>
      </value>
    </match>
  </Operation>

  <!-- ===================== The pilgrim fellowship's lost pilgrim ===================== -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_LostTraveller"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_LostTraveller"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
      <value>
        <prefers>pilgrims</prefers>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_LostTraveller"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Rimfolk_Evt_LostTraveller"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
      <value>
        <li>[their:pilgrims] {X_nameDef}, a pilgrim of {FACTION} with a string of shells at {X_possessive} belt, came to the gate footsore and smiling about it. Bound for the shrine at {PLACE}, {X_pronoun} has walked the wrong road for two days, and would be glad of a meal and the way; {X_pronoun} will bless the gate whichever the colony gives.</li>
      </value>
    </match>
  </Operation>

  <!-- ===================== The learned society's teacher ===================== -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Council_Evt_Schoolteacher"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Council_Evt_Schoolteacher"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
      <value>
        <prefers>scholars</prefers>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Council_Evt_Schoolteacher"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Council_Evt_Schoolteacher"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
      <value>
        <li>[their:scholars] {X_nameDef}, a fellow of {FACTION}, teaches children their letters wherever there are children, as the society's first readers learned theirs from Ilse Varro's copied pages. For {COUNT} silver, {X_nameDef} will give the colony's children a day of lessons.</li>
      </value>
    </match>
  </Operation>

  <!-- ===================== The spacer enclave's tourist ===================== -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Council_Evt_Tourist"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Council_Evt_Tourist"]/modExtensions/li[@Class="ColonyCouncil.HappeningSetting"]</xpath>
      <value>
        <prefers>brokers</prefers>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Council_Evt_Tourist"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Council_Evt_Tourist"]/modExtensions/li[@Class="ColonyCouncil.HappeningExtension"]/texts</xpath>
      <value>
        <li>[their:brokers] {X_nameDef}, a traveller from a glitterworld, has come by way of {FACTION}'s market with a sun hat and an itinerary the enclave sold {X_objective}, exact to the hour. {X_nameDef} would like to spend two days living as the colonists live, and will pay {COUNT} silver for it.</li>
      </value>
    </match>
  </Operation>

</Patch>
