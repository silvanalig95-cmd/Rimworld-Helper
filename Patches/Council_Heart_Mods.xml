      <!-- Dubs Bad Hygiene: bursting for the latrine -->
      <li><thought>BowelLevel</thought><weight>0.5</weight></li>
      <!-- Vanilla Factions Expanded - Empire: a title without the ballroom, gallery or court it asks for; a ball or an exhibit gone badly -->
      <li><thought>VFEE_TitleNoBallroom</thought><weight>0.6</weight></li>
      <li><thought>VFEE_TitleNoGallery</thought><weight>0.6</weight></li>
      <li><thought>VFEE_TitleBallroomRequirementsNotMet</thought><weight>0.6</weight></li>
      <li><thought>VFEE_TitleGalleryRequirementsNotMet</thought><weight>0.6</weight></li>
      <li><thought>VFEE_LackingNobleCourt</thought><weight>0.6</weight></li>
      <li><thought>VFEE_TerribleBall</thought><weight>0.6</weight></li>
      <li><thought>VFEE_TerribleExhibit</thought><weight>0.6</weight></li>
      <!-- ReGrowth: soaked to the skin, sand in everything -->
      <li><thought>RG_ExtremelyWet</thought><weight>0.5</weight></li>
      <li><thought>RG_Sandy</thought><weight>0.5</weight></li>
