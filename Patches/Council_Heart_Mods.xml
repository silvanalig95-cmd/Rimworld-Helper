      <li>RG_HotSpringBathing</li>
      <li>RG_HotSpringWet</li>
      <li>RG_BathingOcean</li>
      <li>RG_BathingWater</li>
      <!-- Alpha Biomes: the healing spring -->
      <li>AB_HealingSpringwaterThought</li>
      <!-- Alpha Animals: psychic harmony -->
