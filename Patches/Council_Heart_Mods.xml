      <li>AA_Disgust</li>
      <li>AA_AteSuperAwfulMeal</li>
      <li>AA_AteHorribleRot</li>
      <li>AA_UncomfortablyHot</li>
      <!-- A RimWorld of Magic: minion meat -->
      <li>AteMysteryMeatDirect</li>
      <li>AteMysteryMeatAsIngredient</li>
      <!-- ReGrowth: a dip in toxic waste; Alpha Biomes: the ocular forest's water -->
      <li>RG_WasteBathing</li>
      <li>AB_MutagenicOcularWater</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
