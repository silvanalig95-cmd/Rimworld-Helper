    <value>
      <!-- Vanilla Events Expanded: the psychic aurora -->
      <li>VEE_Aurora</li>
      <!-- Alpha Biomes: a petal storm, red fog for those who love it, the superorganism's kinder echoes -->
      <li>AB_PetalStorms</li>
      <li>AB_RedFogThoughtPositive</li>
      <li>AB_GelatinousEchoes_Good</li>
