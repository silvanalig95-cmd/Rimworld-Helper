<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Other mods' moods feeding Rimfolk's feelings (Defs/HeartDefs/Council_Feelings*.xml, Source/ColonyCouncil/Heart/).
    These patch only Rimfolk's own feelings: each adds the names of another mod's mood thoughts to a feeling's list. A
    name that isn't in the game is never matched, so with the mod missing nothing changes and nothing is logged.
    <thoughts>: counted at their full size, on the feeling's own side of mood (hard feelings while it hurts, bright ones
    while it helps). <feeds>: the same with a weight, for moods that last (a situational mood) or only partly fit.

    Mods: Dubs Bad Hygiene (the rest of its moods; the first ones are in the feelings themselves), A RimWorld of Magic,
    Vanilla Social Interactions Expanded, Vanilla Factions Expanded - Empire, Alpha Biomes, Alpha Animals,
    ReGrowth: Core, Vanilla Events Expanded, Therapy, Gastronomy, Snap Out!.
  -->

  <!-- ===================== Hard feelings ===================== -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ColonyCouncil.FeelingDef[defName="Council_Feeling_Grief"]/thoughts</xpath>
    <value>
      <!-- A RimWorld of Magic: a ranger's animal companion -->
      <li>RangerPetDied</li>
      <li>RangerSoldBondedPet</li>
      <!-- Vanilla Social Interactions Expanded: a best friend -->
      <li>VSIE_MyBestFriendDied</li>
      <li>VSIE_MyBestFriendDied_Female</li>
      <li>VSIE_MyBestFriendLost</li>
      <li>VSIE_MyBestFriendLost_Female</li>
      <li>VSIE_SoldMyBestFriend</li>
      <li>VSIE_KilledMyBestFriend</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ColonyCouncil.FeelingDef[defName="Council_Feeling_Grief"]/feeds</xpath>
    <value>
      <!-- Vanilla Social Interactions Expanded: closure after a death, and a loss in a raid -->
      <li><thought>VSIE_GotSomeClosure</thought><weight>0.6</weight></li>
      <li><thought>VSIE_SufferedLossNegative</thought><weight>0.6</weight></li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ColonyCouncil.FeelingDef[defName="Council_Feeling_Fear"]/thoughts</xpath>
    <value>
      <!-- Alpha Biomes: sinking in quicksand; Alpha Animals: the black queen -->
      <li>AB_Quicksand</li>
      <li>AAVPE_SeenBlackQueen</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ColonyCouncil.FeelingDef[defName="Council_Feeling_Dread"]/thoughts</xpath>
    <value>
      <!-- Alpha Biomes: the forsaken crags' unnatural night and storms, red fog, ash, ominous echoes -->
      <li>AB_ForsakenNight</li>
      <li>AB_ForsakenRain</li>
      <li>AB_ForsakenThunderstorm</li>
      <li>AB_RedFogThought</li>
      <li>AB_VolcanicAshThought</li>
      <li>AB_GelatinousEchoes_Bad</li>
      <!-- Alpha Animals: a creature's horrifying presence, a psychic harmony gone sour -->
      <li>AA_HorrifyingDread</li>
      <li>AA_PsychicHarmonyBad</li>
      <!-- Vanilla Events Expanded: the superbloom's drone -->
      <li>VEE_SuperbloomPsychicDrone</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ColonyCouncil.FeelingDef[defName="Council_Feeling_Anger"]/thoughts</xpath>
    <value>
      <!-- Vanilla Social Interactions Expanded: the one who sold or killed a best friend -->
      <li>VSIE_SoldMyBestFriend</li>
      <li>VSIE_KilledMyBestFriend</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ColonyCouncil.FeelingDef[defName="Council_Feeling_Shame"]/thoughts</xpath>
    <value>
      <!-- Dubs Bad Hygiene: walked in on, and worse -->
      <li>WashPrivacy</li>
      <li>ToiletPrivacy</li>
      <li>SoiledSelf</li>
      <!-- A RimWorld of Magic: turned into an animal against one's will; a companion sold -->
      <li>Polymorphed</li>
      <li>RangerSoldBondedPet</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ColonyCouncil.FeelingDef[defName="Council_Feeling_Envy"]/thoughts</xpath>
