      <xpath>Defs/StatDef[defName="RestFallRateFactor"]/parts</xpath>
      <value>
        <li Class="ColonyCouncil.StatPart_HeartFelt"><effect>Rest</effect></li>
      </value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/StatDef[defName="RestFallRateFactor"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/StatDef[defName="RestFallRateFactor"]</xpath>
        <value>
          <parts>
            <li Class="ColonyCouncil.StatPart_HeartFelt"><effect>Rest</effect></li>
          </parts>
        </value>
      </match>
    </nomatch>
  </Operation>

  <!-- The heart, made to count: the worn heal a little slower (10% at most), those in good heart a little faster (StatPart_HeartFelt, HeartCountMath.Factor). -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="InjuryHealingFactor"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="InjuryHealingFactor"]/parts</xpath>
      <value>
        <li Class="ColonyCouncil.StatPart_HeartFelt"><effect>Healing</effect></li>
      </value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/StatDef[defName="InjuryHealingFactor"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/StatDef[defName="InjuryHealingFactor"]</xpath>
        <value>
          <parts>
            <li Class="ColonyCouncil.StatPart_HeartFelt"><effect>Healing</effect></li>
          </parts>
        </value>
      </match>
    </nomatch>
  </Operation>

  <!-- The heart, made to count: the worn fight off illness a little slower (5% at most), those in good heart a little faster (StatPart_HeartFelt, HeartCountMath.Factor). -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="ImmunityGainSpeed"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="ImmunityGainSpeed"]/parts</xpath>
      <value>
        <li Class="ColonyCouncil.StatPart_HeartFelt"><effect>Immunity</effect></li>
      </value>
