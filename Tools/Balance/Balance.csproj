<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The colony-year balance simulator: runs without the game, from the def XML, the mod's own arithmetic (linked below)
    and the rates in Rates.cs. How to run it is at the top of Program.cs; it writes docs/balance-report.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <!-- The mod's own arithmetic, shared as it is (no game types): the same numbers the game uses. -->
    <Compile Include="../../Source/ColonyCouncil/Moods/GoodLifeMath.cs" Link="Linked/GoodLifeMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Moods/SmallMomentMath.cs" Link="Linked/SmallMomentMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Ailments/AilmentMath.cs" Link="Linked/AilmentMath.cs" />
    <!-- The shared illness budget and crowding (IllnessSim.cs, with &#45;&#45;illness): the rules the game keeps. -->
    <Compile Include="../../Source/ColonyCouncil/Ailments/IllnessBudgetMath.cs" Link="Linked/IllnessBudgetMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Ailments/LifeRiskMath.cs" Link="Linked/LifeRiskMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Arcs/ArcMath.cs" Link="Linked/ArcMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Pressures/PressureMath.cs" Link="Linked/PressureMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Setbacks/SetbackMath.cs" Link="Linked/SetbackMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/UI/SettingsCatalog.cs" Link="Linked/SettingsCatalog.cs" />
    <!-- The teller and the colony's pace (Scenes.cs, with &#45;&#45;scenes and &#45;&#45;tell): the very rules the game keeps. -->
    <Compile Include="../../Source/ColonyCouncil/Lean/Sched.cs" Link="Linked/Sched.cs" />
    <Compile Include="../../Source/ColonyCouncil/UI/TellMath.cs" Link="Linked/TellMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/PlayOut/StageMath.cs" Link="Linked/StageMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Calendar/CalendarMath.cs" Link="Linked/CalendarMath.cs" />
    <!-- How bonds come about (SocialSim.cs, with &#45;&#45;social). -->
    <Compile Include="../../Source/ColonyCouncil/Social/BondsMath.cs" Link="Linked/BondsMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Social/ChemistryMath.cs" Link="Linked/ChemistryMath.cs" />
    <!-- Which of a role's tags are the moment's (the weather, what someone is doing), for how often a social event can come. -->
    <Compile Include="../../Source/ColonyCouncil/Social/TogetherFourMath.cs" Link="Linked/TogetherFourMath.cs" />
    <!-- Against their nature and the heart (NatureSim.cs, with &#45;&#45;nature). -->
    <Compile Include="../../Source/ColonyCouncil/Diplomacy/NatureMath.cs" Link="Linked/NatureMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Heart/HeartMath.cs" Link="Linked/HeartMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Heart/HeartFeltMath.cs" Link="Linked/HeartFeltMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Persona/PersonaMath.cs" Link="Linked/PersonaMath.cs" />
    <!-- Hurts from everyday life (HarmSim.cs, with &#45;&#45;harm): the shared cap and every source's rate. -->
    <Compile Include="../../Source/ColonyCouncil/Harm/HarmMath.cs" Link="Linked/HarmMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Harm/HarmTwoMath.cs" Link="Linked/HarmTwoMath.cs" />
    <!-- The shared budget and harm part 4's fifteen (HarmSim.cs): the kinds, their passes, their rates; a feast's blow and sour night. -->
    <Compile Include="../../Source/ColonyCouncil/Harm/HarmBudgetMath.cs" Link="Linked/HarmBudgetMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Harm/HarmFourMath.cs" Link="Linked/HarmFourMath.cs" />
    <!-- Harm part 5 (sickness that spreads, the weather and the cold): its rates, for the same model. -->
    <Compile Include="../../Source/ColonyCouncil/Harm/HarmFiveMath.cs" Link="Linked/HarmFiveMath.cs" />
    <!-- Harm part 6 (the work's accidents, the animals, the contests and festivals): its rates, for the same model. -->
    <Compile Include="../../Source/ColonyCouncil/Harm/HarmSixMath.cs" Link="Linked/HarmSixMath.cs" />
    <!-- Harm part 7 (tempers, visitors and outsiders, personal stories): its rates, for the same model. -->
    <Compile Include="../../Source/ColonyCouncil/Harm/HarmSevenMath.cs" Link="Linked/HarmSevenMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Camps/CampPackMath.cs" Link="Linked/CampPackMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Diplomacy/FeastMath.cs" Link="Linked/FeastMath.cs" />
    <!-- Schemes against the colony (SchemeSim.cs, with &#45;&#45;schemes): the day's chance, the acts, who catches them. -->
    <Compile Include="../../Source/ColonyCouncil/Diplomacy/SchemeMath.cs" Link="Linked/SchemeMath.cs" />
    <!-- The wild's alphas and bosses (BeastSim.cs, after the everyday hurts with &#45;&#45;harm): the stampedes' and the beast nemeses' rates. -->
    <Compile Include="../../Source/ColonyCouncil/Beasts/BeastsMath.cs" Link="Linked/BeastsMath.cs" />
    <Compile Include="../../Source/ColonyCouncil/Hauling/HaulMath.cs" Link="Linked/HaulMath.cs" />
  </ItemGroup>
</Project>
